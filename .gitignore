

# Session transcripts and the search index are machine-local state.
*.db
*.db-wal
*.db-shm
transcript-*.md

.DS_Store

# Go build output
bin/

# go test -coverprofile output; regenerated by `make cover`/`make covercheck`.
coverage.out

# kiln eval: baseline.jsonl is the committed reference; every other
# results file is a timestamped run and kept-artifact tree, both ephemeral.
eval/results/*.jsonl
!eval/results/baseline.jsonl
eval/results/runs/

# kiln QA campaign: per-run screenshots and screen dumps are local evidence;
# findings (qa/findings) and scenarios (qa/scenarios) are committed.
qa/runs/
__pycache__/

# Headless QA backend: local Python venv, and the xterm.js/font packages
# npm installs (scripts/qa/xterm/package-lock.json is committed so the
# pinned versions are; the installed files are not).
.venv-qa/
scripts/qa/xterm/node_modules/
