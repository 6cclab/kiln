

# Session transcripts and the search index are machine-local state.
*.db
*.db-wal
*.db-shm
transcript-*.md

.DS_Store

# Go build output
bin/

# go test -coverprofile output; regenerated by `make cover`/`make covercheck`.
coverage.out

# kiln eval: baseline.jsonl is the committed reference; every other
# results file is a timestamped run and kept-artifact tree, both ephemeral.
eval/results/*.jsonl
!eval/results/baseline.jsonl
eval/results/runs/
