# Edit prompt, option 3 ("No"): declines outright, same fixed decline
# note/follow-up text as every other tool's decline.
@faux testdata/faux/qa/permissions-edit-no.yaml
@fixture testdata/behaviour/design

WAITFOR /describe a task/ 20
TYPE tighten the auth check
KEY enter
WAITFOR /approval needed/ 20
SHOT edit-prompt
KEY 3
WAITFOR /Declined/ 20
SHOT edit-declined
EXPECT /✕ Declined Edit .*auth\.ts/
EXPECT_NOT /the user declined/
EXPECT_NOT /approval needed/
EXPECT_NOT /panic|goroutine/
