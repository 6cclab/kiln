# Bash prompt, option 2 ("don't ask again for: <rules>") on a compound
# line: the option names the one rule it saves (npm test *, not the
# read-only git log), and a later npm test with other arguments runs
# without a prompt (internal/claude/settings/bash_suggest.go).
@faux testdata/faux/qa/permissions-bash-option2.yaml

WAITFOR /describe a task/ 20
TYPE run the upload tests twice
KEY enter
WAITFOR /approval needed/ 20
SHOT first-prompt
EXPECT /git log -1 && npm test -- upload/
EXPECT /Yes, and don.t ask again for: npm test \*/
EXPECT_NOT /ask again for: git/
KEY 2
WAITFOR /Both test runs done/ 20
SHOT second-command-no-prompt
EXPECT_NOT /approval needed/
EXPECT /second one didn.t need approval/
EXPECT_NOT /panic|goroutine/
