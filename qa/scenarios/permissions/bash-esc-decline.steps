# Esc to decline the bash prompt. Note from reading app.go's handleKey:
# a permission prompt is always raised mid-turn (m.busy stays true from
# beginTurn until finishTurn), so PermissionKey's Esc branch sets
# promptEscInterrupt = true (busy && pending && esc) — this suppresses
# the ordinary declinedFollowupText ("Okay, I won't run it. What should I
# do instead?") in favour of finishTurn's own "■ Interrupted. Tell kiln
# what to do instead." note — one "what now" message, not two.
@faux testdata/faux/qa/permissions-esc-decline.yaml

WAITFOR /describe a task/ 20
TYPE deploy to production
KEY enter
WAITFOR /approval needed/ 20
SHOT bash-prompt
EXPECT /curl https:\/\/example\.invalid\/deploy/
KEY esc
WAIT 1
SHOT after-esc
EXPECT /✕ Declined curl https:\/\/example\.invalid\/deploy/
EXPECT_NOT /approval needed/
EXPECT /■ Interrupted\. Tell kiln what to do instead\./
# One system block: the interrupt line continues the decline note.
EXPECT /✕ Declined curl[^\n]*\n\s*■ Interrupted/
EXPECT_NOT /Okay, I won.t run it/
EXPECT_NOT /panic|goroutine/
