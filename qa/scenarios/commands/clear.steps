@faux testdata/faux/qa/commands-baseline.yaml

WAITFOR /describe a task/ 20
TYPE hello there
KEY enter
WAITFOR /Sure, working on it/ 20
SHOT before-clear
TYPE /clear
KEY enter
WAITFOR /Conversation cleared\./ 20
SHOT cleared
EXPECT /Conversation cleared\./
EXPECT_NOT /hello there/
EXPECT_NOT /panic|goroutine/
