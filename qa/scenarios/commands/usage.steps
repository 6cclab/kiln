@faux testdata/faux/qa/commands-baseline.yaml

WAITFOR /describe a task/ 20
TYPE turn one
KEY enter
WAITFOR /Sure, working on it/ 20
TYPE /usage
KEY enter
WAITFOR /No plan limits apply/ 20
SHOT usage
EXPECT /window\s+[\d.]+k? tokens/
EXPECT /budget\s+[\d.]+k? usable after reserves/
EXPECT /No plan limits apply: usage here is context, not billing\./
EXPECT_NOT /panic|goroutine/
