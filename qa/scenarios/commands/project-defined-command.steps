# A project-scoped command file (commands.go's ClaudeCommandSources,
# Project origin): .claude/commands/hello.md, no $ARGUMENTS placeholder,
# so its body is sent verbatim as the prompt (commands/sources.go Render).
@faux testdata/faux/qa/commands-baseline.yaml
@fixture testdata/behaviour/qa/commands-fixture

WAITFOR /describe a task/ 20
TYPE /hello
KEY enter
WAITFOR /Sure, working on it/ 20
SHOT project-command
EXPECT /\/hello/
EXPECT /Sure, working on it/
EXPECT_NOT /panic|goroutine/
