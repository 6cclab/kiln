@faux testdata/faux/qa/commands-baseline.yaml

WAITFOR /describe a task/ 20
TYPE turn one
KEY enter
WAITFOR /Sure, working on it/ 20
TYPE turn two
KEY enter
WAITFOR /Second turn done/ 20
TYPE /rewind
KEY enter
# Typing /rewind opens the same picker as esc esc.
WAITFOR /Files are not restored/ 20
SHOT rewind-picker
EXPECT /turn one/
EXPECT /turn two/
KEY up
KEY enter
WAITFOR /Rewound to before: turn two/ 20
SHOT rewound
EXPECT_NOT /Second turn done/
EXPECT_NOT /panic|goroutine/
