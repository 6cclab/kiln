# No MCP servers are configured in the scratch HOME (~/.claude.json), so
# ManageCommands' /mcp (which shadows InspectCommands' report-only /mcp)
# opens its dialog empty.
@faux testdata/faux/qa/commands-baseline.yaml

WAITFOR /describe a task/ 20
TYPE /mcp
KEY enter
WAITFOR /Manage MCP servers/ 20
SHOT mcp-dialog
EXPECT /Manage MCP servers/
EXPECT /0 servers/
KEY esc
EXPECT_NOT /panic|goroutine/
