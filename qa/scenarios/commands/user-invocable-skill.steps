# A user-invocable skill (commands/sources.go's SkillSource): only skills
# with user-invocable: true in frontmatter appear as a slash command.
@faux testdata/faux/qa/commands-baseline.yaml
@fixture testdata/behaviour/qa/commands-fixture

WAITFOR /describe a task/ 20
TYPE /greet
KEY enter
WAITFOR /Sure, working on it/ 20
SHOT skill-command
EXPECT /\/greet/
EXPECT /Sure, working on it/
EXPECT_NOT /panic|goroutine/
