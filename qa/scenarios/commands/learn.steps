# /learn (internal/commands/learn.go) is a built-in that sends a prompt; the
# model saves the skill under ~/.kiln/skills. ~/.kiln is a protected path,
# so the write asks before anything lands. learn-skill-loads.steps checks
# that a skill saved there loads in the next session (RELAUNCH is @real only).
@faux testdata/faux/qa/commands-learn.yaml

WAITFOR /describe a task/ 20
TYPE /lea
WAITFOR /\/learn/ 10
SHOT palette
EXPECT /Save a reusable skill from files, a URL, notes or what we just did/
TYPE rn the release flow
KEY enter
WAITFOR /approval needed/ 20
SHOT write-prompt
EXPECT /Allow kiln to write to .*\.kiln\/skills\/release-flow\/SKILL\.md\?/
EXPECT /Tag and publish a kiln release/
KEY 1
WAITFOR /Saved the release-flow skill/ 20
SHOT saved
RUN grep -q "name: release-flow" {HOME}/.kiln/skills/release-flow/SKILL.md
EXPECT_NOT /panic|goroutine/
