# A successful bash call: green "bash" label rule, "→ " output line.
@faux testdata/faux/qa/tools-bash-success.yaml
@args --permission-mode dontAsk

WAITFOR /describe a task/ 20
TYPE say hi with bash
KEY enter
WAITFOR /hello from bash/ 20
SHOT bash-ok
EXPECT /bash/
EXPECT /hello from bash/
EXPECT_NOT /panic|goroutine/
