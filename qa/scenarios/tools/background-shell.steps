# bash_background starts a shell (internal/tools/backgroundshell.go) and
# returns immediately with an id; /bashes (internal/commands/inline.go,
# rendered by agent.RenderShellList) lists it and its running status.
@faux testdata/faux/qa/tools-background-shell.yaml
@args --permission-mode bypassPermissions

WAITFOR /describe a task/ 20
TYPE start a background sleep
KEY enter
WAITFOR /running in the background as bash_1/ 20
# The status line shows the running-shell count (⟳ N shells, amber) as soon
# as the shell starts — pushed via MsgShells, internal/tui/status.go.
WAITFOR /⟳ 1 shell/ 20
SHOT dispatched
EXPECT /bash background ─[\s\S]*sleep 30[\s\S]*running in the background as bash_1 · \/bashes to check on it/
EXPECT_NOT /bash_output\(/
EXPECT /Started it in the background/
EXPECT /⟳ 1 shell/
TYPE /bashes
KEY enter
WAITFOR /shells?,/ 20
SHOT bashes-list
EXPECT /1 shell, 1 running/
EXPECT /bash_1\s+running/
EXPECT /sleep 30/
EXPECT_NOT /panic|goroutine/
