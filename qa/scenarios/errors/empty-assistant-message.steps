# An assistant turn with no text and no tool call at all (faux's
# toContentStep only sets a text delta when the scripted text is
# non-empty). Kiln should settle back to idle without erroring, and the
# next message proves the session is still alive (the faux script is now
# exhausted, so it answers with faux's fixed fallback text).
@faux testdata/faux/qa/errors-empty-message.yaml

WAITFOR /describe a task/ 20
SHOT welcome
TYPE say nothing back
KEY enter
WAITFOR /say nothing back/ 20
WAIT 2
SHOT after-empty-reply
EXPECT_NOT /panic|goroutine/
TYPE are you still there
KEY enter
WAITFOR /faux: script exhausted/ 20
SHOT exhausted-fallback
EXPECT /faux: script exhausted/
EXPECT_NOT /panic|goroutine/
