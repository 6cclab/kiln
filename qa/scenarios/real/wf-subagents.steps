# Parallel subagents: ask kiln to audit error handling in three independent
# packages at once and report back, watching the live "N subagents running"
# panel.
@real
@size 140x45
@fixture qa/fixtures/real/wf-subagents
WAITFOR /describe a task/ 30
SHOT ready
SEND Use parallel subagents to audit error handling in pkg/auth, pkg/payments and pkg/storage, one subagent per package, and report back what each one finds.
WAITFOR /subagents? running|Running \d+ subagents|Running a subagent/ 90
SHOT subagents-running
IDLE 600
SHOT report
EXPECT /auth/
EXPECT /payments/
EXPECT /storage/
# Each package went to its own subagent: three task calls in this run's session.
RUN test "$(cat $HOME/.harness/sessions/*$(basename $(dirname {PROJ}))*/*.jsonl | grep -o '"name":"task","type":"toolCall"' | wc -l)" -ge 3
