# Esc while a prompt waits for the SessionStart hooks that waited for the
# trust dialog stops the wait, not the hooks, as in Claude Code
# (internal/tui/session_start.go): the busy line clears, the queued
# prompt goes back into the input, and the hook keeps running. Sent again
# while the hook still runs, the prompt waits again, and goes out once
# the hook ends. The hook writes its PID, so the check looks at this
# run's process only, and waits for a release file.
@faux testdata/faux/hello.yaml
@untrusted
@setup mkdir -p .claude && printf '{"hooks":{"SessionStart":[{"hooks":[{"type":"command","command":"echo $$ > hook.pid; while [ ! -e release-hook ]; do sleep 0.1; done; echo CONTEXT-FROM-SESSION-START"}]}]}}\n' > .claude/settings.json

WAITFOR /Accessing workspace/ 20
KEY 2
WAITFOR /Running session start hooks/ 20
RUN i=0; until test -s hook.pid; do i=$((i+1)); [ $i -ge 100 ] && exit 1; sleep 0.2; done
TYPE keep this
KEY enter
WAITFOR /queued/ 20
KEY escape
WAITFOR /Stopped waiting for session start hooks\. Your queued message is back in the input\./ 20
SHOT wait-stopped
EXPECT_NOT /Running session start hooks/
EXPECT /keep this/
RUN kill -0 "$(cat hook.pid)"
KEY enter
WAITFOR /Running session start hooks/ 20
WAITFOR /queued/ 20
SHOT waiting-again
EXPECT_NOT /Hello from faux\./
RUN touch release-hook
WAITFOR /Hello from faux\./ 20
SHOT sent-after-hooks
EXPECT_NOT /Running session start hooks/
EXPECT_NOT /panic|goroutine/
