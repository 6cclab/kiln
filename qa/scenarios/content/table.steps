# Assistant content: a markdown table. internal/tui/markdown.go's
# buildStyle sets no Table override, so glamour's own default table
# rendering applies; this only checks the cell text survives, not the
# border glyphs, since the exact border characters aren't sourced from
# this package.
@faux testdata/faux/qa/content-table.yaml
@size 120x40

WAITFOR /describe a task/ 20
SHOT welcome
TYPE explain the change
KEY enter
WAITFOR /api\/login/ 20
SHOT reply
EXPECT /Route/
EXPECT /Limit/
EXPECT /api\/upload/
EXPECT /10\/min/
EXPECT /api\/login/
EXPECT /5\/min/
EXPECT_NOT /panic|goroutine/
