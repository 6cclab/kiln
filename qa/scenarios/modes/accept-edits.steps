# --permission-mode acceptEdits: idle label, then one shift+tab.
@faux testdata/faux/hello.yaml
@size 120x40
@args --permission-mode acceptEdits

WAITFOR /describe a task/ 20
SHOT idle
# design: Terminal.dc.html:222 (MODES[1] "auto-edit")
EXPECT /auto-edit/
KEY shift+tab
# acceptEdits -> plan (permissionModeRing in internal/tui/app.go)
WAITFOR /plan only/ 5
SHOT after-shift-tab
EXPECT_NOT /auto-edit/
EXPECT_NOT /panic|goroutine/
