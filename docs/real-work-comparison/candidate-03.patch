+package cli
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func runMemory(t *testing.T, positional ...string) (int, string, string) {
+	t.Helper()
+	var out, stderr bytes.Buffer
+	code := PersonalMemory(context.Background(), Args{Positional: positional}, &out, &stderr)
+	return code, out.String(), stderr.String()
+}
+
+func writeExport(t *testing.T, body string) string {
+	t.Helper()
+	dir := t.TempDir()
+	path := filepath.Join(dir, "export.json")
+	if err := os.WriteFile(path, []byte(body), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func TestMemoryImportCLIRejectsBadArguments(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	file := writeExport(t, "[]")
+	cases := [][]string{
+		{"import"},                                    // missing file
+		{"import", file, "extra"},                     // extra positional
+		{"import", file, "--bogus"},                   // unknown flag
+		{"import", file, "--on-conflict"},             // missing value
+		{"import", file, "--on-conflict", "nonsense"}, // invalid policy
+	}
+	for _, args := range cases {
+		if code, _, stderr := runMemory(t, args...); code != 2 {
+			t.Fatalf("args %v: expected exit 2, got %d (%s)", args, code, stderr)
+		}
+	}
+}
+
+func TestMemoryImportCLIRoundTripAndDryRun(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	file := writeExport(t, `[{"id":42,"scope":"ignored","key":"runner","kind":"preference","text":"use go test","evidence":"exported"}]`)
+
+	// Dry run reports what would happen but writes nothing.
+	code, out, stderr := runMemory(t, "global", "import", file, "--dry-run")
+	if code != 0 {
+		t.Fatalf("dry run failed: %s", stderr)
+	}
+	var report struct {
+		Inserted int  `json:"inserted"`
+		Replaced int  `json:"replaced"`
+		Skipped  int  `json:"skipped"`
+		DryRun   bool `json:"dry_run"`
+	}
+	if err := json.Unmarshal([]byte(out), &report); err != nil {
+		t.Fatalf("report not JSON: %q %v", out, err)
+	}
+	if !report.DryRun || report.Inserted != 1 {
+		t.Fatalf("dry run report: %+v", report)
+	}
+	if code, ex, _ := runMemory(t, "global", "export"); code != 0 || strings.Contains(ex, "use go test") {
+		t.Fatalf("dry run wrote memory: %s", ex)
+	}
+
+	// A real import stores it.
+	if code, out, stderr := runMemory(t, "global", "import", file); code != 0 {
+		t.Fatalf("import failed: %s", stderr)
+	} else if !strings.Contains(out, `"inserted":1`) || !strings.Contains(out, `"dry_run":false`) {
+		t.Fatalf("import report: %s", out)
+	}
+	if code, ex, _ := runMemory(t, "global", "export"); code != 0 || !strings.Contains(ex, "use go test") {
+		t.Fatalf("import did not persist: %s", ex)
+	}
+
+	// Re-importing the same key conflicts; default policy rejects the batch.
+	if code, _, stderr := runMemory(t, "global", "import", file); code != 1 || stderr == "" {
+		t.Fatalf("conflict not rejected: code=%d stderr=%q", code, stderr)
+	}
+	// skip tolerates it.
+	if code, out, _ := runMemory(t, "global", "import", file, "--on-conflict", "skip"); code != 0 || !strings.Contains(out, `"skipped":1`) {
+		t.Fatalf("skip policy: code=%d out=%s", code, out)
+	}
+}
