+// parseImportArgs reads `<file> [--dry-run] [--on-conflict error|skip|replace]`.
+// Flags may follow the filename; it rejects unknown flags, missing flag
+// values, extra positional arguments and invalid policy values.
+func parseImportArgs(tokens []string) (file string, policy memory.ConflictPolicy, dryRun bool, err error) {
+	policy = memory.ConflictError
+	sawFile := false
+	for i := 0; i < len(tokens); i++ {
+		tok := tokens[i]
+		switch {
+		case tok == "--dry-run":
+			dryRun = true
+		case tok == "--on-conflict":
+			i++
+			if i >= len(tokens) {
+				return "", "", false, fmt.Errorf("--on-conflict requires a value")
+			}
+			policy, err = memory.ParseConflictPolicy(tokens[i])
+			if err != nil {
+				return "", "", false, err
+			}
+		case strings.HasPrefix(tok, "--on-conflict="):
+			policy, err = memory.ParseConflictPolicy(strings.TrimPrefix(tok, "--on-conflict="))
+			if err != nil {
+				return "", "", false, err
+			}
+		case strings.HasPrefix(tok, "-"):
+			return "", "", false, fmt.Errorf("unknown flag %q", tok)
+		default:
+			if sawFile {
+				return "", "", false, fmt.Errorf("unexpected extra argument %q", tok)
+			}
+			file = tok
+			sawFile = true
+		}
+	}
+	if !sawFile {
+		return "", "", false, fmt.Errorf("import requires an input file")
+	}
+	return file, policy, dryRun, nil
+}
