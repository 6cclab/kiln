diff --git a/internal/memory/import.go b/internal/memory/import.go
new file mode 100644
index 0000000..2722eae
--- /dev/null
+++ b/internal/memory/import.go
@@ -0,0 +1,391 @@
+package memory
+
+import (
+	"bytes"
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+// Import size and shape bounds. An export is history, so an input holds more
+// rows than keys; these cap the file and the row count before anything is
+// decoded or allocated.
+const (
+	maxImportBytes   = 4 << 20 // 4 MiB
+	maxImportRecords = 1000
+)
+
+// ConflictPolicy decides what an import does when a selected key already has
+// an active destination record.
+type ConflictPolicy string
+
+const (
+	// ConflictError rejects the whole batch if any selected key already exists.
+	ConflictError ConflictPolicy = "error"
+	// ConflictSkip leaves existing records untouched and imports the rest.
+	ConflictSkip ConflictPolicy = "skip"
+	// ConflictReplace supersedes the existing record, preserving its history.
+	ConflictReplace ConflictPolicy = "replace"
+)
+
+// ParseConflictPolicy validates a user-supplied policy name.
+func ParseConflictPolicy(s string) (ConflictPolicy, error) {
+	switch ConflictPolicy(s) {
+	case ConflictError, ConflictSkip, ConflictReplace:
+		return ConflictPolicy(s), nil
+	default:
+		return "", fmt.Errorf("invalid conflict policy %q (want error, skip or replace)", s)
+	}
+}
+
+// ImportResult reports per-key outcomes. Counts describe selected current
+// keys, not the historical rows an export carries.
+type ImportResult struct {
+	Inserted int  `json:"inserted"`
+	Replaced int  `json:"replaced"`
+	Skipped  int  `json:"skipped"`
+	DryRun   bool `json:"dry_run"`
+}
+
+// ImportOptions configures a batch import into one destination scope.
+type ImportOptions struct {
+	// Scope is the destination scope; it is never taken from the input.
+	Scope string
+	// ProjectRoot is the current project's canonical root, used to rebind and
+	// re-verify file sources. It is empty for a global preferences import,
+	// which rejects any source-bearing record outright.
+	ProjectRoot string
+	// Data is the raw export file: exactly one JSON array of records.
+	Data []byte
+	// Policy decides conflict handling. Defaults to ConflictError when empty.
+	Policy ConflictPolicy
+	// DryRun validates and analyses conflicts but writes nothing.
+	DryRun bool
+}
+
+// ReadImportFile reads an export file, bounding the read before allocation and
+// rejecting anything larger than the import limit. It never reads from stdin.
+func ReadImportFile(path string) ([]byte, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	info, err := f.Stat()
+	if err != nil {
+		return nil, err
+	}
+	if !info.Mode().IsRegular() {
+		return nil, errors.New("import file must be a regular file")
+	}
+	if info.Size() > maxImportBytes {
+		return nil, fmt.Errorf("import file exceeds %d bytes", maxImportBytes)
+	}
+	// Bound the read even if the size on disk changed after the stat.
+	data, err := io.ReadAll(io.LimitReader(f, maxImportBytes+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(data) > maxImportBytes {
+		return nil, fmt.Errorf("import file exceeds %d bytes", maxImportBytes)
+	}
+	return data, nil
+}
+
+// decodeExport parses exactly one JSON array of records in the export format,
+// rejecting malformed JSON, trailing data, unknown fields, non-array input and
+// an oversized record count. An empty array is valid; a top-level null is not.
+func decodeExport(data []byte) ([]Record, error) {
+	if len(data) > maxImportBytes {
+		return nil, fmt.Errorf("import exceeds %d bytes", maxImportBytes)
+	}
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.DisallowUnknownFields()
+	var records []Record
+	if err := dec.Decode(&records); err != nil {
+		return nil, fmt.Errorf("invalid import JSON: %w", err)
+	}
+	if records == nil {
+		return nil, errors.New("import must be a JSON array of records")
+	}
+	// Reject trailing JSON or other trailing bytes after the array.
+	if _, err := dec.Token(); !errors.Is(err, io.EOF) {
+		return nil, errors.New("unexpected trailing data after JSON array")
+	}
+	if len(records) > maxImportRecords {
+		return nil, fmt.Errorf("import exceeds %d records", maxImportRecords)
+	}
+	return records, nil
+}
+
+// validateFields enforces the same field, kind and expiry limits Put applies,
+// without trusting the input's scope, id, created or supersedes values.
+func validateFields(r Record) error {
+	if strings.TrimSpace(r.Key) == "" || strings.TrimSpace(r.Text) == "" || strings.TrimSpace(r.Evidence) == "" {
+		return errors.New("key, text and evidence are required")
+	}
+	if len(r.Key) > 256 || len(r.Text) > 8192 || len(r.Evidence) > 2048 {
+		return errors.New("memory exceeds field limits")
+	}
+	switch r.Kind {
+	case "preference", "fact", "procedure", "observation":
+	default:
+		return errors.New("invalid memory kind")
+	}
+	if r.Expires < 0 {
+		return errors.New("expires must be nonnegative")
+	}
+	return nil
+}
+
+// rebindRoot computes a record's source path relative to its original root,
+// purely lexically: original machine paths are never read. An absolute source
+// path is valid only when lexically contained in the (absolute) original root;
+// a relative source path is interpreted under that root. Escapes are rejected.
+func rebindRoot(src Source) (string, error) {
+	if !filepath.IsAbs(src.Root) {
+		return "", errors.New("source root must be absolute")
+	}
+	root := filepath.Clean(src.Root)
+	var rel string
+	if filepath.IsAbs(src.Path) {
+		r, err := filepath.Rel(root, filepath.Clean(src.Path))
+		if err != nil {
+			return "", errors.New("source path is outside its root")
+		}
+		rel = r
+	} else {
+		rel = filepath.Clean(src.Path)
+	}
+	if rel == "." || rel == ".." || filepath.IsAbs(rel) || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		return "", errors.New("source path escapes its root")
+	}
+	return rel, nil
+}
+
+func isHex256(s string) bool {
+	if len(s) != 64 {
+		return false
+	}
+	for _, c := range s {
+		switch {
+		case c >= '0' && c <= '9', c >= 'a' && c <= 'f':
+		default:
+			return false
+		}
+	}
+	return true
+}
+
+// rebindSources rebinds every source into the current project root and
+// re-verifies each against the destination file, returning the destination
+// bindings to store. It reads only destination files.
+func rebindSources(destRoot string, sources []Source) ([]Source, error) {
+	if len(sources) == 0 {
+		return nil, nil
+	}
+	if destRoot == "" {
+		return nil, errors.New("source-bearing records are not allowed in this scope")
+	}
+	if len(sources) > 8 {
+		return nil, errors.New("at most eight memory source files are allowed")
+	}
+	canonical, err := filepath.EvalSymlinks(destRoot)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]Source, 0, len(sources))
+	for _, src := range sources {
+		if !isHex256(src.SHA256) {
+			return nil, errors.New("source hash is not a valid sha-256")
+		}
+		rel, err := rebindRoot(src)
+		if err != nil {
+			return nil, err
+		}
+		destPath := filepath.Join(canonical, rel)
+		digest, err := sourceDigest(canonical, destPath)
+		if err != nil {
+			return nil, err
+		}
+		if digest != src.SHA256 {
+			return nil, errors.New("source file does not match its recorded hash")
+		}
+		out = append(out, Source{Root: canonical, Path: destPath, SHA256: digest})
+	}
+	return out, nil
+}
+
+// prepared is a fully validated selected record ready to apply.
+type prepared struct {
+	key      string
+	kind     string
+	text     string
+	evidence string
+	expires  int64
+	sources  []Source
+	inputID  int64
+	seq      int // input order of the selected version, for deterministic apply
+}
+
+// prepareImport validates every record, rebinds and re-verifies sources,
+// enforces scope rules and selects the largest-ID version per key. It touches
+// no database and reads only destination files.
+func prepareImport(opts ImportOptions) ([]prepared, error) {
+	records, err := decodeExport(opts.Data)
+	if err != nil {
+		return nil, err
+	}
+	global := opts.Scope == GlobalPreferencesScope
+	seen := make(map[int64]bool, len(records))
+	selected := make(map[string]prepared)
+	for i, r := range records {
+		if err := validateFields(r); err != nil {
+			return nil, err
+		}
+		if r.ID <= 0 {
+			return nil, errors.New("import record ids must be positive")
+		}
+		if seen[r.ID] {
+			return nil, errors.New("import record ids must be unique")
+		}
+		seen[r.ID] = true
+		if global {
+			if r.Kind != "preference" || len(r.Sources) != 0 {
+				return nil, errors.New("global import accepts preference records without sources only")
+			}
+		}
+		bound, err := rebindSources(opts.ProjectRoot, r.Sources)
+		if err != nil {
+			return nil, err
+		}
+		cur, ok := selected[r.Key]
+		if !ok || r.ID > cur.inputID {
+			selected[r.Key] = prepared{
+				key:      r.Key,
+				kind:     r.Kind,
+				text:     r.Text,
+				evidence: r.Evidence,
+				expires:  r.Expires,
+				sources:  bound,
+				inputID:  r.ID,
+				seq:      i,
+			}
+		}
+	}
+	out := make([]prepared, 0, len(selected))
+	for _, p := range selected {
+		out = append(out, p)
+	}
+	// Deterministic apply order by input position of the selected version.
+	sortPrepared(out)
+	return out, nil
+}
+
+func sortPrepared(p []prepared) {
+	for i := 1; i < len(p); i++ {
+		for j := i; j > 0 && p[j].seq < p[j-1].seq; j-- {
+			p[j], p[j-1] = p[j-1], p[j]
+		}
+	}
+}
+
+// Import applies a validated batch in one transaction. Validation failures,
+// cancellation and write failures leave all destination memories, search
+// entries and source bindings unchanged. A dry run performs the same work but
+// commits nothing.
+func (s *Store) Import(ctx context.Context, opts ImportOptions) (ImportResult, error) {
+	if opts.Scope == "" {
+		return ImportResult{}, errors.New("destination scope is required")
+	}
+	policy := opts.Policy
+	if policy == "" {
+		policy = ConflictError
+	}
+	if _, err := ParseConflictPolicy(string(policy)); err != nil {
+		return ImportResult{}, err
+	}
+	batch, err := prepareImport(opts)
+	if err != nil {
+		return ImportResult{}, err
+	}
+	result := ImportResult{DryRun: opts.DryRun}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return ImportResult{}, err
+	}
+	defer rollback(tx)
+	now := time.Now().Unix()
+	for _, p := range batch {
+		var previous int64
+		err := tx.QueryRowContext(ctx, `SELECT id FROM memories WHERE scope=? AND key=? AND active=1`, opts.Scope, p.key).Scan(&previous)
+		conflict := err == nil
+		if err != nil && !errors.Is(err, sql.ErrNoRows) {
+			return ImportResult{}, err
+		}
+		if conflict {
+			switch policy {
+			case ConflictError:
+				return ImportResult{}, fmt.Errorf("memory key %q already exists; batch rejected", p.key)
+			case ConflictSkip:
+				result.Skipped++
+				continue
+			case ConflictReplace:
+				if _, err := tx.ExecContext(ctx, `UPDATE memories SET active=0 WHERE scope=? AND key=? AND active=1`, opts.Scope, p.key); err != nil {
+					return ImportResult{}, err
+				}
+			}
+		}
+		supersedes := int64(0)
+		if conflict {
+			supersedes = previous
+		}
+		if err := insertPrepared(ctx, tx, opts.Scope, now, p, supersedes); err != nil {
+			return ImportResult{}, err
+		}
+		if conflict {
+			result.Replaced++
+		} else {
+			result.Inserted++
+		}
+	}
+	if opts.DryRun {
+		// Deferred rollback discards every write; the analysis stands.
+		return result, nil
+	}
+	if err := tx.Commit(); err != nil {
+		return ImportResult{}, err
+	}
+	return result, nil
+}
+
+func insertPrepared(ctx context.Context, tx *sql.Tx, scope string, now int64, p prepared, supersedes int64) error {
+	res, err := tx.ExecContext(ctx, `INSERT INTO memories(scope,key,kind,text,evidence,created,expires,supersedes) VALUES(?,?,?,?,?,?,?,?)`, scope, p.key, p.kind, p.text, p.evidence, now, p.expires, supersedes)
+	if err != nil {
+		return err
+	}
+	id, err := res.LastInsertId()
+	if err != nil {
+		return err
+	}
+	if _, err := tx.ExecContext(ctx, `INSERT INTO memory_search(rowid,text,evidence) VALUES(?,?,?)`, id, p.key+"\n"+p.text, p.evidence); err != nil {
+		return err
+	}
+	if len(p.sources) > 0 {
+		raw, err := json.Marshal(p.sources)
+		if err != nil {
+			return err
+		}
+		if _, err := tx.ExecContext(ctx, `INSERT INTO memory_sources(memory_id,sources) VALUES(?,?)`, id, string(raw)); err != nil {
+			return err
+		}
+	}
+	return nil
+}
