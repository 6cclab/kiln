+
+func mustJSON(t *testing.T, records []Record) []byte {
+	t.Helper()
+	data, err := json.Marshal(records)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return data
+}
+
+func openImportStore(t *testing.T) *Store {
+	t.Helper()
+	s, err := Open(filepath.Join(t.TempDir(), "memory.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := s.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	return s
+}
+
+const projectScope = "/project"
+
+// rec is a minimal valid source-free record in export form.
+func rec(id int64, key, text string) Record {
+	return Record{ID: id, Scope: "someoneelse", Key: key, Kind: "fact", Text: text, Evidence: "exported"}
+}
+
+func TestImportSelectsLargestIDPerKeyAndIgnoresInputScope(t *testing.T) {
+	s := openImportStore(t)
+	ctx := context.Background()
+	// Two keys, each with history; the largest input id is the current version.
+	data := mustJSON(t, []Record{
+		rec(1, "db", "uses mysql"),
+		rec(2, "cache", "uses redis"),
+		rec(5, "db", "uses postgres"),
+		rec(3, "db", "uses sqlite"),
+	})
+	res, err := s.Import(ctx, ImportOptions{Scope: projectScope, Data: data})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.Inserted != 2 || res.Replaced != 0 || res.Skipped != 0 || res.DryRun {
+		t.Fatalf("counts: %+v", res)
+	}
+	cur, err := s.Current(ctx, projectScope, "db", "")
+	if err != nil || cur == nil || cur.Text != "uses postgres" {
+		t.Fatalf("db current: %+v %v", cur, err)
+	}
+	// The historical versions were not replayed: exactly one row per key.
+	exported, err := s.Export(ctx, projectScope)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var rows []Record
+	if err := json.Unmarshal(exported, &rows); err != nil {
+		t.Fatal(err)
+	}
+	if len(rows) != 2 {
+		t.Fatalf("expected 2 destination rows, got %d: %s", len(rows), exported)
+	}
+	for _, r := range rows {
+		if r.Scope != projectScope {
+			t.Fatalf("input scope leaked into destination: %q", r.Scope)
+		}
+		if r.Supersedes != 0 {
+			t.Fatalf("fresh import must not claim lineage: %+v", r)
+		}
+	}
+	// Nothing was written under the input's scope.
+	other, err := s.Export(ctx, "someoneelse")
+	if err != nil || string(other) != "[]" {
+		t.Fatalf("input scope written: %s %v", other, err)
+	}
+}
+
+func TestImportConflictPolicies(t *testing.T) {
+	ctx := context.Background()
+	seed := func(s *Store) int64 {
+		id, err := s.Put(ctx, Record{Scope: projectScope, Key: "db", Kind: "fact", Text: "local truth", Evidence: "user"})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return id
+	}
+	data := mustJSON(t, []Record{rec(9, "db", "imported"), rec(4, "fresh", "new key")})
+
+	t.Run("error rejects whole batch", func(t *testing.T) {
+		s := openImportStore(t)
+		seed(s)
+		if _, err := s.Import(ctx, ImportOptions{Scope: projectScope, Data: data, Policy: ConflictError}); err == nil {
+			t.Fatal("expected conflict error")
+		}
+		// The non-conflicting key must not have been written.
+		cur, err := s.Current(ctx, projectScope, "fresh", "")
+		if err != nil || cur != nil {
+			t.Fatalf("batch not atomic: %+v %v", cur, err)
+		}
+		cur, _ = s.Current(ctx, projectScope, "db", "")
+		if cur == nil || cur.Text != "local truth" {
+			t.Fatalf("existing record changed: %+v", cur)
+		}
+	})
+
+	t.Run("skip leaves existing untouched", func(t *testing.T) {
+		s := openImportStore(t)
+		seed(s)
+		res, err := s.Import(ctx, ImportOptions{Scope: projectScope, Data: data, Policy: ConflictSkip})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if res.Inserted != 1 || res.Skipped != 1 || res.Replaced != 0 {
+			t.Fatalf("counts: %+v", res)
+		}
+		cur, _ := s.Current(ctx, projectScope, "db", "")
+		if cur == nil || cur.Text != "local truth" {
+			t.Fatalf("skip altered existing: %+v", cur)
+		}
+		cur, _ = s.Current(ctx, projectScope, "fresh", "")
+		if cur == nil || cur.Text != "new key" {
+			t.Fatalf("skip dropped fresh key: %+v", cur)
+		}
+	})
+
+	t.Run("replace supersedes and preserves history", func(t *testing.T) {
+		s := openImportStore(t)
+		prev := seed(s)
+		res, err := s.Import(ctx, ImportOptions{Scope: projectScope, Data: data, Policy: ConflictReplace})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if res.Replaced != 1 || res.Inserted != 1 {
+			t.Fatalf("counts: %+v", res)
+		}
+		cur, _ := s.Current(ctx, projectScope, "db", "")
+		if cur == nil || cur.Text != "imported" || cur.Supersedes != prev {
+			t.Fatalf("replace lineage wrong: %+v (prev %d)", cur, prev)
+		}
+		// Local correction history survives: restore brings the old text back.
+		if _, err := s.Restore(ctx, projectScope, prev); err != nil {
+			t.Fatalf("history lost: %v", err)
+		}
+		cur, _ = s.Current(ctx, projectScope, "db", "")
+		if cur == nil || cur.Text != "local truth" {
+			t.Fatalf("restore after replace failed: %+v", cur)
+		}
+	})
+}
+
+func TestImportDryRunWritesNothing(t *testing.T) {
+	ctx := context.Background()
+	s := openImportStore(t)
+	data := mustJSON(t, []Record{rec(1, "a", "x"), rec(2, "b", "y")})
+	res, err := s.Import(ctx, ImportOptions{Scope: projectScope, Data: data, DryRun: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !res.DryRun || res.Inserted != 2 {
+		t.Fatalf("dry-run counts: %+v", res)
+	}
+	exported, err := s.Export(ctx, projectScope)
+	if err != nil || string(exported) != "[]" {
+		t.Fatalf("dry run wrote records: %s %v", exported, err)
+	}
+}
+
+func TestImportPreservesExpiryAndFreshCreation(t *testing.T) {
+	ctx := context.Background()
+	s := openImportStore(t)
+	future := time.Now().Add(time.Hour).Unix()
+	in := Record{ID: 7, Scope: "x", Key: "k", Kind: "fact", Text: "t", Evidence: "e", Created: 123, Expires: future}
+	if _, err := s.Import(ctx, ImportOptions{Scope: projectScope, Data: mustJSON(t, []Record{in})}); err != nil {
+		t.Fatal(err)
+	}
+	cur, _ := s.Current(ctx, projectScope, "k", "")
+	if cur == nil || cur.Expires != future {
+		t.Fatalf("expiry not preserved: %+v", cur)
+	}
+	if cur.Created == 123 {
+		t.Fatalf("imported creation time must not be trusted: %+v", cur)
+	}
+}
+
+func TestImportMalformedInputs(t *testing.T) {
+	ctx := context.Background()
+	cases := map[string]string{
+		"malformed json":       `[{"id":1,`,
+		"trailing json":        `[{"id":1,"key":"k","kind":"fact","text":"t","evidence":"e"}] []`,
+		"trailing garbage":     `[] nonsense`,
+		"unknown field":        `[{"id":1,"key":"k","kind":"fact","text":"t","evidence":"e","bogus":1}]`,
+		"unknown source field": `[{"id":1,"key":"k","kind":"fact","text":"t","evidence":"e","sources":[{"root":"/r","path":"p","sha256":"x","extra":1}]}]`,
+		"null input":           `null`,
+		"object input":         `{"id":1}`,
+		"number input":         `5`,
+	}
+	for name, body := range cases {
+		t.Run(name, func(t *testing.T) {
+			s := openImportStore(t)
+			if _, err := s.Import(ctx, ImportOptions{Scope: projectScope, Data: []byte(body)}); err == nil {
+				t.Fatalf("%s accepted", name)
+			}
+		})
+	}
+	// An empty array is valid and imports nothing.
+	s := openImportStore(t)
+	res, err := s.Import(ctx, ImportOptions{Scope: projectScope, Data: []byte(`[]`)})
+	if err != nil || res.Inserted != 0 {
+		t.Fatalf("empty array: %+v %v", res, err)
+	}
+}
+
+func TestImportRecordValidation(t *testing.T) {
+	ctx := context.Background()
+	bad := map[string][]Record{
+		"nonpositive id":   {{ID: 0, Key: "k", Kind: "fact", Text: "t", Evidence: "e"}},
+		"duplicate id":     {rec(1, "a", "x"), rec(1, "b", "y")},
+		"invalid kind":     {{ID: 1, Key: "k", Kind: "rumor", Text: "t", Evidence: "e"}},
+		"negative expires": {{ID: 1, Key: "k", Kind: "fact", Text: "t", Evidence: "e", Expires: -1}},
+		"empty text":       {{ID: 1, Key: "k", Kind: "fact", Text: "   ", Evidence: "e"}},
+		"oversize text":    {{ID: 1, Key: "k", Kind: "fact", Text: strings.Repeat("x", 8193), Evidence: "e"}},
+	}
+	for name, records := range bad {
+		t.Run(name, func(t *testing.T) {
+			s := openImportStore(t)
+			if _, err := s.Import(ctx, ImportOptions{Scope: projectScope, Data: mustJSON(t, records)}); err == nil {
+				t.Fatalf("%s accepted", name)
+			}
+		})
+	}
+}
+
+func TestImportLimits(t *testing.T) {
+	ctx := context.Background()
+	s := openImportStore(t)
+	many := make([]Record, 1001)
+	for i := range many {
+		many[i] = rec(int64(i+1), "k"+string(rune('a'+i%26))+string(rune('0'+i/26%10))+string(rune('0'+i/260)), "t")
+	}
+	if _, err := s.Import(ctx, ImportOptions{Scope: projectScope, Data: mustJSON(t, many)}); err == nil {
+		t.Fatal("over 1000 records accepted")
+	}
+	if _, err := s.Import(ctx, ImportOptions{Scope: projectScope, Data: []byte("[" + strings.Repeat(" ", (4<<20)+1) + "]")}); err == nil {
+		t.Fatal("oversize payload accepted")
+	}
+}
+
+func TestImportGlobalScopeRules(t *testing.T) {
+	ctx := context.Background()
+	s := openImportStore(t)
+	// Preference without sources is accepted.
+	ok := []Record{{ID: 1, Key: "style", Kind: "preference", Text: "spaces", Evidence: "user"}}
+	if _, err := s.Import(ctx, ImportOptions{Scope: GlobalPreferencesScope, Data: mustJSON(t, ok)}); err != nil {
+		t.Fatalf("valid global preference rejected: %v", err)
+	}
+	// A non-preference record is rejected even when it is only history.
+	hist := []Record{
+		{ID: 1, Key: "style", Kind: "fact", Text: "old", Evidence: "user"},
+		{ID: 2, Key: "style", Kind: "preference", Text: "new", Evidence: "user"},
+	}
+	s2 := openImportStore(t)
+	if _, err := s2.Import(ctx, ImportOptions{Scope: GlobalPreferencesScope, Data: mustJSON(t, hist)}); err == nil {
+		t.Fatal("historical non-preference accepted into global scope")
+	}
+	// A source-bearing record is rejected in global scope.
+	src := []Record{{ID: 1, Key: "style", Kind: "preference", Text: "t", Evidence: "e", Sources: []Source{{Root: "/r", Path: "p", SHA256: strings.Repeat("a", 64)}}}}
+	s3 := openImportStore(t)
+	if _, err := s3.Import(ctx, ImportOptions{Scope: GlobalPreferencesScope, Data: mustJSON(t, src)}); err == nil {
+		t.Fatal("global source record accepted")
+	}
+}
+
+func writeFile(t *testing.T, root, rel, content string) {
+	t.Helper()
+	full := filepath.Join(root, rel)
+	if err := os.MkdirAll(filepath.Dir(full), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(full, []byte(content), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestImportProjectSources(t *testing.T) {
+	ctx := context.Background()
+	destRoot := t.TempDir()
+	if canon, err := filepath.EvalSymlinks(destRoot); err == nil {
+		destRoot = canon
+	}
+	writeFile(t, destRoot, "notes/readme.md", "hello world")
+	// Compute the destination file's hash via the existing capture path.
+	captured, err := CaptureSources(destRoot, []string{"notes/readme.md"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	good := captured[0].SHA256
+
+	// Original root is an absolute path that need not exist here; the relative
+	// layout is rebound into destRoot and re-verified against the real file.
+	origRoot := "/exported/from/elsewhere"
+	rec := func(sha string) Record {
+		return Record{ID: 1, Key: "k", Kind: "fact", Text: "t", Evidence: "e",
+			Sources: []Source{{Root: origRoot, Path: "notes/readme.md", SHA256: sha}}}
+	}
+
+	t.Run("valid rebind and verify", func(t *testing.T) {
+		s := openImportStore(t)
+		if _, err := s.Import(ctx, ImportOptions{Scope: projectScope, ProjectRoot: destRoot, Data: mustJSON(t, []Record{rec(good)})}); err != nil {
+			t.Fatalf("valid source rejected: %v", err)
+		}
+		cur, err := s.Current(ctx, projectScope, "k", destRoot)
+		if err != nil || cur == nil || len(cur.Sources) != 1 {
+			t.Fatalf("source not stored/current: %+v %v", cur, err)
+		}
+		if cur.Sources[0].Root != destRoot {
+			t.Fatalf("binding not rebound to destination root: %+v", cur.Sources[0])
+		}
+	})
+
+	t.Run("hash mismatch rejected", func(t *testing.T) {
+		s := openImportStore(t)
+		if _, err := s.Import(ctx, ImportOptions{Scope: projectScope, ProjectRoot: destRoot, Data: mustJSON(t, []Record{rec(strings.Repeat("b", 64))})}); err == nil {
+			t.Fatal("changed file accepted")
+		}
+	})
+
+	t.Run("missing file rejected", func(t *testing.T) {
+		s := openImportStore(t)
+		gone := Record{ID: 1, Key: "k", Kind: "fact", Text: "t", Evidence: "e",
+			Sources: []Source{{Root: origRoot, Path: "notes/missing.md", SHA256: good}}}
+		if _, err := s.Import(ctx, ImportOptions{Scope: projectScope, ProjectRoot: destRoot, Data: mustJSON(t, []Record{gone})}); err == nil {
+			t.Fatal("missing file accepted")
+		}
+	})
+
+	t.Run("path escape rejected", func(t *testing.T) {
+		s := openImportStore(t)
+		esc := Record{ID: 1, Key: "k", Kind: "fact", Text: "t", Evidence: "e",
+			Sources: []Source{{Root: origRoot, Path: "../escape.md", SHA256: good}}}
+		if _, err := s.Import(ctx, ImportOptions{Scope: projectScope, ProjectRoot: destRoot, Data: mustJSON(t, []Record{esc})}); err == nil {
+			t.Fatal("relative escape accepted")
+		}
+		abs := Record{ID: 1, Key: "k", Kind: "fact", Text: "t", Evidence: "e",
+			Sources: []Source{{Root: origRoot, Path: "/etc/passwd", SHA256: good}}}
+		if _, err := s.Import(ctx, ImportOptions{Scope: projectScope, ProjectRoot: destRoot, Data: mustJSON(t, []Record{abs})}); err == nil {
+			t.Fatal("absolute path outside root accepted")
+		}
+	})
+
+	t.Run("relative original root rejected", func(t *testing.T) {
+		s := openImportStore(t)
+		relRoot := Record{ID: 1, Key: "k", Kind: "fact", Text: "t", Evidence: "e",
+			Sources: []Source{{Root: "relative/root", Path: "notes/readme.md", SHA256: good}}}
+		if _, err := s.Import(ctx, ImportOptions{Scope: projectScope, ProjectRoot: destRoot, Data: mustJSON(t, []Record{relRoot})}); err == nil {
+			t.Fatal("relative original root accepted")
+		}
+	})
+
+	t.Run("stale historical source rejected", func(t *testing.T) {
+		s := openImportStore(t)
+		// The selected (max-id) record is clean, but a historical one is stale.
+		records := []Record{
+			{ID: 1, Key: "k", Kind: "fact", Text: "old", Evidence: "e",
+				Sources: []Source{{Root: origRoot, Path: "notes/readme.md", SHA256: strings.Repeat("c", 64)}}},
+			rec(good),
+		}
+		records[1].ID = 2
+		if _, err := s.Import(ctx, ImportOptions{Scope: projectScope, ProjectRoot: destRoot, Data: mustJSON(t, records)}); err == nil {
+			t.Fatal("stale historical source accepted")
+		}
+	})
+
+	t.Run("too many sources rejected", func(t *testing.T) {
+		s := openImportStore(t)
+		nine := make([]Source, 9)
+		for i := range nine {
+			nine[i] = Source{Root: origRoot, Path: "notes/readme.md", SHA256: good}
+		}
+		r := Record{ID: 1, Key: "k", Kind: "fact", Text: "t", Evidence: "e", Sources: nine}
+		if _, err := s.Import(ctx, ImportOptions{Scope: projectScope, ProjectRoot: destRoot, Data: mustJSON(t, []Record{r})}); err == nil {
+			t.Fatal("nine sources accepted")
+		}
+	})
+}
+
+func TestImportConflictOnExpiredRecord(t *testing.T) {
+	ctx := context.Background()
+	s := openImportStore(t)
+	// An expired-but-active record is still a conflict.
+	if _, err := s.Put(ctx, Record{Scope: projectScope, Key: "k", Kind: "fact", Text: "stale", Evidence: "user", Expires: time.Now().Add(-time.Hour).Unix()}); err != nil {
+		t.Fatal(err)
+	}
+	data := mustJSON(t, []Record{rec(1, "k", "new")})
+	if _, err := s.Import(ctx, ImportOptions{Scope: projectScope, Data: data, Policy: ConflictError}); err == nil {
+		t.Fatal("expired active record did not count as a conflict")
+	}
+	res, err := s.Import(ctx, ImportOptions{Scope: projectScope, Data: data, Policy: ConflictReplace})
+	if err != nil || res.Replaced != 1 {
+		t.Fatalf("replace over expired failed: %+v %v", res, err)
+	}
+}
