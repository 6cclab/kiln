+)
+
+// TestMemoryImportCLIRoundTripAndSourceRebind drives the real binary through a
+// full export/import cycle, including a project file source binding exported
+// from one machine root and re-verified against another worktree.
+//
+// Proved able to fail: drop the destination-scope override in Store.Import ->
+// the imported record lands in the input scope and the second project cannot
+// see it; skip source re-verification -> a tampered file imports anyway.
+func TestMemoryImportCLIRoundTripAndSourceRebind(t *testing.T) {
+	home, _ := scratchHome(t)
+	env := map[string]string{"HOME": home, "KILN_TMPDIR": filepath.Join(home, "tmp")}
+
+	projA := scratchProject(t)
+	projB := scratchProject(t)
+
+	run := func(dir string, args ...string) runResult {
+		t.Helper()
+		return runHarness(t, dir, env, args...)
+	}
+
+	// Record a global preference and a project fact bound to src/math.js.
+	if r := run(projA, "memory", "global", "remember", "style", "Prefer concise answers"); r.Code != 0 {
+		t.Fatalf("global remember: %s", r.Stderr)
+	}
+	if r := run(projA, "memory", "remember", "adder", "add() subtracts", "src/math.js"); r.Code != 0 {
+		t.Fatalf("project remember: %s", r.Stderr)
+	}
+
+	// Export the project scope, then forget it so the import is a clean insert.
+	exp := run(projA, "memory", "export")
+	if exp.Code != 0 {
+		t.Fatalf("export: %s", exp.Stderr)
+	}
+	if !strings.Contains(exp.Stdout, "add() subtracts") {
+		t.Fatalf("export missing record: %s", exp.Stdout)
+	}
+
+	// Rewrite the exported root to a nonexistent machine path to prove the
+	// original paths are never read and the binding is re-rooted on import.
+	var records []map[string]any
+	if err := json.Unmarshal([]byte(exp.Stdout), &records); err != nil {
+		t.Fatalf("parse export: %v", err)
+	}
+	for _, rec := range records {
+		srcs, _ := rec["sources"].([]any)
+		for _, s := range srcs {
+			m := s.(map[string]any)
+			oldRoot, _ := m["root"].(string)
+			oldPath, _ := m["path"].(string)
+			rel := strings.TrimPrefix(oldPath, oldRoot)
+			m["root"] = "/nonexistent/origin"
+			m["path"] = filepath.Join("/nonexistent/origin", rel)
+		}
+	}
+	rerooted, err := json.Marshal(records)
+	if err != nil {
+		t.Fatal(err)
+	}
+	exportFile := filepath.Join(t.TempDir(), "export.json")
+	if err := os.WriteFile(exportFile, rerooted, 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	// Import the project scope into projB (which has the same src/math.js).
+	imp := run(projB, "memory", "import", exportFile)
+	if imp.Code != 0 {
+		t.Fatalf("import into projB: %s", imp.Stderr)
+	}
+	var counts struct {
+		Inserted, Replaced, Skipped int
+		DryRun                      bool `json:"dry_run"`
+	}
+	if err := json.Unmarshal([]byte(strings.TrimSpace(imp.Stdout)), &counts); err != nil {
+		t.Fatalf("import JSON %q: %v", imp.Stdout, err)
+	}
+	if counts.Inserted != 1 || counts.DryRun {
+		t.Fatalf("unexpected counts: %+v", counts)
+	}
+	// The record is now visible in projB's own scope.
+	expB := run(projB, "memory", "export")
+	if expB.Code != 0 || !strings.Contains(expB.Stdout, "add() subtracts") {
+		t.Fatalf("record not in projB scope: %s %s", expB.Stdout, expB.Stderr)
+	}
+
+	// Default error policy rejects a re-import; dry-run reports the same.
+	if r := run(projB, "memory", "import", exportFile); r.Code == 0 {
+		t.Fatalf("re-import under error policy succeeded: %s", r.Stdout)
+	}
+	if r := run(projB, "memory", "import", exportFile, "--dry-run", "--on-conflict", "replace"); r.Code != 0 || !strings.Contains(r.Stdout, `"replaced":1`) {
+		t.Fatalf("dry-run replace: code=%d out=%s err=%s", r.Code, r.Stdout, r.Stderr)
+	}
+
+	// Tampering with the destination file makes the source import fail.
+	if err := os.WriteFile(filepath.Join(projB, "src", "math.js"), []byte("tampered\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	projC := scratchProject(t)
+	if err := os.WriteFile(filepath.Join(projC, "src", "math.js"), []byte("different\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if r := run(projC, "memory", "import", exportFile); r.Code == 0 {
+		t.Fatalf("import accepted a changed source file: %s", r.Stdout)
+	}
+
+	// The global preference import is independent of project sources.
+	globalExport := run(projA, "memory", "global", "export")
+	if globalExport.Code != 0 {
+		t.Fatalf("global export: %s", globalExport.Stderr)
+	}
+	gfile := filepath.Join(t.TempDir(), "global.json")
+	if err := os.WriteFile(gfile, []byte(globalExport.Stdout), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	homeB, _ := scratchHome(t)
+	envB := map[string]string{"HOME": homeB, "KILN_TMPDIR": filepath.Join(homeB, "tmp")}
+	gr := runHarness(t, projB, envB, "memory", "global", "import", gfile)
+	if gr.Code != 0 || !strings.Contains(gr.Stdout, `"inserted":1`) {
+		t.Fatalf("global import: code=%d out=%s err=%s", gr.Code, gr.Stdout, gr.Stderr)
+	}
+}
