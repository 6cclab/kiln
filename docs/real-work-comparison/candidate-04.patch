+package memory
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func openStore(t *testing.T) *Store {
+	t.Helper()
+	s, err := Open(filepath.Join(t.TempDir(), "memory.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := s.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	return s
+}
+
+func TestImportInsertReplaceSkipAndDryRun(t *testing.T) {
+	s := openStore(t)
+	ctx := context.Background()
+	rec := func(key, text string) Record {
+		return Record{Scope: "ignored", Key: key, Kind: "fact", Text: text, Evidence: "import"}
+	}
+
+	// A clean insert of two keys.
+	counts, err := s.Import(ctx, "proj", []Record{rec("a", "one"), rec("b", "two")}, ConflictError, false)
+	if err != nil || counts.Inserted != 2 || counts.Replaced != 0 || counts.Skipped != 0 {
+		t.Fatalf("insert: %+v %v", counts, err)
+	}
+	// The destination scope wins over the input's scope.
+	got, err := s.Current(ctx, "proj", "a", "")
+	if err != nil || got == nil || got.Scope != "proj" || got.Text != "one" || got.Supersedes != 0 {
+		t.Fatalf("current a: %+v %v", got, err)
+	}
+
+	// error policy rejects the whole batch on any conflict and writes nothing.
+	counts, err = s.Import(ctx, "proj", []Record{rec("a", "changed"), rec("c", "new")}, ConflictError, false)
+	if err == nil {
+		t.Fatal("error policy accepted a conflict")
+	}
+	if got, _ := s.Current(ctx, "proj", "c", ""); got != nil {
+		t.Fatal("error policy wrote a non-conflicting record")
+	}
+	if got, _ := s.Current(ctx, "proj", "a", ""); got == nil || got.Text != "one" {
+		t.Fatal("error policy mutated the conflicting record")
+	}
+
+	// skip leaves conflicts untouched, inserts the rest.
+	counts, err = s.Import(ctx, "proj", []Record{rec("a", "changed"), rec("c", "new")}, ConflictSkip, false)
+	if err != nil || counts.Inserted != 1 || counts.Skipped != 1 {
+		t.Fatalf("skip: %+v %v", counts, err)
+	}
+	if got, _ := s.Current(ctx, "proj", "a", ""); got == nil || got.Text != "one" {
+		t.Fatal("skip changed an existing key")
+	}
+
+	// replace supersedes, preserving history.
+	counts, err = s.Import(ctx, "proj", []Record{rec("a", "replaced")}, ConflictReplace, false)
+	if err != nil || counts.Replaced != 1 || counts.Inserted != 0 {
+		t.Fatalf("replace: %+v %v", counts, err)
+	}
+	got, err = s.Current(ctx, "proj", "a", "")
+	if err != nil || got == nil || got.Text != "replaced" || got.Supersedes == 0 {
+		t.Fatalf("replace current: %+v %v", got, err)
+	}
+	exported, err := s.Export(ctx, "proj")
+	if err != nil {
+		t.Fatal(err)
+	}
+	// History retained: the superseded "one" is still present.
+	if !strings.Contains(string(exported), "one") || !strings.Contains(string(exported), "replaced") {
+		t.Fatalf("replace lost history: %s", exported)
+	}
+
+	// dry run reports what replace would do but writes nothing.
+	counts, err = s.Import(ctx, "proj", []Record{rec("a", "dryrun")}, ConflictReplace, true)
+	if err != nil || counts.Replaced != 1 {
+		t.Fatalf("dry run: %+v %v", counts, err)
+	}
+	if got, _ := s.Current(ctx, "proj", "a", ""); got == nil || got.Text != "replaced" {
+		t.Fatal("dry run wrote a record")
+	}
+}
+
+func TestImportConflictCountsExpiredAndStaleSources(t *testing.T) {
+	s := openStore(t)
+	ctx := context.Background()
+	// An expired active record is still a conflict.
+	if _, err := s.Put(ctx, Record{Scope: "proj", Key: "k", Kind: "fact", Text: "old", Evidence: "e", Expires: time.Now().Add(-time.Hour).Unix()}); err != nil {
+		t.Fatal(err)
+	}
+	counts, err := s.Import(ctx, "proj", []Record{{Key: "k", Kind: "fact", Text: "new", Evidence: "e"}}, ConflictSkip, false)
+	if err != nil || counts.Skipped != 1 || counts.Inserted != 0 {
+		t.Fatalf("expired active key was not a conflict: %+v %v", counts, err)
+	}
+}
+
+func TestImportInvalidPolicyAndScope(t *testing.T) {
+	s := openStore(t)
+	ctx := context.Background()
+	if _, err := s.Import(ctx, "proj", nil, ConflictPolicy("bogus"), false); err == nil {
+		t.Fatal("invalid policy accepted")
+	}
+	if _, err := s.Import(ctx, "", nil, ConflictError, false); err == nil {
+		t.Fatal("empty scope accepted")
+	}
+}
+
+func TestValidateImportRecord(t *testing.T) {
+	ok := Record{Key: "k", Kind: "fact", Text: "t", Evidence: "e"}
+	if err := ValidateImportRecord(ok); err != nil {
+		t.Fatalf("valid rejected: %v", err)
+	}
+	bad := []Record{
+		{Key: "", Kind: "fact", Text: "t", Evidence: "e"},
+		{Key: "k", Kind: "fact", Text: "", Evidence: "e"},
+		{Key: "k", Kind: "fact", Text: "t", Evidence: ""},
+		{Key: "k", Kind: "bogus", Text: "t", Evidence: "e"},
+		{Key: "k", Kind: "fact", Text: "t", Evidence: "e", Expires: -1},
+	}
+	for i, r := range bad {
+		if err := ValidateImportRecord(r); err == nil {
+			t.Errorf("case %d: invalid record accepted", i)
+		}
+	}
+}
+
+func TestRebindSourcesVerifiesDestination(t *testing.T) {
+	origin := "/originally/elsewhere"
+	current := t.TempDir()
+	if err := os.WriteFile(filepath.Join(current, "f.txt"), []byte("hello"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	// Capture a digest for "hello" by binding the current file.
+	captured, err := CaptureSources(current, []string{"f.txt"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	digest := captured[0].SHA256
+
+	// An exported binding from a different machine root, same relative path.
+	exported := []Source{{Root: origin, Path: filepath.Join(origin, "f.txt"), SHA256: digest}}
+	rebound, err := RebindSources(current, exported)
+	if err != nil || len(rebound) != 1 {
+		t.Fatalf("rebind valid: %v", err)
+	}
+	canonical, _ := filepath.EvalSymlinks(current)
+	if rebound[0].Root != canonical || rebound[0].Path != filepath.Join(canonical, "f.txt") {
+		t.Fatalf("rebind kept original root: %+v", rebound[0])
+	}
+
+	// Changed destination contents -> hash mismatch.
+	if err := os.WriteFile(filepath.Join(current, "f.txt"), []byte("changed"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := RebindSources(current, exported); err == nil {
+		t.Fatal("changed source accepted")
+	}
+
+	// Escaping absolute path (not within its root).
+	escape := []Source{{Root: origin, Path: "/etc/passwd", SHA256: digest}}
+	if _, err := RebindSources(current, escape); err == nil {
+		t.Fatal("escaping absolute source accepted")
+	}
+	// Relative escape.
+	relEscape := []Source{{Root: origin, Path: "../../etc/passwd", SHA256: digest}}
+	if _, err := RebindSources(current, relEscape); err == nil {
+		t.Fatal("relative escape accepted")
+	}
+	// Non-absolute original root.
+	badRoot := []Source{{Root: "relative/root", Path: "f.txt", SHA256: digest}}
+	if _, err := RebindSources(current, badRoot); err == nil {
+		t.Fatal("non-absolute root accepted")
+	}
+	// Invalid hash.
+	badHash := []Source{{Root: origin, Path: filepath.Join(origin, "f.txt"), SHA256: "nothex"}}
+	if _, err := RebindSources(current, badHash); err == nil {
+		t.Fatal("invalid hash accepted")
+	}
+	// Missing destination file.
+	missing := []Source{{Root: origin, Path: filepath.Join(origin, "gone.txt"), SHA256: digest}}
+	if _, err := RebindSources(current, missing); err == nil {
+		t.Fatal("missing destination accepted")
+	}
+	// Too many files.
+	many := make([]Source, 9)
+	for i := range many {
+		many[i] = Source{Root: origin, Path: filepath.Join(origin, "f.txt"), SHA256: digest}
+	}
+	if _, err := RebindSources(current, many); err == nil {
+		t.Fatal("nine sources accepted")
+	}
+}
