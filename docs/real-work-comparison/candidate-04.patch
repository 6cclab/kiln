diff --git a/internal/cli/memory_import.go b/internal/cli/memory_import.go
new file mode 100644
index 0000000..95bdc6f
--- /dev/null
+++ b/internal/cli/memory_import.go
@@ -0,0 +1,237 @@
+package cli
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/andrepato/harness/internal/diag"
+	"github.com/andrepato/harness/internal/memory"
+)
+
+const (
+	// maxImportBytes bounds the import file before it is read into memory.
+	maxImportBytes = 4 << 20
+	// maxImportRecords bounds how many history rows one import may carry.
+	maxImportRecords = 1000
+)
+
+// MemoryImport implements `kiln memory [global] import <file> [--dry-run]
+// [--on-conflict error|skip|replace]`. It is a local management command: it
+// never starts a model, never reads stdin, and writes nothing until a single
+// transaction applies the whole selected batch. argv is the arguments after
+// the `memory` subcommand word.
+func MemoryImport(ctx context.Context, argv []string, out, stderr io.Writer) int {
+	const usage = "usage: kiln memory [global] import <file> [--dry-run] [--on-conflict error|skip|replace]"
+	usageErr := func() int { writeDiagnostic(stderr, usage); return 2 }
+	fail := func(v ...any) int { writeDiagnostic(stderr, append([]any{"kiln: memory import:"}, v...)...); return 1 }
+
+	rest := argv
+	global := false
+	if len(rest) > 0 && rest[0] == "global" {
+		global = true
+		rest = rest[1:]
+	}
+	if len(rest) == 0 || rest[0] != "import" {
+		return usageErr()
+	}
+	rest = rest[1:]
+
+	file := ""
+	fileSet := false
+	policy := memory.ConflictError
+	dryRun := false
+	for i := 0; i < len(rest); i++ {
+		tok := rest[i]
+		switch {
+		case tok == "--dry-run":
+			dryRun = true
+		case tok == "--on-conflict" || strings.HasPrefix(tok, "--on-conflict="):
+			var val string
+			if eq := strings.IndexByte(tok, '='); eq != -1 {
+				val = tok[eq+1:]
+			} else if i+1 < len(rest) && !strings.HasPrefix(rest[i+1], "-") {
+				i++
+				val = rest[i]
+			} else {
+				writeDiagnostic(stderr, "kiln: --on-conflict requires a value (error|skip|replace)")
+				return 2
+			}
+			switch val {
+			case "error":
+				policy = memory.ConflictError
+			case "skip":
+				policy = memory.ConflictSkip
+			case "replace":
+				policy = memory.ConflictReplace
+			default:
+				writeDiagnostic(stderr, "kiln: --on-conflict must be error, skip or replace")
+				return 2
+			}
+		case strings.HasPrefix(tok, "-"):
+			writeDiagnostic(stderr, "kiln: unknown flag "+tok)
+			return 2
+		default:
+			if fileSet {
+				return usageErr()
+			}
+			file = tok
+			fileSet = true
+		}
+	}
+	if !fileSet {
+		return usageErr()
+	}
+
+	cwd, err := os.Getwd()
+	if err != nil {
+		return fail(err)
+	}
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return fail(err)
+	}
+
+	data, err := readImportFile(file)
+	if err != nil {
+		return fail(err)
+	}
+	records, err := decodeExport(data)
+	if err != nil {
+		return fail(err)
+	}
+	if len(records) > maxImportRecords {
+		return fail(fmt.Errorf("import exceeds %d records", maxImportRecords))
+	}
+
+	scope := memoryScope(cwd)
+	if global {
+		scope = memory.GlobalPreferencesScope
+	}
+	projectRoot := memoryProjectRoot(cwd)
+
+	// Validate every record, including historical versions, before any
+	// selection: a stale source-bearing record or a non-preference global
+	// record rejects the whole batch even when it is not the selected version.
+	ids := make(map[int64]struct{}, len(records))
+	for i := range records {
+		r := &records[i]
+		if err := memory.ValidateImportRecord(*r); err != nil {
+			return fail(fmt.Errorf("record %d: %w", i+1, err))
+		}
+		if r.ID <= 0 {
+			return fail(fmt.Errorf("record %d: input ids must be positive", i+1))
+		}
+		if _, dup := ids[r.ID]; dup {
+			return fail(fmt.Errorf("duplicate input id %d", r.ID))
+		}
+		ids[r.ID] = struct{}{}
+		if global {
+			if r.Kind != "preference" || len(r.Sources) != 0 {
+				return fail(fmt.Errorf("record %d: global import accepts preference records without file sources only", i+1))
+			}
+			continue
+		}
+		if len(r.Sources) > 0 {
+			rebound, err := memory.RebindSources(projectRoot, r.Sources)
+			if err != nil {
+				return fail(fmt.Errorf("record %d: %w", i+1, err))
+			}
+			r.Sources = rebound
+		}
+	}
+
+	// The current version of each key is the record with the largest input id;
+	// uniqueness above guarantees there are no ties to break.
+	selected := make(map[string]memory.Record, len(records))
+	for _, r := range records {
+		if cur, ok := selected[r.Key]; !ok || r.ID > cur.ID {
+			selected[r.Key] = r
+		}
+	}
+	items := make([]memory.Record, 0, len(selected))
+	for _, r := range selected {
+		items = append(items, r)
+	}
+	sort.Slice(items, func(a, b int) bool { return items[a].Key < items[b].Key })
+
+	s, err := memory.Open(filepath.Join(home, ".kiln", "memory.db"))
+	if err != nil {
+		return fail(err)
+	}
+	defer diag.Close(s)
+
+	counts, err := s.Import(ctx, scope, items, policy, dryRun)
+	if err != nil {
+		return fail(err)
+	}
+
+	result := struct {
+		Inserted int  `json:"inserted"`
+		Replaced int  `json:"replaced"`
+		Skipped  int  `json:"skipped"`
+		DryRun   bool `json:"dry_run"`
+	}{counts.Inserted, counts.Replaced, counts.Skipped, dryRun}
+	encoded, err := json.Marshal(result)
+	if err != nil {
+		return fail(err)
+	}
+	if _, err := fmt.Fprintln(out, string(encoded)); err != nil {
+		return fail(err)
+	}
+	return 0
+}
+
+// readImportFile reads at most 4 MiB from a regular file, bounding the read
+// before allocation. A missing filename is the caller's concern: this is only
+// reached with one, and stdin is never read.
+func readImportFile(path string) ([]byte, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer diag.Close(f)
+	info, err := f.Stat()
+	if err != nil {
+		return nil, err
+	}
+	if !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("import file must be a regular file")
+	}
+	if info.Size() > maxImportBytes {
+		return nil, fmt.Errorf("import file exceeds 4 MiB")
+	}
+	data, err := io.ReadAll(io.LimitReader(f, maxImportBytes+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(data) > maxImportBytes {
+		return nil, fmt.Errorf("import file exceeds 4 MiB")
+	}
+	return data, nil
+}
+
+// decodeExport parses exactly one JSON array of records in the export format.
+// Unknown record or source fields, non-array or null input, and any trailing
+// data after the array are all rejected.
+func decodeExport(data []byte) ([]memory.Record, error) {
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.DisallowUnknownFields()
+	var records []memory.Record
+	if err := dec.Decode(&records); err != nil {
+		return nil, fmt.Errorf("invalid memory export: %w", err)
+	}
+	if records == nil {
+		return nil, fmt.Errorf("memory export must be a JSON array")
+	}
+	if _, err := dec.Token(); err != io.EOF {
+		return nil, fmt.Errorf("unexpected trailing data after the memory export array")
+	}
+	return records, nil
+}
diff --git a/internal/cli/memory_import_test.go b/internal/cli/memory_import_test.go
new file mode 100644
index 0000000..8786a16
--- /dev/null
+++ b/internal/cli/memory_import_test.go
@@ -0,0 +1,268 @@
+package cli
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+// importCall runs MemoryImport from a project directory with a scratch HOME,
+// returning exit code, stdout and stderr.
+func importCall(t *testing.T, proj string, argv ...string) (int, string, string) {
+	t.Helper()
+	var out, stderr bytes.Buffer
+	cwd, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chdir(proj); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if err := os.Chdir(cwd); err != nil {
+			t.Fatal(err)
+		}
+	}()
+	code := MemoryImport(context.Background(), argv, &out, &stderr)
+	return code, out.String(), stderr.String()
+}
+
+func writeFile(t *testing.T, dir, name, body string) string {
+	t.Helper()
+	p := filepath.Join(dir, name)
+	if err := os.WriteFile(p, []byte(body), 0600); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+// setup makes a scratch HOME and a project directory.
+func importSetup(t *testing.T) (home, proj string) {
+	t.Helper()
+	home = t.TempDir()
+	t.Setenv("HOME", home)
+	proj = t.TempDir()
+	return home, proj
+}
+
+func decodeCounts(t *testing.T, out string) (inserted, replaced, skipped int, dryRun bool) {
+	t.Helper()
+	var r struct {
+		Inserted int  `json:"inserted"`
+		Replaced int  `json:"replaced"`
+		Skipped  int  `json:"skipped"`
+		DryRun   bool `json:"dry_run"`
+	}
+	if err := json.Unmarshal([]byte(strings.TrimSpace(out)), &r); err != nil {
+		t.Fatalf("bad success JSON %q: %v", out, err)
+	}
+	return r.Inserted, r.Replaced, r.Skipped, r.DryRun
+}
+
+func TestMemoryImportRoundTrip(t *testing.T) {
+	_, proj := importSetup(t)
+	export := `[
+	  {"id": 1, "scope": "other-machine", "key": "runner", "kind": "preference", "text": "Use make check", "evidence": "user"},
+	  {"id": 2, "scope": "other-machine", "key": "runner", "kind": "preference", "text": "Use make check -race", "evidence": "correction"}
+	]`
+	file := writeFile(t, proj, "export.json", export)
+
+	// dry run writes nothing but reports the would-be insert.
+	code, out, stderr := importCall(t, proj, "import", file, "--dry-run")
+	if code != 0 {
+		t.Fatalf("dry run failed: %s", stderr)
+	}
+	ins, rep, skip, dry := decodeCounts(t, out)
+	if ins != 1 || rep != 0 || skip != 0 || !dry {
+		t.Fatalf("dry counts: %d %d %d %v", ins, rep, skip, dry)
+	}
+
+	// Real import of the same export: the id=2 version is current.
+	code, out, stderr = importCall(t, proj, "import", file)
+	if code != 0 {
+		t.Fatalf("import failed: %s", stderr)
+	}
+	if ins, _, _, dry := decodeCounts(t, out); ins != 1 || dry {
+		t.Fatalf("import counts: %d %v", ins, dry)
+	}
+	exported := exportProject(t, proj)
+	if !strings.Contains(exported, "Use make check -race") {
+		t.Fatalf("selected version missing: %s", exported)
+	}
+	// The imported record landed in the project scope, not "other-machine".
+	if strings.Contains(exported, "other-machine") {
+		t.Fatalf("import trusted the input scope: %s", exported)
+	}
+
+	// Re-importing now conflicts: default error policy rejects.
+	code, _, stderr = importCall(t, proj, "import", file)
+	if code == 0 {
+		t.Fatal("re-import under default error policy succeeded")
+	}
+	if strings.Contains(stderr, "Use make check") {
+		t.Fatalf("diagnostic echoed memory text: %s", stderr)
+	}
+
+	// skip leaves it alone.
+	code, out, stderr = importCall(t, proj, "import", file, "--on-conflict", "skip")
+	if code != 0 {
+		t.Fatalf("skip failed: %s", stderr)
+	}
+	if _, _, skip, _ := decodeCounts(t, out); skip != 1 {
+		t.Fatalf("skip count: %d", skip)
+	}
+
+	// replace supersedes, preserving history.
+	code, out, stderr = importCall(t, proj, "import", file, "--on-conflict", "replace")
+	if code != 0 {
+		t.Fatalf("replace failed: %s", stderr)
+	}
+	if _, rep, _, _ := decodeCounts(t, out); rep != 1 {
+		t.Fatalf("replace count: %d", rep)
+	}
+}
+
+// exportProject runs `memory export` from proj via PersonalMemory and returns stdout.
+func exportProject(t *testing.T, proj string) string {
+	t.Helper()
+	var out, stderr bytes.Buffer
+	cwd, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chdir(proj); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if err := os.Chdir(cwd); err != nil {
+			t.Fatal(err)
+		}
+	}()
+	if code := PersonalMemory(context.Background(), Args{Positional: []string{"export"}}, &out, &stderr); code != 0 {
+		t.Fatalf("export failed: %s", stderr.String())
+	}
+	return out.String()
+}
+
+func TestMemoryImportRejectsBadInput(t *testing.T) {
+	_, proj := importSetup(t)
+	valid := `{"id":1,"scope":"x","key":"k","kind":"fact","text":"t","evidence":"e"}`
+	cases := []struct {
+		name string
+		body string
+	}{
+		{"not an array", valid},
+		{"null", `null`},
+		{"malformed", `[{]`},
+		{"trailing json", `[` + valid + `]  [1]`},
+		{"unknown record field", `[{"id":1,"key":"k","kind":"fact","text":"t","evidence":"e","bogus":1}]`},
+		{"unknown source field", `[{"id":1,"key":"k","kind":"fact","text":"t","evidence":"e","sources":[{"root":"/r","path":"/r/x","sha256":"` + strings.Repeat("a", 64) + `","extra":1}]}]`},
+		{"nonpositive id", `[{"id":0,"key":"k","kind":"fact","text":"t","evidence":"e"}]`},
+		{"duplicate id", `[` + valid + `,` + valid + `]`},
+		{"bad kind", `[{"id":1,"key":"k","kind":"bogus","text":"t","evidence":"e"}]`},
+		{"negative expires", `[{"id":1,"key":"k","kind":"fact","text":"t","evidence":"e","expires":-5}]`},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			file := writeFile(t, t.TempDir(), "in.json", tc.body)
+			code, out, stderr := importCall(t, proj, "import", file)
+			if code == 0 {
+				t.Fatalf("accepted bad input; out=%s", out)
+			}
+			if stderr == "" {
+				t.Fatal("no diagnostic")
+			}
+			if out != "" {
+				t.Fatalf("printed success JSON on failure: %s", out)
+			}
+		})
+	}
+}
+
+func TestMemoryImportEmptyArrayValid(t *testing.T) {
+	_, proj := importSetup(t)
+	file := writeFile(t, proj, "empty.json", `[]`)
+	code, out, stderr := importCall(t, proj, "import", file)
+	if code != 0 {
+		t.Fatalf("empty array rejected: %s", stderr)
+	}
+	if ins, rep, skip, _ := decodeCounts(t, out); ins != 0 || rep != 0 || skip != 0 {
+		t.Fatalf("nonzero counts for empty import: %d %d %d", ins, rep, skip)
+	}
+}
+
+func TestMemoryImportFlagAndArgErrors(t *testing.T) {
+	_, proj := importSetup(t)
+	file := writeFile(t, proj, "in.json", `[]`)
+	cases := [][]string{
+		{"import"},                                     // missing filename
+		{"import", file, "extra.json"},                 // extra positional
+		{"import", file, "--bogus"},                    // unknown flag
+		{"import", file, "--on-conflict"},              // missing value
+		{"import", file, "--on-conflict", "nonsense"},  // invalid policy
+		{"import", file, "--on-conflict", "--dry-run"}, // missing value (next is a flag)
+		{"global", "export"},                           // not an import subcommand
+	}
+	for _, argv := range cases {
+		code, out, _ := importCall(t, proj, argv...)
+		if code == 0 {
+			t.Errorf("argv %v was accepted; out=%s", argv, out)
+		}
+	}
+}
+
+func TestMemoryImportOversizedAndTooManyRecords(t *testing.T) {
+	_, proj := importSetup(t)
+
+	big := writeFile(t, proj, "big.json", "["+strings.Repeat(" ", (4<<20)+1)+"]")
+	if code, _, _ := importCall(t, proj, "import", big); code == 0 {
+		t.Fatal("oversized file accepted")
+	}
+
+	var b strings.Builder
+	b.WriteString("[")
+	for i := 1; i <= 1001; i++ {
+		if i > 1 {
+			b.WriteString(",")
+		}
+		rec := struct {
+			ID       int    `json:"id"`
+			Key      string `json:"key"`
+			Kind     string `json:"kind"`
+			Text     string `json:"text"`
+			Evidence string `json:"evidence"`
+		}{i, "k" + strconv.Itoa(i), "fact", "t", "e"}
+		enc, _ := json.Marshal(rec)
+		b.Write(enc)
+	}
+	b.WriteString("]")
+	many := writeFile(t, proj, "many.json", b.String())
+	if code, _, _ := importCall(t, proj, "import", many); code == 0 {
+		t.Fatal("over-1000-record import accepted")
+	}
+}
+
+func TestMemoryImportGlobalRejectsNonPreferenceHistory(t *testing.T) {
+	_, proj := importSetup(t)
+	// id=2 is a valid preference, but a historical id=1 is a fact: the whole
+	// batch must be rejected even though id=1 is not the selected version.
+	body := `[
+	  {"id":1,"key":"p","kind":"fact","text":"t","evidence":"e"},
+	  {"id":2,"key":"p","kind":"preference","text":"t2","evidence":"e"}
+	]`
+	file := writeFile(t, proj, "g.json", body)
+	if code, _, _ := importCall(t, proj, "global", "import", file); code == 0 {
+		t.Fatal("global import accepted a non-preference historical record")
+	}
+	// A source-bearing global record is also rejected.
+	src := `[{"id":1,"key":"p","kind":"preference","text":"t","evidence":"e","sources":[{"root":"/r","path":"/r/x","sha256":"` + strings.Repeat("a", 64) + `"}]}]`
+	file = writeFile(t, proj, "gs.json", src)
+	if code, _, _ := importCall(t, proj, "global", "import", file); code == 0 {
+		t.Fatal("global import accepted a source-bearing record")
+	}
+}
