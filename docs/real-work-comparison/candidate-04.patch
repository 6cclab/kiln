+// validHexDigest reports whether h is a 64-character hex SHA-256 digest.
+func validHexDigest(h string) bool {
+	if len(h) != 64 {
+		return false
+	}
+	for _, c := range h {
+		switch {
+		case c >= '0' && c <= '9', c >= 'a' && c <= 'f', c >= 'A' && c <= 'F':
+		default:
+			return false
+		}
+	}
+	return true
+}
+
+// sourceRelative recovers a source's project-relative path from its exported
+// original root, without ever touching the original machine paths (the root
+// must be absolute but need not exist here). An absolute source path is valid
+// only when lexically contained in that root; a relative source path is
+// interpreted under it. Either way the result must stay inside the root.
+func sourceRelative(root, path string) (string, error) {
+	cleanRoot := filepath.Clean(root)
+	var rel string
+	if filepath.IsAbs(path) {
+		r, err := filepath.Rel(cleanRoot, filepath.Clean(path))
+		if err != nil {
+			return "", fmt.Errorf("memory source path is outside its project")
+		}
+		rel = r
+	} else {
+		rel = filepath.Clean(path)
+	}
+	if rel == "." || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) || filepath.IsAbs(rel) {
+		return "", fmt.Errorf("memory source path escapes its project")
+	}
+	return rel, nil
+}
+
+// RebindSources re-roots exported source bindings into the current project
+// root and verifies each against the destination file, returning destination
+// bindings to store. It never reads the exported original paths: only their
+// lexical relationship to the exported root recovers each project-relative
+// path, which is then resolved under the current root and hashed. It rejects
+// too many files, non-absolute or invalid roots, invalid hashes, path escapes,
+// and (via sourceDigest) missing, changed, redirected, nonregular or oversized
+// destination files.
+func RebindSources(root string, sources []Source) ([]Source, error) {
+	if len(sources) > 8 {
+		return nil, fmt.Errorf("at most eight memory source files are allowed")
+	}
+	canonical, err := filepath.EvalSymlinks(root)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]Source, 0, len(sources))
+	for _, src := range sources {
+		if !filepath.IsAbs(src.Root) {
+			return nil, fmt.Errorf("memory source root must be absolute")
+		}
+		if !validHexDigest(src.SHA256) {
+			return nil, fmt.Errorf("memory source has an invalid hash")
+		}
+		rel, err := sourceRelative(src.Root, src.Path)
+		if err != nil {
+			return nil, err
+		}
+		dest := filepath.Join(canonical, rel)
+		digest, err := sourceDigest(canonical, dest)
+		if err != nil {
+			return nil, err
+		}
+		if digest != src.SHA256 {
+			return nil, fmt.Errorf("memory source no longer matches its recorded contents")
+		}
+		out = append(out, Source{Root: canonical, Path: dest, SHA256: src.SHA256})
+	}
+	return out, nil
+}
