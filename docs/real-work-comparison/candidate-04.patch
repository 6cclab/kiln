+package memory
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"strings"
+)
+
+// ConflictPolicy decides what happens when an imported key already has an
+// active record in the destination scope.
+type ConflictPolicy string
+
+const (
+	// ConflictError rejects the entire batch if any key already exists.
+	ConflictError ConflictPolicy = "error"
+	// ConflictSkip leaves an existing key untouched and imports the rest.
+	ConflictSkip ConflictPolicy = "skip"
+	// ConflictReplace supersedes an existing key, preserving its history.
+	ConflictReplace ConflictPolicy = "replace"
+)
+
+// ImportCounts reports how many destination keys an import changed. The counts
+// describe selected current keys, never the historical rows behind them.
+type ImportCounts struct {
+	Inserted int `json:"inserted"`
+	Replaced int `json:"replaced"`
+	Skipped  int `json:"skipped"`
+}
+
+// ValidateImportRecord enforces the same field and kind limits Put applies,
+// plus a nonnegative expiry, on a record offered for import. It deliberately
+// ignores scope, created and supersedes: those are destination identity and
+// lineage, which an import never supplies. Diagnostics name no record text.
+func ValidateImportRecord(r Record) error {
+	if strings.TrimSpace(r.Key) == "" || strings.TrimSpace(r.Text) == "" || strings.TrimSpace(r.Evidence) == "" {
+		return errors.New("key, text and evidence are required")
+	}
+	if len(r.Key) > 256 || len(r.Text) > 8192 || len(r.Evidence) > 2048 {
+		return errors.New("memory exceeds field limits")
+	}
+	switch r.Kind {
+	case "preference", "fact", "procedure", "observation":
+	default:
+		return errors.New("invalid memory kind")
+	}
+	if r.Expires < 0 {
+		return errors.New("memory expiry must be nonnegative")
+	}
+	return nil
+}
+
+// Import applies a validated, already-selected batch of current records into
+// one destination scope under a conflict policy, in a single transaction. The
+// caller has validated every record and rebound every source to this machine;
+// Import only decides conflicts and writes. Each item's scope is forced to the
+// destination scope, and its id, created and supersedes are reassigned, so no
+// imported identity or lineage is trusted. A dry run performs the same conflict
+// analysis but commits nothing. Any error leaves the database unchanged.
+func (s *Store) Import(ctx context.Context, scope string, items []Record, policy ConflictPolicy, dryRun bool) (ImportCounts, error) {
+	switch policy {
+	case ConflictError, ConflictSkip, ConflictReplace:
+	default:
+		return ImportCounts{}, errors.New("invalid conflict policy")
+	}
+	if scope == "" {
+		return ImportCounts{}, errors.New("destination scope is required")
+	}
+	var counts ImportCounts
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return ImportCounts{}, err
+	}
+	defer rollback(tx)
+	for _, item := range items {
+		var existing int64
+		err := tx.QueryRowContext(ctx, `SELECT id FROM memories WHERE scope=? AND key=? AND active=1`, scope, item.Key).Scan(&existing)
+		if err != nil && err != sql.ErrNoRows {
+			return ImportCounts{}, err
+		}
+		conflict := err == nil
+		if conflict {
+			switch policy {
+			case ConflictError:
+				return ImportCounts{}, fmt.Errorf("key %q already exists in the destination scope; rerun with --on-conflict skip or replace", item.Key)
+			case ConflictSkip:
+				counts.Skipped++
+				continue
+			case ConflictReplace:
+				counts.Replaced++
+			}
+		} else {
+			counts.Inserted++
+		}
+		if dryRun {
+			continue
+		}
+		// Reassign destination identity and lineage; putTx sets the id,
+		// creation time and the superseded link to the previous destination
+		// record only.
+		item.Scope = scope
+		item.ID = 0
+		item.Created = 0
+		item.Supersedes = 0
+		if _, err := s.putTx(ctx, tx, item); err != nil {
+			return ImportCounts{}, err
+		}
+	}
+	if dryRun {
+		return counts, nil
+	}
+	return counts, tx.Commit()
+}
