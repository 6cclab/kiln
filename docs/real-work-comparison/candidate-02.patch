+
+func openTestStore(t *testing.T) *Store {
+	t.Helper()
+	s, err := Open(filepath.Join(t.TempDir(), "memory.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := s.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	return s
+}
+
+// marshal serializes records into export form for an import test.
+func marshal(t *testing.T, records []Record) []byte {
+	t.Helper()
+	data, err := json.Marshal(records)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return data
+}
+
+func TestImportSelectsLargestIDPerKey(t *testing.T) {
+	s := openTestStore(t)
+	ctx := context.Background()
+	// Two historical versions of the same key; the larger id wins. Imported
+	// scope/created/supersedes are not trusted.
+	data := marshal(t, []Record{
+		{ID: 5, Scope: "wrong", Key: "runner", Kind: "fact", Text: "uses npm", Evidence: "old", Created: 111, Supersedes: 99},
+		{ID: 9, Scope: "wrong", Key: "runner", Kind: "fact", Text: "uses pnpm", Evidence: "new", Created: 222, Supersedes: 5},
+	})
+	res, err := s.Import(ctx, "proj", "", ConflictError, false, data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res != (ImportResult{Inserted: 1}) {
+		t.Fatalf("result %+v", res)
+	}
+	cur, err := s.Current(ctx, "proj", "runner", "")
+	if err != nil || cur == nil {
+		t.Fatalf("current %v %v", cur, err)
+	}
+	if cur.Text != "uses pnpm" || cur.Scope != "proj" || cur.Supersedes != 0 || cur.Created == 222 {
+		t.Fatalf("untrusted fields leaked: %+v", cur)
+	}
+	// The exported history itself is not replayed: only one row exists.
+	exported, err := s.Export(ctx, "proj")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(exported), "uses npm") {
+		t.Fatalf("history replayed: %s", exported)
+	}
+}
+
+func TestImportRejectsBadInput(t *testing.T) {
+	s := openTestStore(t)
+	ctx := context.Background()
+	cases := map[string]string{
+		"malformed":       `[{`,
+		"null":            `null`,
+		"object":          `{"id":1}`,
+		"trailing":        `[] []`,
+		"unknown record":  `[{"id":1,"scope":"p","key":"k","kind":"fact","text":"t","evidence":"e","bogus":1}]`,
+		"unknown source":  `[{"id":1,"key":"k","kind":"fact","text":"t","evidence":"e","sources":[{"root":"/r","path":"/r/f","sha256":"x","nope":1}]}]`,
+		"nonpositive id":  `[{"id":0,"key":"k","kind":"fact","text":"t","evidence":"e"}]`,
+		"duplicate id":    `[{"id":1,"key":"a","kind":"fact","text":"t","evidence":"e"},{"id":1,"key":"b","kind":"fact","text":"t","evidence":"e"}]`,
+		"negative expiry": `[{"id":1,"key":"k","kind":"fact","text":"t","evidence":"e","expires":-1}]`,
+		"bad kind":        `[{"id":1,"key":"k","kind":"nope","text":"t","evidence":"e"}]`,
+		"empty text":      `[{"id":1,"key":"k","kind":"fact","text":"  ","evidence":"e"}]`,
+	}
+	for name, in := range cases {
+		if _, err := s.Import(ctx, "proj", "", ConflictError, false, []byte(in)); err == nil {
+			t.Fatalf("%s: accepted invalid input", name)
+		}
+	}
+	// Nothing was written by any rejected batch.
+	exported, err := s.Export(ctx, "proj")
+	if err != nil || string(exported) != "[]" {
+		t.Fatalf("destination mutated: %s %v", exported, err)
+	}
+}
+
+func TestImportTooManyRecords(t *testing.T) {
+	s := openTestStore(t)
+	ctx := context.Background()
+	records := make([]Record, maxImportRecords+1)
+	for i := range records {
+		records[i] = Record{ID: int64(i + 1), Key: "k", Kind: "fact", Text: "t", Evidence: "e"}
+	}
+	if _, err := s.Import(ctx, "proj", "", ConflictError, false, marshal(t, records)); err == nil {
+		t.Fatal("accepted more than the record limit")
+	}
+}
+
+func TestImportEmptyArray(t *testing.T) {
+	s := openTestStore(t)
+	res, err := s.Import(context.Background(), "proj", "", ConflictError, false, []byte(`[]`))
+	if err != nil || res != (ImportResult{}) {
+		t.Fatalf("empty array: %+v %v", res, err)
+	}
+}
+
+func TestImportGlobalPreferencesOnly(t *testing.T) {
+	s := openTestStore(t)
+	ctx := context.Background()
+	// A historical non-preference record must reject the whole batch even
+	// though the selected record is a valid preference.
+	data := marshal(t, []Record{
+		{ID: 1, Key: "style", Kind: "observation", Text: "old", Evidence: "e"},
+		{ID: 2, Key: "style", Kind: "preference", Text: "concise", Evidence: "e"},
+	})
+	if _, err := s.Import(ctx, GlobalPreferencesScope, "", ConflictError, false, data); err == nil {
+		t.Fatal("global accepted a non-preference historical record")
+	}
+	// Preferences without sources import fine.
+	data = marshal(t, []Record{{ID: 2, Key: "style", Kind: "preference", Text: "concise", Evidence: "e"}})
+	if _, err := s.Import(ctx, GlobalPreferencesScope, "", ConflictError, false, data); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func writeFile(t *testing.T, path, body string) string {
+	t.Helper()
+	if err := os.WriteFile(path, []byte(body), 0600); err != nil {
+		t.Fatal(err)
+	}
+	sum := sha256.Sum256([]byte(body))
+	return hex.EncodeToString(sum[:])
+}
+
+func TestImportRebindsSources(t *testing.T) {
+	s := openTestStore(t)
+	ctx := context.Background()
+	root := t.TempDir()
+	digest := writeFile(t, filepath.Join(root, "config.toml"), "answer=42\n")
+	// Original root is an absolute path that need not exist here; the path is
+	// contained in it and rebinds to root/config.toml.
+	data := marshal(t, []Record{{
+		ID: 1, Key: "cfg", Kind: "observation", Text: "config detail", Evidence: "e",
+		Sources: []Source{{Root: "/other/machine/repo", Path: "/other/machine/repo/config.toml", SHA256: digest}},
+	}})
+	if _, err := s.Import(ctx, "proj", root, ConflictError, false, data); err != nil {
+		t.Fatal(err)
+	}
+	canonical, _ := filepath.EvalSymlinks(root)
+	cur, err := s.Current(ctx, "proj", "cfg", canonical)
+	if err != nil || cur == nil {
+		t.Fatalf("current %v %v", cur, err)
+	}
+	if len(cur.Sources) != 1 || cur.Sources[0].Root != canonical || cur.Sources[0].Path != filepath.Join(canonical, "config.toml") {
+		t.Fatalf("binding not rebound to destination: %+v", cur.Sources)
+	}
+}
+
+func TestImportRejectsStaleAndEscapingSources(t *testing.T) {
+	s := openTestStore(t)
+	ctx := context.Background()
+	root := t.TempDir()
+	digest := writeFile(t, filepath.Join(root, "config.toml"), "answer=42\n")
+
+	missing := marshal(t, []Record{{ID: 1, Key: "k", Kind: "observation", Text: "t", Evidence: "e",
+		Sources: []Source{{Root: "/o/r", Path: "/o/r/gone.toml", SHA256: digest}}}})
+	if _, err := s.Import(ctx, "proj", root, ConflictError, false, missing); err == nil {
+		t.Fatal("accepted a missing source")
+	}
+
+	changed := marshal(t, []Record{{ID: 1, Key: "k", Kind: "observation", Text: "t", Evidence: "e",
+		Sources: []Source{{Root: "/o/r", Path: "/o/r/config.toml", SHA256: strings.Repeat("0", 64)}}}})
+	if _, err := s.Import(ctx, "proj", root, ConflictError, false, changed); err == nil {
+		t.Fatal("accepted a changed source")
+	}
+
+	escape := marshal(t, []Record{{ID: 1, Key: "k", Kind: "observation", Text: "t", Evidence: "e",
+		Sources: []Source{{Root: "/o/r", Path: "/o/r/../etc/passwd", SHA256: digest}}}})
+	if _, err := s.Import(ctx, "proj", root, ConflictError, false, escape); err == nil {
+		t.Fatal("accepted an escaping source path")
+	}
+
+	relRoot := marshal(t, []Record{{ID: 1, Key: "k", Kind: "observation", Text: "t", Evidence: "e",
+		Sources: []Source{{Root: "relative/root", Path: "config.toml", SHA256: digest}}}})
+	if _, err := s.Import(ctx, "proj", root, ConflictError, false, relRoot); err == nil {
+		t.Fatal("accepted a non-absolute original root")
+	}
+
+	// A stale source on a historical (non-selected) record still rejects.
+	historicalStale := marshal(t, []Record{
+		{ID: 1, Key: "k", Kind: "observation", Text: "old", Evidence: "e",
+			Sources: []Source{{Root: "/o/r", Path: "/o/r/gone.toml", SHA256: digest}}},
+		{ID: 2, Key: "k", Kind: "observation", Text: "new", Evidence: "e",
+			Sources: []Source{{Root: "/o/r", Path: "/o/r/config.toml", SHA256: digest}}},
+	})
+	if _, err := s.Import(ctx, "proj", root, ConflictError, false, historicalStale); err == nil {
+		t.Fatal("accepted a stale historical source")
+	}
+	// Relative source path interpreted under the root also binds correctly.
+	rel := marshal(t, []Record{{ID: 1, Key: "ok", Kind: "observation", Text: "t", Evidence: "e",
+		Sources: []Source{{Root: "/o/r", Path: "config.toml", SHA256: digest}}}})
+	if _, err := s.Import(ctx, "proj", root, ConflictError, false, rel); err != nil {
+		t.Fatalf("relative source rejected: %v", err)
+	}
+
+	// A symlink inside the root that resolves outside it is rejected.
+	outside := filepath.Join(t.TempDir(), "secret.toml")
+	osum := writeFile(t, outside, "secret\n")
+	if err := os.Symlink(outside, filepath.Join(root, "link.toml")); err != nil {
+		t.Fatal(err)
+	}
+	symlink := marshal(t, []Record{{ID: 1, Key: "k", Kind: "observation", Text: "t", Evidence: "e",
+		Sources: []Source{{Root: "/o/r", Path: "/o/r/link.toml", SHA256: osum}}}})
+	if _, err := s.Import(ctx, "proj", root, ConflictError, false, symlink); err == nil {
+		t.Fatal("accepted a symlink escaping the root")
+	}
+}
+
+func TestImportConflictPolicies(t *testing.T) {
+	ctx := context.Background()
+	seed := func(s *Store, expires int64) {
+		if _, err := s.Put(ctx, Record{Scope: "proj", Key: "runner", Kind: "fact", Text: "existing", Evidence: "local"}); err != nil {
+			t.Fatal(err)
+		}
+		if expires != 0 {
+			if _, err := s.Put(ctx, Record{Scope: "proj", Key: "runner", Kind: "fact", Text: "existing", Evidence: "local", Expires: expires}); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	data := marshal(t, []Record{{ID: 1, Key: "runner", Kind: "fact", Text: "imported", Evidence: "e"}})
+
+	// error: whole batch rejected, destination unchanged.
+	s := openTestStore(t)
+	seed(s, 0)
+	if _, err := s.Import(ctx, "proj", "", ConflictError, false, data); err == nil {
+		t.Fatal("error policy accepted a conflict")
+	}
+	cur, _ := s.Current(ctx, "proj", "runner", "")
+	if cur == nil || cur.Text != "existing" {
+		t.Fatalf("error policy mutated destination: %+v", cur)
+	}
+
+	// skip: existing untouched, counted as skipped.
+	s = openTestStore(t)
+	seed(s, 0)
+	res, err := s.Import(ctx, "proj", "", ConflictSkip, false, data)
+	if err != nil || res != (ImportResult{Skipped: 1}) {
+		t.Fatalf("skip: %+v %v", res, err)
+	}
+	cur, _ = s.Current(ctx, "proj", "runner", "")
+	if cur.Text != "existing" {
+		t.Fatalf("skip overwrote: %+v", cur)
+	}
+
+	// replace: new current record, previous retained as history.
+	s = openTestStore(t)
+	seed(s, 0)
+	res, err = s.Import(ctx, "proj", "", ConflictReplace, false, data)
+	if err != nil || res != (ImportResult{Replaced: 1}) {
+		t.Fatalf("replace: %+v %v", res, err)
+	}
+	cur, _ = s.Current(ctx, "proj", "runner", "")
+	if cur.Text != "imported" || cur.Supersedes == 0 {
+		t.Fatalf("replace did not supersede: %+v", cur)
+	}
+	exported, _ := s.Export(ctx, "proj")
+	if !strings.Contains(string(exported), "existing") {
+		t.Fatalf("replace dropped history: %s", exported)
+	}
+
+	// An expired active record still counts as a conflict.
+	s = openTestStore(t)
+	seed(s, time.Now().Add(-time.Hour).Unix())
+	if _, err := s.Import(ctx, "proj", "", ConflictError, false, data); err == nil {
+		t.Fatal("expired active record was not treated as a conflict")
+	}
+}
+
+func TestImportDryRunWritesNothing(t *testing.T) {
+	s := openTestStore(t)
+	ctx := context.Background()
+	if _, err := s.Put(ctx, Record{Scope: "proj", Key: "runner", Kind: "fact", Text: "existing", Evidence: "local"}); err != nil {
+		t.Fatal(err)
+	}
+	data := marshal(t, []Record{
+		{ID: 1, Key: "runner", Kind: "fact", Text: "imported", Evidence: "e"},
+		{ID: 2, Key: "fresh", Kind: "fact", Text: "new", Evidence: "e"},
+	})
+	res, err := s.Import(ctx, "proj", "", ConflictReplace, true, data)
+	if err != nil || res != (ImportResult{Inserted: 1, Replaced: 1}) {
+		t.Fatalf("dry run counts: %+v %v", res, err)
+	}
+	cur, _ := s.Current(ctx, "proj", "runner", "")
+	if cur.Text != "existing" {
+		t.Fatalf("dry run mutated existing: %+v", cur)
+	}
+	if fresh, _ := s.Current(ctx, "proj", "fresh", ""); fresh != nil {
+		t.Fatalf("dry run inserted a record: %+v", fresh)
+	}
+}
