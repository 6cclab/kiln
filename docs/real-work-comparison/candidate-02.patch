+// MemoryImport ingests an exported memory array into the current project scope,
+// or the explicit global preferences scope. It is a local management command;
+// it does not start a model and never reads stdin. argv is the tokens after the
+// "memory" subcommand, so it begins with the optional "global" word and then
+// "import". Import parses its own flags, which the global flag parser does not
+// know, so cmd/kiln dispatches it before cli.Parse.
+func MemoryImport(ctx context.Context, argv []string, out, stderr io.Writer) int {
+	usage := "usage: kiln memory [global] import <file> [--dry-run] [--on-conflict error|skip|replace]"
+	rest := argv
+	global := false
+	if len(rest) > 0 && rest[0] == "global" {
+		global = true
+		rest = rest[1:]
+	}
+	if len(rest) == 0 || rest[0] != "import" {
+		writeDiagnostic(stderr, usage)
+		return 2
+	}
+	rest = rest[1:]
+
+	file := ""
+	haveFile := false
+	policy := memory.ConflictError
+	dryRun := false
+	for i := 0; i < len(rest); i++ {
+		tok := rest[i]
+		switch {
+		case tok == "--dry-run":
+			dryRun = true
+		case tok == "--on-conflict" || strings.HasPrefix(tok, "--on-conflict="):
+			var value string
+			if eq := strings.IndexByte(tok, '='); eq != -1 {
+				value = tok[eq+1:]
+			} else {
+				if i+1 >= len(rest) || strings.HasPrefix(rest[i+1], "-") {
+					writeDiagnostic(stderr, "kiln: --on-conflict expects a value")
+					return 2
+				}
+				i++
+				value = rest[i]
+			}
+			switch value {
+			case memory.ConflictError, memory.ConflictSkip, memory.ConflictReplace:
+				policy = value
+			default:
+				writeDiagnostic(stderr, "kiln: --on-conflict must be error, skip, or replace")
+				return 2
+			}
+		case strings.HasPrefix(tok, "-"):
+			writeDiagnostic(stderr, fmt.Sprintf("kiln: unknown flag %q", tok))
+			return 2
+		default:
+			if haveFile {
+				writeDiagnostic(stderr, usage)
+				return 2
+			}
+			file = tok
+			haveFile = true
+		}
+	}
+	if !haveFile {
+		writeDiagnostic(stderr, usage)
+		return 2
+	}
+
+	data, err := readImportFile(file)
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+
+	cwd, err := os.Getwd()
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	home, err := os.UserHomeDir()
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	s, err := memory.Open(filepath.Join(home, ".kiln", "memory.db"))
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	defer diag.Close(s)
+
+	scope := memoryScope(cwd)
+	projectRoot := memoryProjectRoot(cwd)
+	if global {
+		scope = memory.GlobalPreferencesScope
+		projectRoot = ""
+	}
+	result, err := s.Import(ctx, scope, projectRoot, policy, dryRun, data)
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	summary := struct {
+		Inserted int  `json:"inserted"`
+		Replaced int  `json:"replaced"`
+		Skipped  int  `json:"skipped"`
+		DryRun   bool `json:"dry_run"`
+	}{result.Inserted, result.Replaced, result.Skipped, dryRun}
+	encoded, err := json.Marshal(summary)
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	if _, err := fmt.Fprintln(out, string(encoded)); err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	return 0
+}
+
+// readImportFile reads at most maxImportFileBytes from a named file, rejecting
+// oversized input before allocating the whole file. It never reads stdin.
+func readImportFile(name string) ([]byte, error) {
+	info, err := os.Stat(name)
+	if err != nil {
+		return nil, err
+	}
+	if info.Size() > maxImportFileBytes {
+		return nil, fmt.Errorf("import file exceeds %d bytes", maxImportFileBytes)
+	}
+	f, err := os.Open(name)
+	if err != nil {
+		return nil, err
+	}
+	defer diag.Close(f)
+	data, err := io.ReadAll(io.LimitReader(f, maxImportFileBytes+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(data) > maxImportFileBytes {
+		return nil, fmt.Errorf("import file exceeds %d bytes", maxImportFileBytes)
+	}
+	return data, nil
+}
