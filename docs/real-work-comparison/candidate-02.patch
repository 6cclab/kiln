@@ -0,0 +1,128 @@
+package cli
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// callImport runs MemoryImport with argv as it appears after the "memory" word.
+func callImport(t *testing.T, argv ...string) (int, string, string) {
+	t.Helper()
+	var out, stderr bytes.Buffer
+	code := MemoryImport(context.Background(), argv, &out, &stderr)
+	return code, out.String(), stderr.String()
+}
+
+func TestMemoryImportRoundTrip(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	work := t.TempDir()
+	chdirTemp(t, work)
+
+	export := `[{"id":1,"scope":"ignored","key":"runner","kind":"fact","text":"uses pnpm","evidence":"user","created":5,"supersedes":9}]`
+	file := filepath.Join(home, "backup.json")
+	if err := os.WriteFile(file, []byte(export), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	// Dry run writes nothing but reports what would happen.
+	code, out, stderr := callImport(t, "import", file, "--dry-run")
+	if code != 0 {
+		t.Fatalf("dry run: %d %s", code, stderr)
+	}
+	if got := decodeSummary(t, out); got.Inserted != 1 || !got.DryRun {
+		t.Fatalf("dry run summary %+v", got)
+	}
+
+	// Real import inserts.
+	code, out, stderr = callImport(t, "import", file)
+	if code != 0 {
+		t.Fatalf("import: %d %s", code, stderr)
+	}
+	if got := decodeSummary(t, out); got.Inserted != 1 || got.DryRun {
+		t.Fatalf("import summary %+v", got)
+	}
+
+	// Re-import with the default error policy conflicts and writes a diagnostic,
+	// no success JSON.
+	code, out, stderr = callImport(t, "import", file)
+	if code == 0 || strings.TrimSpace(out) != "" {
+		t.Fatalf("conflict should fail without output: %d %q", code, out)
+	}
+	if stderr == "" {
+		t.Fatal("expected a diagnostic")
+	}
+
+	// skip leaves it untouched.
+	code, out, _ = callImport(t, "import", file, "--on-conflict", "skip")
+	if code != 0 {
+		t.Fatalf("skip: %d", code)
+	}
+	if got := decodeSummary(t, out); got.Skipped != 1 {
+		t.Fatalf("skip summary %+v", got)
+	}
+}
+
+func TestMemoryImportArgErrors(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	chdirTemp(t, t.TempDir())
+	file := filepath.Join(home, "backup.json")
+	if err := os.WriteFile(file, []byte("[]"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cases := [][]string{
+		{"import"},                                     // missing filename
+		{"import", file, "extra"},                      // extra positional
+		{"import", file, "--bogus"},                    // unknown flag
+		{"import", file, "--on-conflict"},              // missing value
+		{"import", file, "--on-conflict", "--dry-run"}, // missing value (next is a flag)
+		{"import", file, "--on-conflict", "nope"},      // invalid policy
+	}
+	for _, argv := range cases {
+		if code, _, _ := callImport(t, argv...); code != 2 {
+			t.Fatalf("argv %v: want exit 2, got %d", argv, code)
+		}
+	}
+}
+
+func TestMemoryImportFileTooLarge(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	chdirTemp(t, t.TempDir())
+	file := filepath.Join(home, "big.json")
+	big := make([]byte, maxImportFileBytes+1)
+	for i := range big {
+		big[i] = ' '
+	}
+	if err := os.WriteFile(file, big, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if code, out, _ := callImport(t, "import", file); code != 1 || out != "" {
+		t.Fatalf("oversized file: code %d out %q", code, out)
+	}
+}
+
+func decodeSummary(t *testing.T, out string) struct {
+	Inserted int  `json:"inserted"`
+	Replaced int  `json:"replaced"`
+	Skipped  int  `json:"skipped"`
+	DryRun   bool `json:"dry_run"`
+} {
+	t.Helper()
+	var got struct {
+		Inserted int  `json:"inserted"`
+		Replaced int  `json:"replaced"`
+		Skipped  int  `json:"skipped"`
+		DryRun   bool `json:"dry_run"`
+	}
+	if err := json.Unmarshal([]byte(strings.TrimSpace(out)), &got); err != nil {
+		t.Fatalf("summary %q: %v", out, err)
+	}
+	return got
+}
diff --git a/internal/memory/import.go b/internal/memory/import.go
new file mode 100644
index 0000000..82001c7
--- /dev/null
+++ b/internal/memory/import.go
@@ -0,0 +1,300 @@
+package memory
+
+import (
+	"bytes"
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+// ImportConflictPolicy decides what import does with a key that already has an
+// active record in the destination scope.
+const (
+	ConflictError   = "error"
+	ConflictSkip    = "skip"
+	ConflictReplace = "replace"
+)
+
+// maxImportRecords bounds how many history rows one import may carry.
+const maxImportRecords = 1000
+
+// ImportResult reports, per selected current key (not per historical row), how
+// an import changed the destination scope. A dry run reports the same counts it
+// would have produced.
+type ImportResult struct {
+	Inserted int `json:"inserted"`
+	Replaced int `json:"replaced"`
+	Skipped  int `json:"skipped"`
+}
+
+// Import ingests an exported memory array into one destination scope.
+//
+// data must be exactly one JSON array in the export format. The export carries
+// correction history; Import validates every record, then writes only the
+// largest-input-ID record per key as that key's current version. Imported
+// scope, created, and supersedes are never trusted as destination identity or
+// lineage: records land in the given scope with fresh ids and creation times,
+// their expiry preserved, and supersedes relinked to the previous destination
+// record. The whole selected batch applies in one transaction; a dry run runs
+// the same validation and conflict analysis but writes nothing.
+func (s *Store) Import(ctx context.Context, scope, projectRoot, policy string, dryRun bool, data []byte) (ImportResult, error) {
+	switch policy {
+	case ConflictError, ConflictSkip, ConflictReplace:
+	default:
+		return ImportResult{}, fmt.Errorf("invalid conflict policy %q", policy)
+	}
+	if scope == "" {
+		return ImportResult{}, errors.New("destination scope is required")
+	}
+
+	records, err := decodeExport(data)
+	if err != nil {
+		return ImportResult{}, err
+	}
+
+	// Validate every record, including history, and rebind project sources.
+	seen := make(map[int64]bool, len(records))
+	for i := range records {
+		r := &records[i]
+		if r.ID <= 0 {
+			return ImportResult{}, fmt.Errorf("record %d has a non-positive id", i)
+		}
+		if seen[r.ID] {
+			return ImportResult{}, fmt.Errorf("duplicate input id %d", r.ID)
+		}
+		seen[r.ID] = true
+		if err := validateImportContent(scope, r); err != nil {
+			return ImportResult{}, err
+		}
+		if scope == GlobalPreferencesScope {
+			// Global rule already rejects any sources in validateImportContent.
+			continue
+		}
+		rebound, err := reboundSources(projectRoot, r.Sources)
+		if err != nil {
+			return ImportResult{}, err
+		}
+		r.Sources = rebound
+	}
+
+	// Choose the largest input id per key as its current version.
+	selectedIdx := make(map[string]int)
+	for i := range records {
+		key := records[i].Key
+		if j, ok := selectedIdx[key]; !ok || records[i].ID > records[j].ID {
+			selectedIdx[key] = i
+		}
+	}
+	selected := make([]*Record, 0, len(selectedIdx))
+	for _, i := range selectedIdx {
+		selected = append(selected, &records[i])
+	}
+	// Deterministic order so diagnostics and ids are stable.
+	sortRecordsByID(selected)
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return ImportResult{}, err
+	}
+	defer rollback(tx)
+
+	var result ImportResult
+	now := time.Now().Unix()
+	for _, r := range selected {
+		var previous int64
+		err := tx.QueryRowContext(ctx, `SELECT id FROM memories WHERE scope=? AND key=? AND active=1`, scope, r.Key).Scan(&previous)
+		if err != nil && !errors.Is(err, sql.ErrNoRows) {
+			return ImportResult{}, err
+		}
+		conflict := !errors.Is(err, sql.ErrNoRows)
+		switch {
+		case conflict && policy == ConflictError:
+			return ImportResult{}, fmt.Errorf("memory key %q already exists in the destination scope", r.Key)
+		case conflict && policy == ConflictSkip:
+			result.Skipped++
+			continue
+		case conflict: // replace
+			result.Replaced++
+		default:
+			result.Inserted++
+		}
+		if dryRun {
+			continue
+		}
+		if conflict {
+			if _, err := tx.ExecContext(ctx, `UPDATE memories SET active=0 WHERE scope=? AND key=? AND active=1`, scope, r.Key); err != nil {
+				return ImportResult{}, err
+			}
+		}
+		res, err := tx.ExecContext(ctx, `INSERT INTO memories(scope,key,kind,text,evidence,created,expires,supersedes) VALUES(?,?,?,?,?,?,?,?)`, scope, r.Key, r.Kind, r.Text, r.Evidence, now, r.Expires, previous)
+		if err != nil {
+			return ImportResult{}, err
+		}
+		id, err := res.LastInsertId()
+		if err != nil {
+			return ImportResult{}, err
+		}
+		if _, err := tx.ExecContext(ctx, `INSERT INTO memory_search(rowid,text,evidence) VALUES(?,?,?)`, id, r.Key+"\n"+r.Text, r.Evidence); err != nil {
+			return ImportResult{}, err
+		}
+		if len(r.Sources) > 0 {
+			raw, err := json.Marshal(r.Sources)
+			if err != nil {
+				return ImportResult{}, err
+			}
+			if _, err := tx.ExecContext(ctx, `INSERT INTO memory_sources(memory_id,sources) VALUES(?,?)`, id, string(raw)); err != nil {
+				return ImportResult{}, err
+			}
+		}
+	}
+
+	if dryRun {
+		// Nothing was written; the deferred rollback discards the read view.
+		return result, nil
+	}
+	if err := tx.Commit(); err != nil {
+		return ImportResult{}, err
+	}
+	return result, nil
+}
+
+// decodeExport reads exactly one JSON array in the export format. It rejects
+// malformed JSON, non-array or null input, unknown record or source fields,
+// trailing JSON after the array, and arrays longer than maxImportRecords.
+func decodeExport(data []byte) ([]Record, error) {
+	trimmed := bytes.TrimLeft(data, " \t\r\n")
+	if len(trimmed) == 0 || trimmed[0] != '[' {
+		return nil, errors.New("import input must be a JSON array")
+	}
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.DisallowUnknownFields()
+	var records []Record
+	if err := dec.Decode(&records); err != nil {
+		return nil, fmt.Errorf("invalid import JSON: %w", err)
+	}
+	if _, err := dec.Token(); !errors.Is(err, io.EOF) {
+		return nil, errors.New("import input has trailing data after the JSON array")
+	}
+	if records == nil {
+		return nil, errors.New("import input must be a JSON array")
+	}
+	if len(records) > maxImportRecords {
+		return nil, fmt.Errorf("import exceeds %d records", maxImportRecords)
+	}
+	return records, nil
+}
+
+// validateImportContent enforces the same field, kind, and scope limits Put
+// applies, treating scope as the destination scope rather than the input's.
+func validateImportContent(scope string, r *Record) error {
+	if strings.TrimSpace(r.Key) == "" || strings.TrimSpace(r.Text) == "" || strings.TrimSpace(r.Evidence) == "" {
+		return errors.New("import record is missing key, text, or evidence")
+	}
+	if len(r.Key) > 256 || len(r.Text) > 8192 || len(r.Evidence) > 2048 {
+		return errors.New("import record exceeds field limits")
+	}
+	switch r.Kind {
+	case "preference", "fact", "procedure", "observation":
+	default:
+		return errors.New("import record has an invalid kind")
+	}
+	if r.Expires < 0 {
+		return errors.New("import record has a negative expiry")
+	}
+	if scope == GlobalPreferencesScope && (r.Kind != "preference" || len(r.Sources) != 0) {
+		return errors.New("global import accepts preferences without project file sources only")
+	}
+	if len(r.Sources) > 8 {
+		return errors.New("import record binds more than eight source files")
+	}
+	return nil
+}
+
+// reboundSources rebinds each imported source's original root-relative path into
+// the destination project root and validates it against the destination file.
+// Original machine paths are never read; only the destination copy is hashed.
+func reboundSources(projectRoot string, sources []Source) ([]Source, error) {
+	if len(sources) == 0 {
+		return sources, nil
+	}
+	if projectRoot == "" {
+		return nil, errors.New("project root is required to import source-bound records")
+	}
+	canonical, err := filepath.EvalSymlinks(projectRoot)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]Source, 0, len(sources))
+	for _, src := range sources {
+		if !isLowerHexSHA256(src.SHA256) {
+			return nil, errors.New("import source has an invalid sha256")
+		}
+		rel, err := rootRelative(src.Root, src.Path)
+		if err != nil {
+			return nil, err
+		}
+		dest := filepath.Join(canonical, rel)
+		digest, err := sourceDigest(canonical, dest)
+		if err != nil {
+			return nil, fmt.Errorf("import source %s: %w", rel, err)
+		}
+		if digest != src.SHA256 {
+			return nil, fmt.Errorf("import source %s does not match the destination file", rel)
+		}
+		out = append(out, Source{Root: canonical, Path: dest, SHA256: digest})
+	}
+	return out, nil
+}
+
+// rootRelative resolves an imported source to a path relative to its original
+// root. The original root must be absolute but need not exist here. An absolute
+// source path is valid only when lexically contained in that root; a relative
+// one is interpreted under it. The result never escapes the root.
+func rootRelative(root, path string) (string, error) {
+	if !filepath.IsAbs(root) {
+		return "", errors.New("import source root must be absolute")
+	}
+	rel := path
+	if filepath.IsAbs(path) {
+		r, err := filepath.Rel(root, path)
+		if err != nil {
+			return "", errors.New("import source path is outside its root")
+		}
+		rel = r
+	}
+	rel = filepath.Clean(rel)
+	if rel == "." || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) || filepath.IsAbs(rel) {
+		return "", errors.New("import source path escapes its root")
+	}
+	return rel, nil
+}
+
+// isLowerHexSHA256 reports whether s is a 64-character lowercase hex digest, the
+// exact form sourceDigest emits.
+func isLowerHexSHA256(s string) bool {
+	if len(s) != 64 {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+			return false
+		}
+	}
+	return true
+}
+
+// sortRecordsByID orders selected records by their input id for stable output.
+func sortRecordsByID(records []*Record) {
+	for i := 1; i < len(records); i++ {
+		for j := i; j > 0 && records[j-1].ID > records[j].ID; j-- {
+			records[j-1], records[j] = records[j], records[j-1]
+		}
+	}
+}
