+func TestImportConflictPolicies(t *testing.T) {
+	data := makeExport(t, func(put func(Record) int64) {
+		put(Record{Key: "runner", Kind: "preference", Text: "imported", Evidence: "e"})
+		put(Record{Key: "fresh", Kind: "fact", Text: "new", Evidence: "e"})
+	})
+	records, err := DecodeExport(data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := context.Background()
+
+	seed := func() *Store {
+		s := openStore(t)
+		if _, err := s.Put(ctx, Record{Scope: "dest", Key: "runner", Kind: "preference", Text: "local v1", Evidence: "e"}); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := s.Put(ctx, Record{Scope: "dest", Key: "runner", Kind: "preference", Text: "local v2", Evidence: "e"}); err != nil {
+			t.Fatal(err)
+		}
+		return s
+	}
+
+	// error: the whole batch is rejected and nothing changes, including the
+	// non-conflicting "fresh" key.
+	s := seed()
+	if _, err := s.Import(ctx, "dest", "", records, ConflictError, false); err == nil {
+		t.Fatal("error policy accepted a conflict")
+	}
+	if got, _ := s.Search(ctx, "dest", "fresh", 5); len(got) != 0 {
+		t.Fatalf("error policy left a partial write: %+v", got)
+	}
+	if got, _ := s.Search(ctx, "dest", "runner", 5); len(got) != 1 || got[0].Text != "local v2" {
+		t.Fatalf("error policy changed the existing key: %+v", got)
+	}
+
+	// skip: existing untouched, non-conflicting inserted.
+	s = seed()
+	res, err := s.Import(ctx, "dest", "", records, ConflictSkip, false)
+	if err != nil || res != (ImportResult{Inserted: 1, Skipped: 1}) {
+		t.Fatalf("skip result = %+v %v", res, err)
+	}
+	if got, _ := s.Search(ctx, "dest", "runner", 5); len(got) != 1 || got[0].Text != "local v2" {
+		t.Fatalf("skip changed existing: %+v", got)
+	}
+	if got, _ := s.Search(ctx, "dest", "fresh", 5); len(got) != 1 {
+		t.Fatalf("skip did not insert fresh: %+v", got)
+	}
+
+	// replace: existing superseded, local history preserved.
+	s = seed()
+	res, err = s.Import(ctx, "dest", "", records, ConflictReplace, false)
+	if err != nil || res != (ImportResult{Inserted: 1, Replaced: 1}) {
+		t.Fatalf("replace result = %+v %v", res, err)
+	}
+	got, err := s.Search(ctx, "dest", "runner", 5)
+	if err != nil || len(got) != 1 || got[0].Text != "imported" {
+		t.Fatalf("replace current: %+v %v", got, err)
+	}
+	if got[0].Supersedes == 0 {
+		t.Fatal("replace did not link supersedes to the previous destination record")
+	}
+	// The local corrections remain for inspection and restore.
+	exported, err := s.Export(ctx, "dest")
+	if err != nil || !strings.Contains(string(exported), "local v1") || !strings.Contains(string(exported), "local v2") {
+		t.Fatalf("replace discarded local history: %v\n%s", err, exported)
+	}
+}
