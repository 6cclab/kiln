+// readImportInput reads the import, bounding the read before allocation. A
+// filename of "-" reads stdin; a regular file is rejected if it is too large
+// or not a regular file.
+func readImportInput(file string, stdin io.Reader) ([]byte, error) {
+	if file == "-" {
+		return readLimited(stdin)
+	}
+	info, err := os.Stat(file)
+	if err != nil {
+		return nil, err
+	}
+	if !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("import file %s is not a regular file", file)
+	}
+	if info.Size() > memory.MaxImportBytes {
+		return nil, fmt.Errorf("import file %s is larger than %d bytes", file, memory.MaxImportBytes)
+	}
+	f, err := os.Open(file)
+	if err != nil {
+		return nil, err
+	}
+	defer diag.Close(f)
+	return readLimited(f)
+}
+
+func readLimited(r io.Reader) ([]byte, error) {
+	data, err := io.ReadAll(io.LimitReader(r, memory.MaxImportBytes+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(data) > memory.MaxImportBytes {
+		return nil, fmt.Errorf("import is larger than %d bytes", memory.MaxImportBytes)
+	}
+	return data, nil
+}
