diff --git a/internal/memory/import.go b/internal/memory/import.go
new file mode 100644
index 0000000..cb78db1
--- /dev/null
+++ b/internal/memory/import.go
@@ -0,0 +1,235 @@
+package memory
+
+import (
+	"bytes"
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"sort"
+	"strings"
+	"time"
+)
+
+// Import limits. The byte cap bounds reading before allocation; the record
+// cap bounds work after a well-formed array is in hand.
+const (
+	// MaxImportBytes bounds reading an import before allocation.
+	MaxImportBytes   = 4 << 20
+	maxImportRecords = 1000
+)
+
+// ImportPolicy decides what happens when an imported key already has an active
+// record in the destination scope.
+type ImportPolicy string
+
+const (
+	// ConflictError rejects the whole batch if any key already exists.
+	ConflictError ImportPolicy = "error"
+	// ConflictSkip leaves an existing key untouched and imports the rest.
+	ConflictSkip ImportPolicy = "skip"
+	// ConflictReplace supersedes an existing key, preserving its local history.
+	ConflictReplace ImportPolicy = "replace"
+)
+
+// ParseImportPolicy validates a policy name from the command line.
+func ParseImportPolicy(s string) (ImportPolicy, error) {
+	switch ImportPolicy(s) {
+	case ConflictError, ConflictSkip, ConflictReplace:
+		return ImportPolicy(s), nil
+	default:
+		return "", fmt.Errorf("invalid conflict policy %q (want error, skip or replace)", s)
+	}
+}
+
+// ImportResult reports how the selected current keys were applied. For a dry
+// run the counts describe what would happen.
+type ImportResult struct {
+	Inserted int  `json:"inserted"`
+	Replaced int  `json:"replaced"`
+	Skipped  int  `json:"skipped"`
+	DryRun   bool `json:"dry_run"`
+}
+
+// DecodeExport parses exactly one JSON array in the kiln memory export format.
+// It rejects oversize input, malformed or trailing JSON, non-array or null
+// input, unknown record or source fields, and more than maxImportRecords
+// records. An empty array is valid.
+func DecodeExport(data []byte) ([]Record, error) {
+	if len(data) > MaxImportBytes {
+		return nil, fmt.Errorf("import is larger than %d bytes", MaxImportBytes)
+	}
+	// Reject null and non-array scalars/objects up front: a bare `null`
+	// decodes into a nil slice without error otherwise.
+	trimmed := bytes.TrimLeft(data, " \t\r\n")
+	if len(trimmed) == 0 || trimmed[0] != '[' {
+		return nil, errors.New("import must be a JSON array")
+	}
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.DisallowUnknownFields()
+	records := []Record{}
+	if err := dec.Decode(&records); err != nil {
+		return nil, fmt.Errorf("import is not a valid memory export: %w", err)
+	}
+	var extra json.RawMessage
+	if err := dec.Decode(&extra); err != io.EOF {
+		return nil, errors.New("import has trailing data after the JSON array")
+	}
+	if len(records) > maxImportRecords {
+		return nil, fmt.Errorf("import has more than %d records", maxImportRecords)
+	}
+	return records, nil
+}
+
+// validateImportRecord checks one record against the same field and kind
+// limits Put enforces, without trusting its scope, created or supersedes.
+func validateImportRecord(r Record) error {
+	if strings.TrimSpace(r.Key) == "" || strings.TrimSpace(r.Text) == "" || strings.TrimSpace(r.Evidence) == "" {
+		return errors.New("key, text and evidence are required")
+	}
+	if len(r.Key) > 256 || len(r.Text) > 8192 || len(r.Evidence) > 2048 {
+		return errors.New("record exceeds field limits")
+	}
+	switch r.Kind {
+	case "preference", "fact", "procedure", "observation":
+	default:
+		return errors.New("invalid memory kind")
+	}
+	if r.Expires < 0 {
+		return errors.New("expiry must be nonnegative")
+	}
+	return nil
+}
+
+// Import validates an exported history and applies the selected current
+// version of each key into scope, in a single transaction. destRoot is the
+// canonical current project root used to rebind and verify file sources; it
+// is ignored for the global preferences scope, which never carries sources.
+//
+// Every record is validated, including historical ones: a stale or
+// source-bearing record anywhere in a global import, or an unresolvable file
+// source anywhere in a project import, rejects the whole batch. The current
+// version of each key is the one with the largest input ID. A dry run runs the
+// identical validation and conflict analysis but writes nothing.
+func (s *Store) Import(ctx context.Context, scope, destRoot string, records []Record, policy ImportPolicy, dryRun bool) (ImportResult, error) {
+	var result ImportResult
+	result.DryRun = dryRun
+	if scope == "" {
+		return result, errors.New("destination scope is required")
+	}
+	if _, err := ParseImportPolicy(string(policy)); err != nil {
+		return result, err
+	}
+	global := scope == GlobalPreferencesScope
+
+	// Validate every record and rebind its sources before touching the
+	// database, so a validation failure cannot leave a partial write.
+	ids := make(map[int64]struct{}, len(records))
+	rebound := make([][]Source, len(records))
+	selected := map[string]int{} // key -> index of its current (largest-ID) record
+	for i, r := range records {
+		if r.ID <= 0 {
+			return result, fmt.Errorf("record #%d has a non-positive id", i+1)
+		}
+		if _, dup := ids[r.ID]; dup {
+			return result, fmt.Errorf("record #%d repeats id %d", i+1, r.ID)
+		}
+		ids[r.ID] = struct{}{}
+		if err := validateImportRecord(r); err != nil {
+			return result, fmt.Errorf("record id %d: %w", r.ID, err)
+		}
+		if global {
+			if r.Kind != "preference" || len(r.Sources) != 0 {
+				return result, fmt.Errorf("record id %d: global import accepts preferences without sources only", r.ID)
+			}
+		} else if len(r.Sources) > 0 {
+			if len(r.Sources) > 8 {
+				return result, fmt.Errorf("record id %d: at most eight memory source files are allowed", r.ID)
+			}
+			bound := make([]Source, 0, len(r.Sources))
+			for _, src := range r.Sources {
+				dst, err := RebindSource(destRoot, src)
+				if err != nil {
+					return result, fmt.Errorf("record id %d: %w", r.ID, err)
+				}
+				bound = append(bound, dst)
+			}
+			rebound[i] = bound
+		}
+		if cur, ok := selected[r.Key]; !ok || r.ID > records[cur].ID {
+			selected[r.Key] = i
+		}
+	}
+
+	// Stable order so counts and any error are deterministic.
+	keys := make([]string, 0, len(selected))
+	for k := range selected {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return result, err
+	}
+	defer rollback(tx)
+	now := time.Now().Unix()
+	for _, key := range keys {
+		idx := selected[key]
+		r := records[idx]
+		var previous int64
+		err := tx.QueryRowContext(ctx, `SELECT id FROM memories WHERE scope=? AND key=? AND active=1`, scope, key).Scan(&previous)
+		if err != nil && err != sql.ErrNoRows {
+			return ImportResult{DryRun: dryRun}, err
+		}
+		conflict := err == nil
+		if conflict {
+			switch policy {
+			case ConflictError:
+				return ImportResult{DryRun: dryRun}, fmt.Errorf("key %q already exists in the destination scope", key)
+			case ConflictSkip:
+				result.Skipped++
+				continue
+			}
+		}
+		if conflict {
+			result.Replaced++
+		} else {
+			result.Inserted++
+		}
+		if _, err := tx.ExecContext(ctx, `UPDATE memories SET active=0 WHERE scope=? AND key=? AND active=1`, scope, key); err != nil {
+			return ImportResult{DryRun: dryRun}, err
+		}
+		res, err := tx.ExecContext(ctx, `INSERT INTO memories(scope,key,kind,text,evidence,created,expires,supersedes) VALUES(?,?,?,?,?,?,?,?)`, scope, key, r.Kind, r.Text, r.Evidence, now, r.Expires, previous)
+		if err != nil {
+			return ImportResult{DryRun: dryRun}, err
+		}
+		id, err := res.LastInsertId()
+		if err != nil {
+			return ImportResult{DryRun: dryRun}, err
+		}
+		if _, err := tx.ExecContext(ctx, `INSERT INTO memory_search(rowid,text,evidence) VALUES(?,?,?)`, id, key+"\n"+r.Text, r.Evidence); err != nil {
+			return ImportResult{DryRun: dryRun}, err
+		}
+		if srcs := rebound[idx]; len(srcs) > 0 {
+			raw, err := json.Marshal(srcs)
+			if err != nil {
+				return ImportResult{DryRun: dryRun}, err
+			}
+			if _, err := tx.ExecContext(ctx, `INSERT INTO memory_sources(memory_id,sources) VALUES(?,?)`, id, string(raw)); err != nil {
+				return ImportResult{DryRun: dryRun}, err
+			}
+		}
+	}
+	if dryRun {
+		// Roll back every write; the validation and counts above already
+		// described what a real import would do.
+		return result, nil
+	}
+	if err := tx.Commit(); err != nil {
+		return ImportResult{DryRun: dryRun}, err
+	}
+	return result, nil
+}
