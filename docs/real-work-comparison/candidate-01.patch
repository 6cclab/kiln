+// makeExport builds records in one scope and returns their export bytes,
+// simulating a transfer from another project or machine.
+func makeExport(t *testing.T, puts func(put func(Record) int64)) []byte {
+	t.Helper()
+	src := openStore(t)
+	ctx := context.Background()
+	put := func(r Record) int64 {
+		r.Scope = "origin"
+		id, err := src.Put(ctx, r)
+		if err != nil {
+			t.Fatalf("put: %v", err)
+		}
+		return id
+	}
+	puts(put)
+	data, err := src.Export(ctx, "origin")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return data
+}
