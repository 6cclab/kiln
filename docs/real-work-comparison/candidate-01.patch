+func TestImportExpiryPreservedAndCreationRefreshed(t *testing.T) {
+	future := time.Now().Add(time.Hour).Unix()
+	rec := Record{ID: 7, Key: "k", Kind: "fact", Text: "t", Evidence: "e", Created: 1, Expires: future, Supersedes: 99}
