+	if err != nil || got == nil {
+		t.Fatalf("current: %+v %v", got, err)
+	}
+	if got.Expires != future {
+		t.Fatalf("expiry not preserved: %d", got.Expires)
+	}
+	if got.ID == 7 || got.Created == 1 || got.Supersedes == 99 {
+		t.Fatalf("imported identity/lineage trusted: %+v", got)
+	}
+}
