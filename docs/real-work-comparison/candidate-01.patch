+// RebindSource re-roots an exported source into destCanonical (an already
+// canonical destination project root) and validates it against the file that
+// now occupies that relative path. The original root must be absolute but is
+// never touched on disk: an absolute source path is accepted only when
+// lexically contained in that root, a relative one is interpreted under it,
+// and either way an escaping path is rejected. The returned binding records
+// the destination root and path and the freshly computed digest, which must
+// equal the recorded SHA-256.
+func RebindSource(destCanonical string, src Source) (Source, error) {
+	if !isHexDigest(src.SHA256) {
+		return Source{}, fmt.Errorf("memory source hash is not a SHA-256 digest")
+	}
+	if !filepath.IsAbs(src.Root) {
+		return Source{}, fmt.Errorf("memory source root must be absolute")
+	}
+	var rel string
+	if filepath.IsAbs(src.Path) {
+		r, err := filepath.Rel(src.Root, src.Path)
+		if err != nil {
+			return Source{}, fmt.Errorf("memory source is outside its root")
+		}
+		rel = r
+	} else {
+		rel = src.Path
+	}
+	rel = filepath.Clean(rel)
+	if rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) || filepath.IsAbs(rel) {
+		return Source{}, fmt.Errorf("memory source path escapes its root")
+	}
+	destPath := filepath.Join(destCanonical, rel)
+	digest, err := sourceDigest(destCanonical, destPath)
+	if err != nil {
+		return Source{}, err
+	}
+	if digest != src.SHA256 {
+		return Source{}, fmt.Errorf("memory source no longer matches its recorded contents")
+	}
+	return Source{Root: destCanonical, Path: destPath, SHA256: digest}, nil
+}
+
+func isHexDigest(s string) bool {
+	if len(s) != 64 {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+			return false
+		}
+	}
+	return true
+}
