+func TestImportProjectSourceRebindAndRejection(t *testing.T) {
+	origin := canonicalTemp(t)
+	if err := os.WriteFile(filepath.Join(origin, "config"), []byte("content"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	sources, err := CaptureSources(origin, []string{"config"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	rec := Record{ID: 1, Key: "cfg", Kind: "fact", Text: "uses config", Evidence: "config", Sources: sources}
+	ctx := context.Background()
+
+	// Destination worktree with matching content: rebind and import succeed.
+	dest := canonicalTemp(t)
+	if err := os.WriteFile(filepath.Join(dest, "config"), []byte("content"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	s := openStore(t)
+	if res, err := s.Import(ctx, "dest", dest, []Record{rec}, ConflictError, false); err != nil || res.Inserted != 1 {
+		t.Fatalf("source rebind import: %+v %v", res, err)
+	}
+	got, err := s.Current(ctx, "dest", "cfg", dest)
+	if err != nil || got == nil || len(got.Sources) != 1 || got.Sources[0].Root != dest {
+		t.Fatalf("stored binding not rebound to destination: %+v %v", got, err)
+	}
+
+	// Changed destination file: rejected.
+	dest2 := canonicalTemp(t)
+	if err := os.WriteFile(filepath.Join(dest2, "config"), []byte("different"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := openStore(t).Import(ctx, "dest", dest2, []Record{rec}, ConflictError, false); err == nil {
+		t.Fatal("changed source accepted")
+	}
+
+	// Missing destination file: rejected.
+	if _, err := openStore(t).Import(ctx, "dest", canonicalTemp(t), []Record{rec}, ConflictError, false); err == nil {
+		t.Fatal("missing source accepted")
+	}
+
+	// Escaping absolute path not contained in its root: rejected.
+	escape := Record{ID: 1, Key: "cfg", Kind: "fact", Text: "t", Evidence: "e", Sources: []Source{{Root: "/abs/root", Path: "/etc/passwd", SHA256: strings.Repeat("a", 64)}}}
+	if _, err := openStore(t).Import(ctx, "dest", dest, []Record{escape}, ConflictError, false); err == nil {
+		t.Fatal("escaping source path accepted")
+	}
+
+	// A stale source on a historical (non-selected) record also rejects.
+	stale := []Record{
+		{ID: 1, Key: "cfg", Kind: "fact", Text: "old", Evidence: "e", Sources: []Source{{Root: origin, Path: filepath.Join(origin, "config"), SHA256: strings.Repeat("b", 64)}}},
+		{ID: 2, Key: "cfg", Kind: "fact", Text: "new", Evidence: "e"},
+	}
+	if _, err := openStore(t).Import(ctx, "dest", dest, stale, ConflictError, false); err == nil {
+		t.Fatal("stale historical source accepted")
+	}
+}
