+func TestImportGlobalHistoricalValidationCancellationAndWriteRollback(t *testing.T) {
+	s := importStore(t)
+	ctx := context.Background()
+	preference := importRecord(2, "style", "concise")
+	preference.Kind = "preference"
+	fact := importRecord(1, "style", "historical fact")
+	if _, err := s.Import(ctx, GlobalPreferencesScope, "", importJSON(t, fact, preference), "error", false); err == nil {
+		t.Fatal("historical global fact accepted")
+	}
+	fact.Kind = "preference"
+	fact.Sources = []Source{{Root: "/old", Path: "x", SHA256: strings.Repeat("0", 64)}}
+	if _, err := s.Import(ctx, GlobalPreferencesScope, "", importJSON(t, fact, preference), "error", false); err == nil {
+		t.Fatal("historical global source accepted")
+	}
+	canceled, cancel := context.WithCancel(ctx)
+	cancel()
+	if _, err := s.Import(canceled, GlobalPreferencesScope, "", importJSON(t, preference), "error", false); err == nil {
+		t.Fatal("canceled import accepted")
+	}
+	if _, err := s.db.Exec(`CREATE TRIGGER fail_import BEFORE INSERT ON memories WHEN new.key='second' BEGIN SELECT RAISE(ABORT,'injected failure'); END`); err != nil {
+		t.Fatal(err)
+	}
+	first := importRecord(3, "first", "value")
+	second := importRecord(4, "second", "value")
+	root := t.TempDir()
+	if err := os.WriteFile(filepath.Join(root, "source"), []byte("source"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	hash := sha256.Sum256([]byte("source"))
+	first.Sources = []Source{{Root: "/old", Path: "source", SHA256: hex.EncodeToString(hash[:])}}
+	if _, err := s.Import(ctx, "destination", root, importJSON(t, first, second), "error", false); err == nil {
+		t.Fatal("injected write failure accepted")
+	}
+	for _, table := range []string{"memories", "memory_search", "memory_sources"} {
+		var count int
+		if err := s.db.QueryRow(`SELECT count(*) FROM ` + table).Scan(&count); err != nil || count != 0 {
+			t.Fatalf("%s changed after rollback: %d %v", table, count, err)
+		}
+	}
+	localID, err := s.Put(ctx, Record{Scope: "destination", Key: "first", Kind: "fact", Text: "local value", Evidence: "user"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.Import(ctx, "destination", root, importJSON(t, first, second), "replace", false); err == nil {
+		t.Fatal("injected replacement failure accepted")
+	}
+	var activeID int64
+	if err := s.db.QueryRow(`SELECT id FROM memories WHERE scope='destination' AND key='first' AND active=1`).Scan(&activeID); err != nil || activeID != localID {
+		t.Fatalf("local correction changed after rollback: %d %v", activeID, err)
+	}
+	if _, err := s.Import(ctx, GlobalPreferencesScope, "", importJSON(t, preference), "error", false); err != nil {
+		t.Fatal(err)
+	}
+	current, err := s.Current(ctx, GlobalPreferencesScope, "style", "")
+	if err != nil || current == nil || current.Created < time.Now().Add(-time.Minute).Unix() {
+		t.Fatalf("global current: %+v %v", current, err)
+	}
+}
