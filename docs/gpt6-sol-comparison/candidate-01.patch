diff --git a/internal/memory/import.go b/internal/memory/import.go
new file mode 100644
index 0000000..f731f62
--- /dev/null
+++ b/internal/memory/import.go
@@ -0,0 +1,207 @@
+package memory
+
+import (
+	"bytes"
+	"context"
+	"database/sql"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+)
+
+// ImportCounts describes the current keys affected by an import.
+type ImportCounts struct {
+	Inserted int  `json:"inserted"`
+	Replaced int  `json:"replaced"`
+	Skipped  int  `json:"skipped"`
+	DryRun   bool `json:"dry_run"`
+}
+
+// Import validates every exported version, then imports only the highest-ID
+// version of each key. All conflict decisions and writes share one transaction.
+func (s *Store) Import(ctx context.Context, scope, projectRoot string, data []byte, policy string, dryRun bool) (ImportCounts, error) {
+	counts := ImportCounts{DryRun: dryRun}
+	if scope == "" || (policy != "error" && policy != "skip" && policy != "replace") {
+		return counts, errors.New("invalid import scope or conflict policy")
+	}
+	if len(data) > 4<<20 {
+		return counts, errors.New("memory import exceeds 4 MiB")
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	var records []Record
+	if err := decoder.Decode(&records); err != nil || records == nil {
+		return counts, errors.New("memory import requires a JSON array of export records")
+	}
+	var extra any
+	if err := decoder.Decode(&extra); err != io.EOF {
+		return counts, errors.New("memory import contains trailing JSON")
+	}
+	if len(records) > 1000 {
+		return counts, errors.New("memory import exceeds 1000 records")
+	}
+	selected := make(map[string]Record)
+	seen := make(map[int64]bool)
+	for _, r := range records {
+		if err := ctx.Err(); err != nil {
+			return counts, err
+		}
+		if r.ID <= 0 || seen[r.ID] {
+			return counts, errors.New("memory import has invalid or duplicate IDs")
+		}
+		seen[r.ID] = true
+		if r.Scope == "" || strings.TrimSpace(r.Key) == "" || strings.TrimSpace(r.Text) == "" || strings.TrimSpace(r.Evidence) == "" || len(r.Key) > 256 || len(r.Text) > 8192 || len(r.Evidence) > 2048 || r.Expires < 0 {
+			return counts, errors.New("memory import has invalid record fields")
+		}
+		switch r.Kind {
+		case "preference", "fact", "procedure", "observation":
+		default:
+			return counts, errors.New("memory import has invalid kind")
+		}
+		if r.Scope == GlobalPreferencesScope && (r.Kind != "preference" || len(r.Sources) != 0) {
+			return counts, errors.New("memory import has invalid global record")
+		}
+		if scope == GlobalPreferencesScope {
+			if r.Kind != "preference" || len(r.Sources) != 0 {
+				return counts, errors.New("global import requires preferences without sources")
+			}
+		} else {
+			if len(r.Sources) > 8 {
+				return counts, errors.New("memory import has too many source files")
+			}
+			for i, source := range r.Sources {
+				if err := ctx.Err(); err != nil {
+					return counts, err
+				}
+				rebound, err := rebindImportSource(source, projectRoot)
+				if err != nil {
+					return counts, errors.New("memory import has invalid or stale source file")
+				}
+				r.Sources[i] = rebound
+			}
+		}
+		if old, ok := selected[r.Key]; !ok || r.ID > old.ID {
+			selected[r.Key] = r
+		}
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return counts, err
+	}
+	defer rollback(tx)
+	// The map is used only for selection. Sort keys so a failure and its
+	// diagnostic are deterministic across runs.
+	keys := make([]string, 0, len(selected))
+	for key := range selected {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	previous := make(map[string]int64, len(keys))
+	for _, key := range keys {
+		var id int64
+		err := tx.QueryRowContext(ctx, `SELECT id FROM memories WHERE scope=? AND key=? AND active=1`, scope, key).Scan(&id)
+		if err != nil && !errors.Is(err, sql.ErrNoRows) {
+			return counts, err
+		}
+		if err == nil {
+			previous[key] = id
+			if policy == "error" {
+				return counts, errors.New("memory import conflicts with an existing key")
+			}
+			if policy == "skip" {
+				counts.Skipped++
+			} else {
+				counts.Replaced++
+			}
+		} else {
+			counts.Inserted++
+		}
+	}
+	if dryRun {
+		return counts, ctx.Err()
+	}
+	for _, key := range keys {
+		id := previous[key]
+		if id != 0 && policy == "skip" {
+			continue
+		}
+		r := selected[key]
+		if id != 0 {
+			if _, err := tx.ExecContext(ctx, `UPDATE memories SET active=0 WHERE id=?`, id); err != nil {
+				return counts, err
+			}
+		}
+		res, err := tx.ExecContext(ctx, `INSERT INTO memories(scope,key,kind,text,evidence,created,expires,supersedes) VALUES(?,?,?,?,?,?,?,?)`, scope, r.Key, r.Kind, r.Text, r.Evidence, time.Now().Unix(), r.Expires, id)
+		if err != nil {
+			return counts, err
+		}
+		newID, err := res.LastInsertId()
+		if err != nil {
+			return counts, err
+		}
+		if _, err := tx.ExecContext(ctx, `INSERT INTO memory_search(rowid,text,evidence) VALUES(?,?,?)`, newID, r.Key+"\n"+r.Text, r.Evidence); err != nil {
+			return counts, err
+		}
+		if len(r.Sources) != 0 {
+			raw, err := json.Marshal(r.Sources)
+			if err != nil {
+				return counts, err
+			}
+			if _, err := tx.ExecContext(ctx, `INSERT INTO memory_sources(memory_id,sources) VALUES(?,?)`, newID, string(raw)); err != nil {
+				return counts, err
+			}
+		}
+	}
+	if err := ctx.Err(); err != nil {
+		return counts, err
+	}
+	return counts, tx.Commit()
+}
+
+func rebindImportSource(source Source, projectRoot string) (Source, error) {
+	if !filepath.IsAbs(source.Root) || source.Path == "" || len(source.SHA256) != 64 {
+		return Source{}, errors.New("invalid source")
+	}
+	if _, err := hex.DecodeString(source.SHA256); err != nil {
+		return Source{}, err
+	}
+	original := filepath.Clean(source.Root)
+	path := source.Path
+	if !filepath.IsAbs(path) {
+		path = filepath.Join(original, path)
+	}
+	rel, err := filepath.Rel(original, path)
+	if err != nil || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) || rel == "." {
+		return Source{}, errors.New("source escapes original root")
+	}
+	canonical, err := filepath.EvalSymlinks(projectRoot)
+	if err != nil {
+		return Source{}, err
+	}
+	bound := filepath.Join(canonical, rel)
+	// Inspect the resolved target before opening it so a FIFO or device
+	// cannot stall a management command during hashing.
+	resolved, err := filepath.EvalSymlinks(bound)
+	if err != nil {
+		return Source{}, err
+	}
+	resolvedRel, err := filepath.Rel(canonical, resolved)
+	if err != nil || resolvedRel == ".." || strings.HasPrefix(resolvedRel, ".."+string(filepath.Separator)) {
+		return Source{}, errors.New("source escapes destination root")
+	}
+	info, err := os.Stat(resolved)
+	if err != nil || !info.Mode().IsRegular() || info.Size() > 1<<20 {
+		return Source{}, errors.New("source is not a regular file within size limit")
+	}
+	digest, err := sourceDigest(canonical, bound)
+	if err != nil || !strings.EqualFold(digest, source.SHA256) {
+		return Source{}, errors.New("source changed or unavailable")
+	}
+	return Source{Root: canonical, Path: bound, SHA256: digest}, nil
+}
