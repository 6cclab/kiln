diff --git a/internal/cli/memory_import.go b/internal/cli/memory_import.go
new file mode 100644
index 0000000..4703190
--- /dev/null
+++ b/internal/cli/memory_import.go
@@ -0,0 +1,118 @@
+package cli
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/andrepato/harness/internal/diag"
+	"github.com/andrepato/harness/internal/memory"
+)
+
+// MemoryImport parses the import-specific flags without the chat flag parser.
+// argv begins after "memory" and may begin with "global".
+func MemoryImport(ctx context.Context, argv []string, out, stderr io.Writer) int {
+	usage := "usage: kiln memory [global] import <file> [--dry-run] [--on-conflict error|skip|replace]"
+	global := len(argv) > 0 && argv[0] == "global"
+	if global {
+		argv = argv[1:]
+	}
+	if len(argv) == 0 || argv[0] != "import" {
+		writeDiagnostic(stderr, usage)
+		return 2
+	}
+	file, policy, dryRun := "", "error", false
+	seenPolicy, seenDryRun := false, false
+	for i := 1; i < len(argv); i++ {
+		token := argv[i]
+		switch {
+		case token == "--dry-run":
+			if seenDryRun {
+				writeDiagnostic(stderr, "duplicate --dry-run")
+				return 2
+			}
+			seenDryRun, dryRun = true, true
+		case token == "--on-conflict" || strings.HasPrefix(token, "--on-conflict="):
+			if seenPolicy {
+				writeDiagnostic(stderr, "duplicate --on-conflict")
+				return 2
+			}
+			seenPolicy = true
+			if token == "--on-conflict" {
+				i++
+				if i >= len(argv) || strings.HasPrefix(argv[i], "-") {
+					writeDiagnostic(stderr, "--on-conflict requires error, skip, or replace")
+					return 2
+				}
+				policy = argv[i]
+			} else {
+				policy = strings.TrimPrefix(token, "--on-conflict=")
+			}
+			if policy != "error" && policy != "skip" && policy != "replace" {
+				writeDiagnostic(stderr, "invalid --on-conflict policy (use error, skip, or replace)")
+				return 2
+			}
+		case strings.HasPrefix(token, "-"):
+			writeDiagnostic(stderr, "unknown memory import flag")
+			return 2
+		case file == "":
+			file = token
+		default:
+			writeDiagnostic(stderr, "memory import accepts exactly one file")
+			return 2
+		}
+	}
+	if file == "" {
+		writeDiagnostic(stderr, usage)
+		return 2
+	}
+	f, err := os.Open(file)
+	if err != nil {
+		writeDiagnostic(stderr, "cannot open memory import file")
+		return 1
+	}
+	defer diag.Close(f)
+	data, err := io.ReadAll(io.LimitReader(f, (4<<20)+1))
+	if err != nil {
+		writeDiagnostic(stderr, "cannot read memory import file")
+		return 1
+	}
+	if len(data) > 4<<20 {
+		writeDiagnostic(stderr, "memory import exceeds 4 MiB")
+		return 1
+	}
+	cwd, err := os.Getwd()
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	home, err := os.UserHomeDir()
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	s, err := memory.Open(filepath.Join(home, ".kiln", "memory.db"))
+	if err != nil {
+		writeDiagnostic(stderr, "cannot open memory database")
+		return 1
+	}
+	defer diag.Close(s)
+	scope := memoryScope(cwd)
+	if global {
+		scope = memory.GlobalPreferencesScope
+	}
+	counts, err := s.Import(ctx, scope, memoryProjectRoot(cwd), data, policy, dryRun)
+	if err != nil {
+		writeDiagnostic(stderr, fmt.Errorf("memory import failed: %w", err))
+		return 1
+	}
+	if err := json.NewEncoder(out).Encode(counts); err != nil {
+		writeDiagnostic(stderr, "cannot write memory import result")
+		return 1
+	}
+	return 0
+}
