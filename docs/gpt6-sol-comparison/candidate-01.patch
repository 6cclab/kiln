@@ -0,0 +1,92 @@
+package cli
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/andrepato/harness/internal/memory"
+)
+
+func TestMemoryImportCommandFlagsAndScope(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	project := t.TempDir()
+	before, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chdir(project); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.Chdir(before) })
+	input := filepath.Join(t.TempDir(), "export.json")
+	row := memory.Record{ID: 42, Scope: "/other/machine", Key: "editor", Kind: "preference", Text: "Use vim", Evidence: "user", Created: 1}
+	raw, err := json.Marshal([]memory.Record{row})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(input, raw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	call := func(argv ...string) (int, string, string) {
+		t.Helper()
+		var out, stderr bytes.Buffer
+		code := MemoryImport(context.Background(), argv, &out, &stderr)
+		return code, out.String(), stderr.String()
+	}
+	for _, argv := range [][]string{
+		{"import"}, {"import", "--dry-run"}, {"import", input, "extra"},
+		{"import", input, "--unknown"}, {"import", input, "--on-conflict"},
+		{"import", input, "--on-conflict", "--dry-run"},
+		{"import", input, "--on-conflict=merge"},
+		{"import", input, "--dry-run=true"},
+	} {
+		code, output, diagnostic := call(argv...)
+		if code == 0 || output != "" || diagnostic == "" {
+			t.Fatalf("accepted invalid argv %v: %d %q %q", argv, code, output, diagnostic)
+		}
+	}
+	tooLarge := filepath.Join(t.TempDir(), "oversized.json")
+	if err := os.WriteFile(tooLarge, []byte(strings.Repeat(" ", (4<<20)+1)), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if code, output, diagnostic := call("import", tooLarge); code == 0 || output != "" || !strings.Contains(diagnostic, "4 MiB") {
+		t.Fatalf("oversized input: %d %q %q", code, output, diagnostic)
+	}
+	code, output, diagnostic := call("import", input, "--dry-run", "--on-conflict=replace")
+	if code != 0 || !strings.Contains(output, `"inserted":1`) || !strings.Contains(output, `"dry_run":true`) {
+		t.Fatalf("dry run: %d %q %q", code, output, diagnostic)
+	}
+	code, output, diagnostic = call("import", input)
+	if code != 0 || !strings.Contains(output, `"inserted":1`) {
+		t.Fatalf("insert: %d %q %q", code, output, diagnostic)
+	}
+	code, output, diagnostic = call("import", input)
+	if code == 0 || output != "" || strings.Contains(diagnostic, "Use vim") {
+		t.Fatalf("conflict: %d %q %q", code, output, diagnostic)
+	}
+	code, output, diagnostic = call("import", input, "--on-conflict", "skip")
+	if code != 0 || !strings.Contains(output, `"skipped":1`) {
+		t.Fatalf("skip: %d %q %q", code, output, diagnostic)
+	}
+	code, output, diagnostic = call("global", "import", input)
+	if code != 0 || !strings.Contains(output, `"inserted":1`) {
+		t.Fatalf("global import: %d %q %q", code, output, diagnostic)
+	}
+	s, err := memory.Open(filepath.Join(home, ".kiln", "memory.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	for _, scope := range []string{project, memory.GlobalPreferencesScope} {
+		got, err := s.Current(context.Background(), scope, "editor", project)
+		if err != nil || got == nil || got.Scope != scope {
+			t.Fatalf("scope %q: %+v %v", scope, got, err)
+		}
+	}
+}
