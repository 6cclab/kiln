+func TestImportRejectsInvalidRowsAndLeavesBatchUnchanged(t *testing.T) {
+	s := importStore(t)
+	good := importRecord(1, "good", "good text")
+	badKind := importRecord(2, "bad", "text")
+	badKind.Kind = "unknown"
+	badExpiry := importRecord(2, "bad", "text")
+	badExpiry.Expires = -1
+	badField := importRecord(2, "bad", "text")
+	badField.Key = strings.Repeat("a", 257)
+	cases := map[string][]byte{
+		"null":           []byte("null"),
+		"object":         []byte("{}"),
+		"malformed":      []byte("["),
+		"trailing":       []byte("[] true"),
+		"unknown":        []byte(`[{"id":1,"scope":"x","key":"a","kind":"fact","text":"x","evidence":"x","created":0,"extra":1}]`),
+		"unknown source": []byte(`[{"id":1,"scope":"x","key":"a","kind":"fact","text":"x","evidence":"x","created":0,"sources":[{"root":"/old","path":"x","sha256":"x","extra":1}]}]`),
+		"duplicate":      importJSON(t, good, good),
+		"zero ID":        importJSON(t, importRecord(0, "bad", "text")),
+		"bad kind":       importJSON(t, good, badKind),
+		"bad expiry":     importJSON(t, good, badExpiry),
+		"bad field":      importJSON(t, good, badField),
+		"too many":       importJSON(t, makeRecords(1001)...),
+		"too large":      []byte(strings.Repeat(" ", (4<<20)+1)),
+	}
+	for name, data := range cases {
+		t.Run(name, func(t *testing.T) {
+			if _, err := s.Import(context.Background(), "destination", "", data, "skip", false); err == nil {
+				t.Fatal("invalid batch accepted")
+			}
+			exported, err := s.Export(context.Background(), "destination")
+			if err != nil || string(exported) != "[]" {
+				t.Fatalf("partial import: %s %v", exported, err)
+			}
+		})
+	}
+	if got, err := s.Import(context.Background(), "destination", "", []byte("[]"), "error", false); err != nil || got.Inserted != 0 {
+		t.Fatalf("empty array: %+v %v", got, err)
+	}
+}
+
+func makeRecords(n int) []Record {
+	out := make([]Record, n)
+	for i := range out {
+		out[i] = importRecord(int64(i+1), "same", "text")
+	}
+	return out
+}
