+package memory
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func importStore(t *testing.T) *Store {
+	t.Helper()
+	s, err := Open(filepath.Join(t.TempDir(), "memory.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = s.Close() })
+	return s
+}
+
+func importJSON(t *testing.T, rows ...Record) []byte {
+	t.Helper()
+	data, err := json.Marshal(rows)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return data
+}
+
+func importRecord(id int64, key, text string) Record {
+	return Record{ID: id, Scope: "/old/project", Key: key, Kind: "fact", Text: text, Evidence: "user", Created: 1, Supersedes: 999}
+}
+
+func TestImportHistoryConflictAndDryRun(t *testing.T) {
+	s := importStore(t)
+	ctx := context.Background()
+	oldID, err := s.Put(ctx, Record{Scope: "destination", Key: "existing", Kind: "fact", Text: "local", Evidence: "user", Expires: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	input := importJSON(t, importRecord(17, "fresh", "historical"), importRecord(9, "existing", "incoming"), importRecord(18, "fresh", "current"))
+	before, _ := s.Export(ctx, "destination")
+	if _, err := s.Import(ctx, "destination", "", input, "error", false); err == nil {
+		t.Fatal("expired active key did not conflict")
+	}
+	for _, policy := range []string{"skip", "replace"} {
+		got, err := s.Import(ctx, "destination", "", input, policy, true)
+		if err != nil || !got.DryRun || got.Inserted != 1 || (policy == "skip" && (got.Skipped != 1 || got.Replaced != 0)) || (policy == "replace" && (got.Replaced != 1 || got.Skipped != 0)) {
+			t.Fatalf("dry run %s: %+v %v", policy, got, err)
+		}
+		after, _ := s.Export(ctx, "destination")
+		if string(after) != string(before) {
+			t.Fatal("dry run changed exported records")
+		}
+	}
+	got, err := s.Import(ctx, "destination", "", input, "skip", false)
+	if err != nil || got.Inserted != 1 || got.Skipped != 1 {
+		t.Fatalf("skip: %+v %v", got, err)
+	}
+	fresh, err := s.Current(ctx, "destination", "fresh", "")
+	if err != nil || fresh == nil || fresh.Text != "current" || fresh.ID == 18 || fresh.Supersedes != 0 || fresh.Created <= 1 {
+		t.Fatalf("fresh: %+v %v", fresh, err)
+	}
+	if _, err := s.Import(ctx, "destination", "", input, "replace", false); err != nil {
+		t.Fatal(err)
+	}
+	var prior, current int64
+	if err := s.db.QueryRow(`SELECT id,supersedes FROM memories WHERE scope='destination' AND key='existing' AND active=1`).Scan(&current, &prior); err != nil || prior != oldID || current == 9 {
+		t.Fatalf("replacement lineage: %d %d %v", current, prior, err)
+	}
+	var n int
+	if err := s.db.QueryRow(`SELECT count(*) FROM memories WHERE scope='destination' AND key='fresh'`).Scan(&n); err != nil || n != 2 {
+		t.Fatalf("imported history was replayed: %d %v", n, err)
+	}
+	if err := s.db.QueryRow(`SELECT count(*) FROM memory_search WHERE rowid=?`, current).Scan(&n); err != nil || n != 1 {
+		t.Fatalf("replacement search entry: %d %v", n, err)
+	}
+}
