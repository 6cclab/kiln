+func TestImportSourcesReboundAndValidatedAcrossHistory(t *testing.T) {
+	root := t.TempDir()
+	path := filepath.Join(root, "config")
+	if err := os.WriteFile(path, []byte("contents"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	digest := sha256.Sum256([]byte("contents"))
+	hash := hex.EncodeToString(digest[:])
+	original := filepath.Join(t.TempDir(), "absent")
+	s := importStore(t)
+	row := importRecord(1, "config", "file dependent")
+	row.Sources = []Source{{Root: original, Path: "config", SHA256: hash}}
+	got, err := s.Import(context.Background(), "destination", root, importJSON(t, row), "error", false)
+	if err != nil || got.Inserted != 1 {
+		t.Fatalf("rebound import: %+v %v", got, err)
+	}
+	current, err := s.Current(context.Background(), "destination", "config", root)
+	if err != nil || current == nil || len(current.Sources) != 1 || current.Sources[0].Root != root || current.Sources[0].Path != path {
+		t.Fatalf("binding: %+v %v", current, err)
+	}
+	absolute := row
+	absolute.ID = 4
+	absolute.Sources = []Source{{Root: original, Path: filepath.Join(original, "config"), SHA256: hash}}
+	if counts, err := s.Import(context.Background(), "destination", root, importJSON(t, absolute), "replace", true); err != nil || counts.Replaced != 1 {
+		t.Fatalf("contained absolute source: %+v %v", counts, err)
+	}
+	unchanged, err := s.Current(context.Background(), "destination", "config", root)
+	if err != nil || unchanged == nil || unchanged.ID != current.ID {
+		t.Fatalf("dry run changed source-bound record: %+v %v", unchanged, err)
+	}
+	bad := row
+	bad.ID = 2
+	selected := importRecord(3, "config", "source free")
+	cases := map[string]Source{
+		"hash":            {Root: original, Path: "config", SHA256: strings.Repeat("x", 64)},
+		"changed":         {Root: original, Path: "config", SHA256: strings.Repeat("0", 64)},
+		"missing":         {Root: original, Path: "missing", SHA256: hash},
+		"relative escape": {Root: original, Path: "../config", SHA256: hash},
+		"absolute escape": {Root: original, Path: filepath.Join(t.TempDir(), "config"), SHA256: hash},
+		"relative root":   {Root: "relative", Path: "config", SHA256: hash},
+	}
+	for name, source := range cases {
+		t.Run(name, func(t *testing.T) {
+			bad.Sources = []Source{source}
+			if _, err := s.Import(context.Background(), "destination", root, importJSON(t, bad, selected), "replace", false); err == nil {
+				t.Fatal("invalid historical source accepted")
+			}
+		})
+	}
+	outside := t.TempDir()
+	if err := os.WriteFile(filepath.Join(outside, "file"), []byte("contents"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(root, "out")); err != nil {
+		t.Fatal(err)
+	}
+	bad.Sources = []Source{{Root: original, Path: "out/file", SHA256: hash}}
+	if _, err := s.Import(context.Background(), "destination", root, importJSON(t, bad, selected), "replace", false); err == nil {
+		t.Fatal("symlink escape accepted")
+	}
+	if err := os.Mkdir(filepath.Join(root, "directory"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	bad.Sources = []Source{{Root: original, Path: "directory", SHA256: hash}}
+	if _, err := s.Import(context.Background(), "destination", root, importJSON(t, bad, selected), "replace", false); err == nil {
+		t.Fatal("nonregular source accepted")
+	}
+	if err := os.WriteFile(filepath.Join(root, "huge"), make([]byte, (1<<20)+1), 0600); err != nil {
+		t.Fatal(err)
+	}
+	bad.Sources = []Source{{Root: original, Path: "huge", SHA256: hash}}
+	if _, err := s.Import(context.Background(), "destination", root, importJSON(t, bad, selected), "replace", false); err == nil {
+		t.Fatal("oversized source accepted")
+	}
+	bad.Sources = make([]Source, 9)
+	if _, err := s.Import(context.Background(), "destination", root, importJSON(t, bad, selected), "replace", false); err == nil {
+		t.Fatal("too many sources accepted")
+	}
+	if err := os.WriteFile(path, []byte("changed"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.Import(context.Background(), "destination", root, importJSON(t, row), "replace", false); err == nil {
+		t.Fatal("stale destination source accepted")
+	}
+	if _, err := s.Import(context.Background(), "destination", root, importJSON(t, selected), "error", false); err == nil {
+		t.Fatal("stale active destination did not conflict")
+	}
+}
