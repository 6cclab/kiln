+func TestImportSourceRebindingAndHistoricalValidation(t *testing.T) {
+	ctx := context.Background()
+	s := importStore(t)
+	root := t.TempDir()
+	if err := os.WriteFile(filepath.Join(root, "file"), []byte("evidence"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	hash := sha256.Sum256([]byte("evidence"))
+	base := Source{Root: "/remote/old-project", Path: "file", SHA256: hex.EncodeToString(hash[:])}
+	record := importRecord(2, "file-key", "source-backed")
+	record.Sources = []Source{base}
+	data := importJSON(t, record)
+	if _, err := s.Import(ctx, "destination", root, data, ConflictError, false); err != nil {
+		t.Fatal(err)
+	}
+	got, err := s.Current(ctx, "destination", "file-key", root)
+	if err != nil || got == nil || len(got.Sources) != 1 || got.Sources[0].Root != root || got.Sources[0].Path != filepath.Join(root, "file") {
+		t.Fatalf("binding: %+v %v", got, err)
+	}
+	if err := os.WriteFile(filepath.Join(root, "file"), []byte("changed"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if got, _ := s.Current(ctx, "destination", "file-key", root); got != nil {
+		t.Fatal("stale file still visible")
+	}
+	if err := os.WriteFile(filepath.Join(root, "file"), []byte("evidence"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	other := importRecord(3, "new", "new")
+	badSources := []Source{
+		{Root: "relative", Path: "file", SHA256: base.SHA256},
+		{Root: base.Root, Path: "../escape", SHA256: base.SHA256},
+		{Root: base.Root, Path: "/another/file", SHA256: base.SHA256},
+		{Root: base.Root, Path: "file", SHA256: "bad"},
+		{Root: base.Root, Path: "missing", SHA256: base.SHA256},
+	}
+	for _, bad := range badSources {
+		historical := importRecord(1, "new", "old")
+		historical.Sources = []Source{bad}
+		if _, err := s.Import(ctx, "destination", root, importJSON(t, other, historical), ConflictSkip, false); err == nil {
+			t.Fatalf("accepted bad historical source: %+v", bad)
+		}
+	}
+	if err := os.Symlink(t.TempDir(), filepath.Join(root, "linked")); err != nil {
+		t.Fatal(err)
+	}
+	bad := importRecord(1, "new", "old")
+	bad.Sources = []Source{{Root: base.Root, Path: "linked/file", SHA256: base.SHA256}}
+	if _, err := s.Import(ctx, "destination", root, importJSON(t, other, bad), ConflictSkip, false); err == nil {
+		t.Fatal("symlink escape accepted")
+	}
+	if err := os.WriteFile(filepath.Join(root, "oversized"), make([]byte, (1<<20)+1), 0600); err != nil {
+		t.Fatal(err)
+	}
+	bad.Sources = []Source{{Root: base.Root, Path: "oversized", SHA256: base.SHA256}}
+	if _, err := s.Import(ctx, "destination", root, importJSON(t, other, bad), ConflictSkip, false); err == nil {
+		t.Fatal("oversized source accepted")
+	}
+	bad.Sources = []Source{{Root: base.Root, Path: ".", SHA256: base.SHA256}}
+	if _, err := s.Import(ctx, "destination", root, importJSON(t, other, bad), ConflictSkip, false); err == nil {
+		t.Fatal("directory source accepted")
+	}
+	bad.Sources = make([]Source, 9)
+	for i := range bad.Sources {
+		bad.Sources[i] = base
+	}
+	if _, err := s.Import(ctx, "destination", root, importJSON(t, other, bad), ConflictSkip, false); err == nil {
+		t.Fatal("nine sources accepted")
+	}
+	if got, _ := s.Current(ctx, "destination", "new", root); got != nil {
+		t.Fatal("partial import")
+	}
+	absolute := base
+	absolute.Path = filepath.Join(base.Root, "file")
+	other.Sources = []Source{absolute}
+	if _, err := s.Import(ctx, "destination", root, importJSON(t, other), ConflictError, false); err != nil {
+		t.Fatal(err)
+	}
+}
