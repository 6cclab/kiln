diff --git a/internal/memory/import.go b/internal/memory/import.go
new file mode 100644
index 0000000..8bb49f1
--- /dev/null
+++ b/internal/memory/import.go
@@ -0,0 +1,208 @@
+package memory
+
+import (
+	"bytes"
+	"context"
+	"database/sql"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+)
+
+// ConflictPolicy determines what to do with an active destination key.
+type ConflictPolicy string
+
+const (
+	ConflictError   ConflictPolicy = "error"
+	ConflictSkip    ConflictPolicy = "skip"
+	ConflictReplace ConflictPolicy = "replace"
+)
+
+// ImportResult counts selected keys, not historical versions.
+type ImportResult struct {
+	Inserted int  `json:"inserted"`
+	Replaced int  `json:"replaced"`
+	Skipped  int  `json:"skipped"`
+	DryRun   bool `json:"dry_run"`
+}
+
+// Import validates an export's entire history and atomically imports only the
+// highest-ID version of each key. Input identity and lineage never cross scopes.
+func (s *Store) Import(ctx context.Context, scope, projectRoot string, data []byte, policy ConflictPolicy, dryRun bool) (ImportResult, error) {
+	var result ImportResult
+	if scope == "" || (policy != ConflictError && policy != ConflictSkip && policy != ConflictReplace) {
+		return result, errors.New("invalid memory import destination or conflict policy")
+	}
+	if len(data) > 4<<20 {
+		return result, errors.New("memory import exceeds 4 MiB")
+	}
+	trimmed := bytes.TrimSpace(data)
+	if len(trimmed) == 0 || trimmed[0] != '[' {
+		return result, errors.New("memory import must be a JSON array")
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	var records []Record
+	if err := decoder.Decode(&records); err != nil {
+		return result, errors.New("invalid memory import JSON or unknown record/source field")
+	}
+	var extra any
+	if err := decoder.Decode(&extra); err != io.EOF {
+		return result, errors.New("memory import has trailing JSON")
+	}
+	if len(records) > 1000 {
+		return result, errors.New("memory import exceeds 1000 records")
+	}
+	selected := make(map[string]Record)
+	ids := make(map[int64]bool)
+	for i, r := range records {
+		if err := ctx.Err(); err != nil {
+			return result, err
+		}
+		if r.ID <= 0 || ids[r.ID] || r.Expires < 0 {
+			return result, fmt.Errorf("invalid memory import record %d: ID must be positive and unique, expiry nonnegative", i+1)
+		}
+		ids[r.ID] = true
+		// The exported scope is required by the format, but destination
+		// policy is checked against the requested scope, never the input.
+		if r.Scope == "" {
+			return result, fmt.Errorf("invalid memory import record %d: scope is required", i+1)
+		}
+		candidate := r
+		candidate.Scope = scope
+		if err := validatePutRecord(candidate); err != nil {
+			return result, fmt.Errorf("invalid memory import record %d: %w", i+1, err)
+		}
+		if len(r.Sources) > 0 {
+			if len(r.Sources) > 8 {
+				return result, fmt.Errorf("invalid memory import record %d: at most eight source files", i+1)
+			}
+			for j, source := range r.Sources {
+				bound, err := rebindImportSource(projectRoot, source)
+				if err != nil {
+					return result, fmt.Errorf("invalid memory import record %d source %d: %w", i+1, j+1, err)
+				}
+				r.Sources[j] = bound
+			}
+		}
+		if prior, ok := selected[r.Key]; !ok || r.ID > prior.ID {
+			selected[r.Key] = r
+		}
+	}
+
+	keys := make([]string, 0, len(selected))
+	for key := range selected {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return ImportResult{}, err
+	}
+	defer rollback(tx)
+	previous := make(map[string]int64, len(keys))
+	for _, key := range keys {
+		var id int64
+		err := tx.QueryRowContext(ctx, `SELECT id FROM memories WHERE scope=? AND key=? AND active=1`, scope, key).Scan(&id)
+		if err != nil && err != sql.ErrNoRows {
+			return ImportResult{}, err
+		}
+		if err == nil {
+			previous[key] = id
+			switch policy {
+			case ConflictError:
+				return ImportResult{}, errors.New("memory import conflicts with an existing key")
+			case ConflictSkip:
+				result.Skipped++
+			case ConflictReplace:
+				result.Replaced++
+			}
+		} else {
+			result.Inserted++
+		}
+	}
+	result.DryRun = dryRun
+	if dryRun {
+		if err := ctx.Err(); err != nil {
+			return ImportResult{}, err
+		}
+		return result, nil
+	}
+	for _, key := range keys {
+		if err := ctx.Err(); err != nil {
+			return ImportResult{}, err
+		}
+		old := previous[key]
+		if old != 0 && policy == ConflictSkip {
+			continue
+		}
+		if old != 0 {
+			if _, err := tx.ExecContext(ctx, `UPDATE memories SET active=0 WHERE id=?`, old); err != nil {
+				return ImportResult{}, err
+			}
+		}
+		r := selected[key]
+		res, err := tx.ExecContext(ctx, `INSERT INTO memories(scope,key,kind,text,evidence,created,expires,supersedes) VALUES(?,?,?,?,?,?,?,?)`, scope, r.Key, r.Kind, r.Text, r.Evidence, time.Now().Unix(), r.Expires, old)
+		if err != nil {
+			return ImportResult{}, err
+		}
+		id, err := res.LastInsertId()
+		if err != nil {
+			return ImportResult{}, err
+		}
+		if _, err := tx.ExecContext(ctx, `INSERT INTO memory_search(rowid,text,evidence) VALUES(?,?,?)`, id, r.Key+"\n"+r.Text, r.Evidence); err != nil {
+			return ImportResult{}, err
+		}
+		if len(r.Sources) != 0 {
+			raw, err := json.Marshal(r.Sources)
+			if err != nil {
+				return ImportResult{}, err
+			}
+			if _, err := tx.ExecContext(ctx, `INSERT INTO memory_sources(memory_id,sources) VALUES(?,?)`, id, string(raw)); err != nil {
+				return ImportResult{}, err
+			}
+		}
+	}
+	if err := ctx.Err(); err != nil {
+		return ImportResult{}, err
+	}
+	if err := tx.Commit(); err != nil {
+		return ImportResult{}, err
+	}
+	return result, nil
+}
+
+// rebindImportSource never opens a path from the exporting machine.
+func rebindImportSource(root string, source Source) (Source, error) {
+	invalid := errors.New("source path, hash, or destination file is invalid or stale")
+	if !filepath.IsAbs(source.Root) || source.Path == "" || len(source.SHA256) != 64 {
+		return Source{}, invalid
+	}
+	if _, err := hex.DecodeString(source.SHA256); err != nil {
+		return Source{}, invalid
+	}
+	origin := source.Path
+	if !filepath.IsAbs(origin) {
+		origin = filepath.Join(source.Root, origin)
+	}
+	rel, err := filepath.Rel(source.Root, origin)
+	if err != nil || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		return Source{}, invalid
+	}
+	canonical, err := filepath.EvalSymlinks(root)
+	if err != nil {
+		return Source{}, invalid
+	}
+	path := filepath.Join(canonical, rel)
+	digest, err := sourceDigest(canonical, path)
+	if err != nil || !strings.EqualFold(digest, source.SHA256) {
+		return Source{}, invalid
+	}
+	return Source{Root: canonical, Path: path, SHA256: digest}, nil
+}
