+func parseMemoryImport(tokens []string) (string, bool, memory.ConflictPolicy, error) {
+	filename := ""
+	dryRun := false
+	policy := memory.ConflictError
+	seenPolicy := false
+	for i := 0; i < len(tokens); i++ {
+		token := tokens[i]
+		switch {
+		case token == "--dry-run":
+			dryRun = true
+		case token == "--on-conflict" || strings.HasPrefix(token, "--on-conflict="):
+			if seenPolicy {
+				return "", false, "", errors.New("memory import: --on-conflict specified more than once")
+			}
+			seenPolicy = true
+			value := strings.TrimPrefix(token, "--on-conflict=")
+			if token == "--on-conflict" {
+				if i+1 == len(tokens) || strings.HasPrefix(tokens[i+1], "-") {
+					return "", false, "", errors.New("memory import: --on-conflict requires error, skip, or replace")
+				}
+				i++
+				value = tokens[i]
+			}
+			policy = memory.ConflictPolicy(value)
+			if policy != memory.ConflictError && policy != memory.ConflictSkip && policy != memory.ConflictReplace {
+				return "", false, "", errors.New("memory import: invalid --on-conflict policy (use error, skip, or replace)")
+			}
+		case strings.HasPrefix(token, "-"):
+			return "", false, "", errors.New("memory import: unknown flag")
+		case filename != "":
+			return "", false, "", errors.New("memory import: expected exactly one filename")
+		default:
+			filename = token
+		}
+	}
+	if filename == "" {
+		return "", false, "", errors.New("memory import: filename is required")
+	}
+	return filename, dryRun, policy, nil
+}
+
+func readMemoryImport(filename string) ([]byte, error) {
+	file, err := os.Open(filename)
+	if err != nil {
+		return nil, errors.New("memory import: cannot open input file")
+	}
+	defer diag.Close(file)
+	data, err := io.ReadAll(io.LimitReader(file, (4<<20)+1))
+	if err != nil {
+		return nil, errors.New("memory import: cannot read input file")
+	}
+	if len(data) > 4<<20 {
+		return nil, errors.New("memory import: input exceeds 4 MiB")
+	}
+	return data, nil
+}
