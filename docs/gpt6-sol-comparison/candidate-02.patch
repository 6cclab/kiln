@@ -0,0 +1,330 @@
+package memory
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+)
+
+func importRecord(id int64, key, text string) Record {
+	return Record{ID: id, Scope: "/old/project", Key: key, Kind: "fact", Text: text, Evidence: "user"}
+}
+
+func importJSON(t *testing.T, records ...Record) []byte {
+	t.Helper()
+	data, err := json.Marshal(records)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return data
+}
+
+func importStore(t *testing.T) *Store {
+	t.Helper()
+	s, err := Open(filepath.Join(t.TempDir(), "memory.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := s.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	return s
+}
+
+func TestImportHistoryConflictAndIsolation(t *testing.T) {
+	ctx := context.Background()
+	s := importStore(t)
+	root := t.TempDir()
+	old, err := s.Put(ctx, Record{Scope: "destination", Key: "existing", Kind: "fact", Text: "local", Evidence: "user", Expires: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	prior := importRecord(71, "existing", "old remote")
+	prior.Supersedes = 900
+	current := importRecord(99, "existing", "new remote")
+	current.Created = 1
+	current.Supersedes = 71
+	newKey := importRecord(88, "new", "fresh")
+	newKey.Expires = time.Now().Add(time.Hour).Unix()
+	data := importJSON(t, current, newKey, prior)
+	before, _ := s.Export(ctx, "destination")
+	for _, policy := range []ConflictPolicy{ConflictError, ConflictSkip, ConflictReplace} {
+		got, err := s.Import(ctx, "destination", root, data, policy, true)
+		if policy == ConflictError {
+			if err == nil {
+				t.Fatal("conflict accepted")
+			}
+			continue
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		want := ImportResult{Inserted: 1, DryRun: true}
+		if policy == ConflictSkip {
+			want.Skipped = 1
+		} else {
+			want.Replaced = 1
+		}
+		if got != want {
+			t.Fatalf("dry run: %+v want %+v", got, want)
+		}
+	}
+	after, _ := s.Export(ctx, "destination")
+	if string(after) != string(before) {
+		t.Fatal("dry run changed history")
+	}
+	var searchCount, sourceCount int
+	if err := s.db.QueryRow(`SELECT count(*) FROM memory_search`).Scan(&searchCount); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.db.QueryRow(`SELECT count(*) FROM memory_sources`).Scan(&sourceCount); err != nil {
+		t.Fatal(err)
+	}
+	got, err := s.Import(ctx, "destination", root, data, ConflictSkip, false)
+	if err != nil || got != (ImportResult{Inserted: 1, Skipped: 1}) {
+		t.Fatalf("skip: %+v %v", got, err)
+	}
+	if r, _ := s.Current(ctx, "destination", "existing", root); r != nil {
+		t.Fatal("expired local key overwritten or became visible")
+	}
+	fresh, err := s.Current(ctx, "destination", "new", root)
+	if err != nil || fresh == nil || fresh.ID == newKey.ID || fresh.Scope != "destination" || fresh.Supersedes != 0 || fresh.Expires != newKey.Expires || fresh.Created < time.Now().Add(-time.Minute).Unix() {
+		t.Fatalf("fresh: %+v %v", fresh, err)
+	}
+	got, err = s.Import(ctx, "destination", root, data, ConflictReplace, false)
+	if err != nil || got != (ImportResult{Replaced: 2}) {
+		t.Fatalf("replace: %+v %v", got, err)
+	}
+	updated, err := s.Current(ctx, "destination", "existing", root)
+	if err != nil || updated == nil || updated.Supersedes != old || updated.Text != "new remote" {
+		t.Fatalf("correction lineage: %+v %v", updated, err)
+	}
+	exported, err := s.Export(ctx, "destination")
+	var history []Record
+	if err != nil || json.Unmarshal(exported, &history) != nil || len(history) != 4 {
+		t.Fatalf("history: %s %v", exported, err)
+	}
+	other, _ := s.Export(ctx, "/old/project")
+	if string(other) != "[]" {
+		t.Fatalf("wrote input scope: %s", other)
+	}
+	if err := s.db.QueryRow(`SELECT count(*) FROM memory_search`).Scan(&sourceCount); err != nil {
+		t.Fatal(err)
+	}
+	if sourceCount != searchCount+3 {
+		t.Fatalf("search entries lost: %d", sourceCount)
+	}
+}
