+	valid := importRecord(2, "key", "current")
+	bad := importRecord(1, "key", "old")
+	cases := map[string][]byte{
+		"null": []byte("null"), "object": []byte("{}"), "trailing": []byte("[] {}"),
+		"malformed": []byte("["), "unknown record": []byte(`[{"id":1,"scope":"s","key":"k","kind":"fact","text":"t","evidence":"e","created":0,"credential":"secret"}]`),
+		"unknown source": []byte(`[{"id":1,"scope":"s","key":"k","kind":"fact","text":"t","evidence":"e","created":0,"sources":[{"root":"/old","path":"file","sha256":"abc","credential":"secret"}]}]`),
+		"duplicate ID":   importJSON(t, valid, valid),
+	}
+	bad.ID = 0
+	cases["historical zero ID"] = importJSON(t, valid, bad)
+	bad = importRecord(1, "key", "old")
+	bad.Scope = ""
+	cases["historical missing scope"] = importJSON(t, valid, bad)
+	bad = importRecord(1, "key", "old")
+	bad.Expires = -1
+	cases["historical negative expiry"] = importJSON(t, valid, bad)
+	bad = importRecord(1, "key", " ")
+	cases["historical empty text"] = importJSON(t, valid, bad)
+	bad = importRecord(1, "key", "old")
+	bad.Kind = "invalid"
+	cases["historical kind"] = importJSON(t, valid, bad)
+	bad = importRecord(1, "key", "old")
+	bad.Key = strings.Repeat("x", 257)
+	cases["field limit"] = importJSON(t, valid, bad)
+	cases["record limit"] = importJSON(t, func() []Record {
+		out := make([]Record, 1001)
+		for i := range out {
+			out[i] = importRecord(int64(i+1), "key", "text")
+		}
+		return out
+	}()...)
+	cases["byte limit"] = append([]byte("[]"), make([]byte, 4<<20)...)
+	for name, data := range cases {
+		t.Run(name, func(t *testing.T) {
+			if _, err := s.Import(ctx, "destination", t.TempDir(), data, ConflictSkip, false); err == nil {
+				t.Fatal("accepted bad import")
+			} else if strings.Contains(err.Error(), "secret") {
+				t.Fatal("leaked credential")
+			}
+			raw, err := s.Export(ctx, "destination")
+			if err != nil || string(raw) != "[]" {
+				t.Fatalf("partial write: %s %v", raw, err)
+			}
+		})
+	}
+	if result, err := s.Import(ctx, "destination", t.TempDir(), []byte("[]"), ConflictError, false); err != nil || result != (ImportResult{}) {
+		t.Fatalf("empty array: %+v %v", result, err)
+	}
