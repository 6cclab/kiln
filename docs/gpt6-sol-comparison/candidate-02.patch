+func TestImportGlobalAndRollback(t *testing.T) {
+	ctx := context.Background()
+	s := importStore(t)
+	good := importRecord(2, "good", "good")
+	good.Kind = "preference"
+	old := importRecord(1, "good", "old")
+	for _, historical := range []Record{old, func() Record { r := good; r.ID = 1; r.Sources = []Source{{}}; return r }()} {
+		if _, err := s.Import(ctx, GlobalPreferencesScope, t.TempDir(), importJSON(t, good, historical), ConflictError, false); err == nil {
+			t.Fatal("invalid global history accepted")
+		}
+	}
+	if _, err := s.Import(ctx, GlobalPreferencesScope, t.TempDir(), importJSON(t, good), ConflictError, false); err != nil {
+		t.Fatal(err)
+	}
+	before, _ := s.Export(ctx, GlobalPreferencesScope)
+	newKey := importRecord(3, "a", "added")
+	newKey.Kind = "preference"
+	cancel, stop := context.WithCancel(ctx)
+	stop()
+	if _, err := s.Import(cancel, GlobalPreferencesScope, t.TempDir(), importJSON(t, newKey), ConflictError, false); err == nil {
+		t.Fatal("cancelled import accepted")
+	}
+	// A late insert error must roll back both an earlier insert and a replacement.
+	if _, err := s.db.Exec(`CREATE TRIGGER import_fail_insert BEFORE INSERT ON memories WHEN new.text = 'blocked' BEGIN SELECT RAISE(FAIL, 'blocked'); END`); err != nil {
+		t.Fatal(err)
+	}
+	blocked := importRecord(4, "good", "blocked")
+	blocked.Kind = "preference"
+	if _, err := s.Import(ctx, GlobalPreferencesScope, t.TempDir(), importJSON(t, newKey, blocked), ConflictReplace, false); err == nil {
+		t.Fatal("failed write accepted")
+	}
+	after, _ := s.Export(ctx, GlobalPreferencesScope)
+	if !reflect.DeepEqual(before, after) {
+		t.Fatal("failed import changed history")
+	}
+	var count int
+	if err := s.db.QueryRow(`SELECT count(*) FROM memory_search`).Scan(&count); err != nil || count != 1 {
+		t.Fatalf("search changed: %d %v", count, err)
+	}
+}
