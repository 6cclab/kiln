+func TestImportWriteFailureRollsBackSourceBindings(t *testing.T) {
+	ctx := context.Background()
+	s := importStore(t)
+	root := t.TempDir()
+	if err := os.WriteFile(filepath.Join(root, "file"), []byte("content"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	hash := sha256.Sum256([]byte("content"))
+	first := importRecord(1, "a", "source-backed")
+	first.Sources = []Source{{Root: "/old", Path: "file", SHA256: hex.EncodeToString(hash[:])}}
+	last := importRecord(2, "z", "blocked")
+	data := importJSON(t, first, last)
+	result, err := s.Import(ctx, "destination", root, data, ConflictError, true)
+	if err != nil || result != (ImportResult{Inserted: 2, DryRun: true}) {
+		t.Fatalf("dry run: %+v %v", result, err)
+	}
+	if _, err := s.db.Exec(`CREATE TRIGGER fail_import BEFORE INSERT ON memories WHEN new.text = 'blocked' BEGIN SELECT RAISE(FAIL, 'blocked'); END`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.Import(ctx, "destination", root, data, ConflictError, false); err == nil {
+		t.Fatal("write failure accepted")
+	}
+	for _, table := range []string{"memories", "memory_search", "memory_sources"} {
+		var count int
+		if err := s.db.QueryRow(`SELECT count(*) FROM ` + table).Scan(&count); err != nil || count != 0 {
+			t.Fatalf("%s changed: %d %v", table, count, err)
+		}
+	}
+}
