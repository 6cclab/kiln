diff --git a/internal/cli/memory_import.go b/internal/cli/memory_import.go
new file mode 100644
index 0000000..6bc2b69
--- /dev/null
+++ b/internal/cli/memory_import.go
@@ -0,0 +1,286 @@
+package cli
+
+import (
+	"bytes"
+	"context"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/andrepato/harness/internal/diag"
+	"github.com/andrepato/harness/internal/memory"
+)
+
+const maxMemoryImportBytes = 4 << 20
+
+// MemoryImport is the explicit local import command, dispatched before the
+// general CLI parser so flags after the filename retain their meaning.
+func MemoryImport(ctx context.Context, global bool, args []string, out, stderr io.Writer) int {
+	path, policy, dryRun, err := parseMemoryImportArgs(args)
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 2
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			writeDiagnostic(stderr, "memory import file does not exist")
+		} else {
+			writeDiagnostic(stderr, "cannot open memory import file")
+		}
+		return 1
+	}
+	defer diag.Close(file)
+	data, err := io.ReadAll(io.LimitReader(file, maxMemoryImportBytes+1))
+	if err != nil {
+		writeDiagnostic(stderr, "cannot read memory import file")
+		return 1
+	}
+	if len(data) > maxMemoryImportBytes {
+		writeDiagnostic(stderr, "memory import file exceeds 4 MiB")
+		return 1
+	}
+	if len(bytes.TrimSpace(data)) == 0 || bytes.TrimSpace(data)[0] != '[' {
+		writeDiagnostic(stderr, "memory import requires one JSON array")
+		return 1
+	}
+	var records []memory.Record
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&records); err != nil {
+		writeDiagnostic(stderr, "invalid memory import JSON")
+		return 1
+	}
+	var extra any
+	if err := decoder.Decode(&extra); !errors.Is(err, io.EOF) {
+		writeDiagnostic(stderr, "memory import has trailing JSON")
+		return 1
+	}
+	if len(records) > 1000 {
+		writeDiagnostic(stderr, "memory import exceeds 1000 records")
+		return 1
+	}
+	if err := validateMemoryImportJSONShape(data); err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	cwd, err := os.Getwd()
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	scope := memoryScope(cwd)
+	if global {
+		scope = memory.GlobalPreferencesScope
+	}
+	selected, err := prepareMemoryImport(records, scope, memoryProjectRoot(cwd))
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	home, err := os.UserHomeDir()
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	store, err := memory.Open(filepath.Join(home, ".kiln", "memory.db"))
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	defer diag.Close(store)
+	counts, err := store.ImportSelected(ctx, scope, selected, policy, dryRun)
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	if err := json.NewEncoder(out).Encode(counts); err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	return 0
+}
+
+var importRecordFields = map[string]bool{
+	"id": true, "scope": true, "key": true, "kind": true, "text": true,
+	"evidence": true, "created": true, "expires": true, "supersedes": true, "sources": true,
+}
+
+var importSourceFields = map[string]bool{"root": true, "path": true, "sha256": true}
+
+// encoding/json matches struct fields without regard to case and treats null
+// as zero for numbers. Export field names and optional numeric values are exact.
+func validateMemoryImportJSONShape(data []byte) error {
+	var rows []json.RawMessage
+	if err := json.Unmarshal(data, &rows); err != nil {
+		return errors.New("invalid memory import JSON")
+	}
+	for _, row := range rows {
+		row = bytes.TrimSpace(row)
+		if len(row) == 0 || row[0] != '{' {
+			return errors.New("memory import records must be objects")
+		}
+		var fields map[string]json.RawMessage
+		if err := json.Unmarshal(row, &fields); err != nil {
+			return errors.New("invalid memory import record")
+		}
+		for name := range fields {
+			if !importRecordFields[name] {
+				return errors.New("memory import has an unknown record field")
+			}
+		}
+		for _, name := range []string{"id", "created", "expires", "supersedes"} {
+			if raw, ok := fields[name]; ok && bytes.Equal(bytes.TrimSpace(raw), []byte("null")) {
+				return errors.New("memory import has a null numeric field")
+			}
+		}
+		raw, ok := fields["sources"]
+		if !ok {
+			continue
+		}
+		raw = bytes.TrimSpace(raw)
+		if len(raw) == 0 || raw[0] != '[' {
+			return errors.New("memory import sources must be an array")
+		}
+		var sources []json.RawMessage
+		if err := json.Unmarshal(raw, &sources); err != nil {
+			return errors.New("invalid memory import sources")
+		}
+		for _, source := range sources {
+			source = bytes.TrimSpace(source)
+			if len(source) == 0 || source[0] != '{' {
+				return errors.New("memory import sources must be objects")
+			}
+			var sourceFields map[string]json.RawMessage
+			if err := json.Unmarshal(source, &sourceFields); err != nil {
+				return errors.New("invalid memory import source")
+			}
+			for name := range sourceFields {
+				if !importSourceFields[name] {
+					return errors.New("memory import has an unknown source field")
+				}
+			}
+		}
+	}
+	return nil
+}
+
+func parseMemoryImportArgs(args []string) (path, policy string, dryRun bool, err error) {
+	policy = "error"
+	policySeen := false
+	for i := 0; i < len(args); i++ {
+		token := args[i]
+		switch {
+		case token == "--dry-run":
+			if dryRun {
+				return "", "", false, errors.New("duplicate --dry-run")
+			}
+			dryRun = true
+		case token == "--on-conflict" || strings.HasPrefix(token, "--on-conflict="):
+			if policySeen {
+				return "", "", false, errors.New("duplicate --on-conflict")
+			}
+			policySeen = true
+			if token == "--on-conflict" {
+				i++
+				if i >= len(args) || strings.HasPrefix(args[i], "-") {
+					return "", "", false, errors.New("--on-conflict requires error, skip, or replace")
+				}
+				policy = args[i]
+			} else {
+				policy = strings.TrimPrefix(token, "--on-conflict=")
+			}
+			if policy != "error" && policy != "skip" && policy != "replace" {
+				return "", "", false, errors.New("invalid --on-conflict policy")
+			}
+		case strings.HasPrefix(token, "-"):
+			flag, _, _ := strings.Cut(token, "=")
+			return "", "", false, fmt.Errorf("unknown memory import flag %q", flag)
+		case path == "":
+			path = token
+		default:
+			return "", "", false, errors.New("memory import accepts exactly one filename")
+		}
+	}
+	if path == "" {
+		return "", "", false, errors.New("usage: kiln memory [global] import <file> [--dry-run] [--on-conflict error|skip|replace]")
+	}
+	return path, policy, dryRun, nil
+}
+
+func prepareMemoryImport(records []memory.Record, scope, projectRoot string) ([]memory.Record, error) {
+	seen := make(map[int64]bool, len(records))
+	current := make(map[string]memory.Record)
+	for i, r := range records {
+		if r.ID <= 0 || seen[r.ID] {
+			return nil, fmt.Errorf("memory import record %d has a nonpositive or duplicate ID", i+1)
+		}
+		seen[r.ID] = true
+		r.Scope = scope
+		// Validate every version, including versions that will not be selected.
+		if err := memory.ValidateImportRecord(r); err != nil {
+			return nil, fmt.Errorf("invalid memory import record %d: %w", i+1, err)
+		}
+		if len(r.Sources) > 0 {
+			rebound := make([]memory.Source, 0, len(r.Sources))
+			for _, source := range r.Sources {
+				bound, err := rebindMemorySource(projectRoot, source)
+				if err != nil {
+					return nil, fmt.Errorf("invalid memory import source in record %d: %w", i+1, err)
+				}
+				rebound = append(rebound, bound)
+			}
+			r.Sources = rebound
+		}
+		r.Created, r.Supersedes = 0, 0
+		if old, ok := current[r.Key]; !ok || r.ID > old.ID {
+			current[r.Key] = r
+		}
+	}
+	selected := make([]memory.Record, 0, len(current))
+	for _, r := range current {
+		selected = append(selected, r)
+	}
+	sort.Slice(selected, func(i, j int) bool { return selected[i].ID < selected[j].ID })
+	return selected, nil
+}
+
+func rebindMemorySource(projectRoot string, source memory.Source) (memory.Source, error) {
+	if !filepath.IsAbs(source.Root) || source.Path == "" {
+		return memory.Source{}, errors.New("source root or path is invalid")
+	}
+	if len(source.SHA256) != 64 {
+		return memory.Source{}, errors.New("source SHA-256 is invalid")
+	}
+	hash, err := hex.DecodeString(source.SHA256)
+	if err != nil || len(hash) != 32 {
+		return memory.Source{}, errors.New("source SHA-256 is invalid")
+	}
+	root := filepath.Clean(source.Root)
+	path := source.Path
+	if !filepath.IsAbs(path) {
+		cleanRelative := filepath.Clean(path)
+		if cleanRelative == ".." || strings.HasPrefix(cleanRelative, ".."+string(filepath.Separator)) {
+			return memory.Source{}, errors.New("source path escapes original root")
+		}
+		path = filepath.Join(root, path)
+	}
+	relative, err := filepath.Rel(root, filepath.Clean(path))
+	if err != nil || relative == ".." || strings.HasPrefix(relative, ".."+string(filepath.Separator)) || relative == "." {
+		return memory.Source{}, errors.New("source path escapes original root")
+	}
+	bound, err := memory.CaptureSources(projectRoot, []string{relative})
+	if err != nil {
+		return memory.Source{}, errors.New("destination source is missing, unsafe, or oversized")
+	}
+	if !strings.EqualFold(bound[0].SHA256, source.SHA256) {
+		return memory.Source{}, errors.New("destination source hash differs")
+	}
+	return bound[0], nil
+}
