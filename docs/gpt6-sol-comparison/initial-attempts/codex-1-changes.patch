+package memory
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestImportSelectedRollsBackWritesAndCancellation(t *testing.T) {
+	s, err := Open(filepath.Join(t.TempDir(), "memory.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	ctx := context.Background()
+	first, err := s.Put(ctx, Record{Scope: "project", Key: "a", Kind: "fact", Text: "local", Evidence: "local evidence"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	rows := []Record{{Key: "a", Kind: "fact", Text: "incoming", Evidence: "import", Sources: []Source{{Root: "/project", Path: "/project/file", SHA256: "unused in store transaction test"}}}, {Key: "b", Kind: "fact", Text: "second", Evidence: "import"}}
+	if _, err := s.db.Exec(`CREATE TRIGGER fail_second_import BEFORE INSERT ON memories WHEN NEW.key='b' BEGIN SELECT RAISE(FAIL, 'injected failure'); END`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.ImportSelected(ctx, "project", rows, "replace", false); err == nil {
+		t.Fatal("write failure accepted")
+	}
+	current, err := s.Current(ctx, "project", "a", "")
+	if err != nil || current == nil || current.ID != first {
+		t.Fatalf("rollback changed current: %+v %v", current, err)
+	}
+	exported, err := s.Export(ctx, "project")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var records []Record
+	if err := json.Unmarshal(exported, &records); err != nil || len(records) != 1 {
+		t.Fatalf("rollback changed history: %s %v", exported, err)
+	}
+	search, err := s.Search(ctx, "project", "incoming", 5)
+	if err != nil || len(search) != 0 {
+		t.Fatalf("rollback left search entry: %+v %v", search, err)
+	}
+	var sources int
+	if err := s.db.QueryRow(`SELECT count(*) FROM memory_sources`).Scan(&sources); err != nil || sources != 0 {
+		t.Fatalf("rollback left source binding: %d %v", sources, err)
+	}
+	cancelled, cancel := context.WithCancel(ctx)
+	cancel()
+	if _, err := s.ImportSelected(cancelled, "project", rows, "replace", false); !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancellation: %v", err)
+	}
+	counts, err := s.ImportSelected(ctx, "project", rows, "replace", true)
+	if err != nil || counts.Replaced != 1 || counts.Inserted != 1 || !counts.DryRun {
+		t.Fatalf("dry run counts: %+v %v", counts, err)
+	}
+	exportedAfter, err := s.Export(ctx, "project")
+	if err != nil || string(exportedAfter) != string(exported) {
+		t.Fatalf("dry run changed history: %s %v", exportedAfter, err)
+	}
+}
+
+func TestImportSelectedExpiredActiveKeyIsConflict(t *testing.T) {
+	s, err := Open(filepath.Join(t.TempDir(), "memory.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	ctx := context.Background()
+	previous, err := s.Put(ctx, Record{Scope: "project", Key: "expired", Kind: "fact", Text: "old", Evidence: "e", Expires: time.Now().Add(-time.Hour).Unix()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	rows := []Record{{Key: "expired", Kind: "fact", Text: "new", Evidence: "e"}}
+	if _, err := s.ImportSelected(ctx, "project", rows, "error", true); err == nil {
+		t.Fatal("expired current key was not a conflict")
+	}
+	counts, err := s.ImportSelected(ctx, "project", rows, "replace", false)
+	if err != nil || counts.Replaced != 1 {
+		t.Fatalf("replace expired: %+v %v", counts, err)
+	}
+	current, err := s.Current(ctx, "project", "expired", "")
+	if err != nil || current == nil || current.Supersedes != previous {
+		t.Fatalf("expired lineage: %+v %v", current, err)
+	}
+}
+
+func TestImportSelectedConflictRollsBackEarlierInsert(t *testing.T) {
+	s, err := Open(filepath.Join(t.TempDir(), "memory.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	ctx := context.Background()
+	if _, err := s.Put(ctx, Record{Scope: "project", Key: "b", Kind: "fact", Text: "local", Evidence: "e"}); err != nil {
+		t.Fatal(err)
+	}
+	rows := []Record{{Key: "a", Kind: "fact", Text: "new", Evidence: "e"}, {Key: "b", Kind: "fact", Text: "incoming", Evidence: "e"}}
+	if _, err := s.ImportSelected(ctx, "project", rows, "error", false); err == nil {
+		t.Fatal("conflict accepted")
+	}
+	exported, err := s.Export(ctx, "project")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var records []Record
+	if err := json.Unmarshal(exported, &records); err != nil || len(records) != 1 || records[0].Key != "b" {
+		t.Fatalf("conflict left partial batch: %s %v", exported, err)
+	}
+}
