+package main
+
+import "testing"
+
+func TestMemoryImportFlagsReachLocalCommand(t *testing.T) {
+	// The general CLI parser does not know these flags. A syntax error from
+	// MemoryImport proves the raw command was dispatched before that parser.
+	if code := run([]string{"memory", "import", "--dry-run"}); code != 2 {
+		t.Fatalf("project import dispatched through general parser: %d", code)
+	}
+	if code := run([]string{"memory", "global", "import", "--on-conflict", "replace"}); code != 2 {
+		t.Fatalf("global import dispatched through general parser: %d", code)
+	}
+}
