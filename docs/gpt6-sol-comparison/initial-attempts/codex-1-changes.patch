+package cli
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/andrepato/harness/internal/memory"
+)
+
+func importFixture(t *testing.T, records []memory.Record) string {
+	t.Helper()
+	data, err := json.Marshal(records)
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(t.TempDir(), "export.json")
+	if err := os.WriteFile(path, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func importCall(t *testing.T, global bool, args ...string) (int, string, string) {
+	t.Helper()
+	var out, stderr bytes.Buffer
+	code := MemoryImport(context.Background(), global, args, &out, &stderr)
+	return code, out.String(), stderr.String()
+}
+
+func importRecord(id int64, key, value string) memory.Record {
+	return memory.Record{ID: id, Scope: "/old/machine", Key: key, Kind: "fact", Text: value, Evidence: "exported observation", Created: 1, Supersedes: 999}
+}
+
+func TestMemoryImportHistoryConflictAndDryRun(t *testing.T) {
+	home, project := t.TempDir(), t.TempDir()
+	t.Setenv("HOME", home)
+	oldCwd, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chdir(project); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.Chdir(oldCwd) })
+	path := importFixture(t, []memory.Record{importRecord(7, "a", "new A"), importRecord(2, "a", "old A"), importRecord(3, "b", "new B")})
+	if code, out, stderr := importCall(t, false, path, "--dry-run"); code != 0 || out != "{\"inserted\":2,\"replaced\":0,\"skipped\":0,\"dry_run\":true}\n" {
+		t.Fatalf("dry run: %d %q %q", code, out, stderr)
+	}
+	s, err := memory.Open(filepath.Join(home, ".kiln", "memory.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := context.Background()
+	data, err := s.Export(ctx, memoryScope(project))
+	if err != nil || string(data) != "[]" {
+		t.Fatalf("dry run wrote memory: %s %v", data, err)
+	}
+	if err := s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if code, out, stderr := importCall(t, false, path); code != 0 || !strings.Contains(out, `"inserted":2`) {
+		t.Fatalf("import: %d %q %q", code, out, stderr)
+	}
+	s, err = memory.Open(filepath.Join(home, ".kiln", "memory.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	a, err := s.Current(ctx, memoryScope(project), "a", project)
+	if err != nil || a == nil || a.Text != "new A" || a.Supersedes != 0 || a.Scope != memoryScope(project) {
+		t.Fatalf("selected current: %+v %v", a, err)
+	}
+	if _, err := s.Put(ctx, memory.Record{Scope: memoryScope(project), Key: "a", Kind: "fact", Text: "local correction", Evidence: "user"}); err != nil {
+		t.Fatal(err)
+	}
+	code, out, stderr := importCall(t, false, path)
+	if code == 0 || out != "" || !strings.Contains(stderr, "conflict") {
+		t.Fatalf("default conflict: %d %q %q", code, out, stderr)
+	}
+	if code, out, stderr := importCall(t, false, path, "--on-conflict", "skip"); code != 0 || !strings.Contains(out, `"skipped":2`) {
+		t.Fatalf("skip: %d %q %q", code, out, stderr)
+	}
+	before, err := s.Current(ctx, memoryScope(project), "a", project)
+	if err != nil || before.Text != "local correction" {
+		t.Fatalf("skip changed local record: %+v %v", before, err)
+	}
+	if code, out, stderr := importCall(t, false, "--on-conflict=replace", path); code != 0 || !strings.Contains(out, `"replaced":2`) {
+		t.Fatalf("replace: %d %q %q", code, out, stderr)
+	}
+	a, err = s.Current(ctx, memoryScope(project), "a", project)
+	if err != nil || a == nil || a.Supersedes != before.ID || a.Text != "new A" {
+		t.Fatalf("replace lineage: %+v %v", a, err)
+	}
+}
+
+func TestMemoryImportRejectsInvalidInputWithoutWrites(t *testing.T) {
+	for name, raw := range map[string]string{
+		"null": "null", "object": "{}", "trailing": "[] []", "unknown record": `[{"id":1,"key":"a","kind":"fact","text":"x","evidence":"e","secret":"x"}]`,
+		"duplicate IDs":   `[{"id":1,"key":"a","kind":"fact","text":"x","evidence":"e"},{"id":1,"key":"b","kind":"fact","text":"x","evidence":"e"}]`,
+		"bad historical":  `[{"id":1,"key":"a","kind":"fact","text":" ","evidence":"e"},{"id":2,"key":"a","kind":"fact","text":"new","evidence":"e"}]`,
+		"negative expiry": `[{"id":1,"key":"a","kind":"fact","text":"x","evidence":"e","expires":-1}]`,
+		"null expiry":     `[{"id":1,"key":"a","kind":"fact","text":"x","evidence":"e","expires":null}]`,
+		"case variant":    `[{"id":1,"key":"a","kind":"fact","text":"x","evidence":"e","Expires":0}]`,
+		"null sources":    `[{"id":1,"key":"a","kind":"fact","text":"x","evidence":"e","sources":null}]`,
+		"unknown source":  `[{"id":1,"key":"a","kind":"fact","text":"x","evidence":"e","sources":[{"root":"/old","path":"x","sha256":"abc","extra":1}]}]`,
+		"source casing":   `[{"id":1,"key":"a","kind":"fact","text":"x","evidence":"e","sources":[{"Root":"/old","path":"x","sha256":"abc"}]}]`,
+	} {
+		t.Run(name, func(t *testing.T) {
+			t.Setenv("HOME", t.TempDir())
+			path := filepath.Join(t.TempDir(), "input.json")
+			if err := os.WriteFile(path, []byte(raw), 0600); err != nil {
+				t.Fatal(err)
+			}
+			if code, out, stderr := importCall(t, false, path); code == 0 || out != "" || stderr == "" {
+				t.Fatalf("accepted %s: %d %q %q", name, code, out, stderr)
+			}
+		})
+	}
+	if _, _, _, err := parseMemoryImportArgs(nil); err == nil {
+		t.Fatal("missing filename accepted")
+	}
+	for _, args := range [][]string{{"file", "extra"}, {"file", "--unknown"}, {"file", "--on-conflict"}, {"file", "--on-conflict=bad"}, {"file", "--dry-run=yes"}} {
+		if _, _, _, err := parseMemoryImportArgs(args); err == nil {
+			t.Fatalf("accepted arguments %v", args)
+		}
+	}
+	if _, _, _, err := parseMemoryImportArgs([]string{"file", "--token=credential-value"}); err == nil || strings.Contains(err.Error(), "credential-value") {
+		t.Fatalf("credential echoed in flag diagnostic: %v", err)
+	}
+	for name, raw := range map[string][]byte{"oversize": bytes.Repeat([]byte(" "), maxMemoryImportBytes+1), "too many": func() []byte {
+		rows := make([]memory.Record, 1001)
+		for i := range rows {
+			rows[i] = importRecord(int64(i+1), "key", "value")
+		}
+		data, _ := json.Marshal(rows)
+		return data
+	}()} {
+		t.Run(name, func(t *testing.T) {
+			t.Setenv("HOME", t.TempDir())
+			path := filepath.Join(t.TempDir(), "input.json")
+			if err := os.WriteFile(path, raw, 0600); err != nil {
+				t.Fatal(err)
+			}
+			if code, out, _ := importCall(t, false, path); code == 0 || out != "" {
+				t.Fatalf("accepted %s", name)
+			}
+		})
+	}
+}
+
+func TestMemoryImportSourceRebindingAndGlobalHistory(t *testing.T) {
+	project := t.TempDir()
+	if err := os.WriteFile(filepath.Join(project, "config.txt"), []byte("config"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	source, err := memory.CaptureSources(project, []string{"config.txt"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	remote := source[0]
+	remote.Root = "/unavailable/original"
+	remote.Path = "/unavailable/original/config.txt"
+	r := importRecord(1, "config", "uses config")
+	r.Sources = []memory.Source{remote}
