--- /dev/null
+++ b/internal/memory/import.go
@@ -0,0 +1,95 @@
+package memory
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+)
+
+// ImportCounts describes the selected current keys, including a dry run.
+type ImportCounts struct {
+	Inserted int  `json:"inserted"`
+	Replaced int  `json:"replaced"`
+	Skipped  int  `json:"skipped"`
+	DryRun   bool `json:"dry_run"`
+}
+
+// ValidateImportRecord applies Put's content and kind limits plus import-only
+// expiry and source-count limits. Scope must already be set to the destination.
+func ValidateImportRecord(r Record) error {
+	if err := validatePutRecord(r); err != nil {
+		return err
+	}
+	if r.Expires < 0 {
+		return errors.New("negative expiry")
+	}
+	if len(r.Sources) > 8 {
+		return errors.New("more than eight source files")
+	}
+	return nil
+}
+
+// ImportSelected analyzes conflicts and writes a batch in one transaction.
+// The caller must validate and rebind every input version before selecting keys.
+func (s *Store) ImportSelected(ctx context.Context, scope string, records []Record, policy string, dryRun bool) (ImportCounts, error) {
+	counts := ImportCounts{DryRun: dryRun}
+	if scope == "" || (policy != "error" && policy != "skip" && policy != "replace") {
+		return counts, errors.New("invalid memory import scope or conflict policy")
+	}
+	for _, r := range records {
+		r.Scope = scope
+		if err := ValidateImportRecord(r); err != nil {
+			return counts, err
+		}
+	}
+	if err := ctx.Err(); err != nil {
+		return counts, err
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return counts, err
+	}
+	defer rollback(tx)
+	for _, r := range records {
+		if err := ctx.Err(); err != nil {
+			return counts, err
+		}
+		r.Scope = scope
+		var previous int64
+		err := tx.QueryRowContext(ctx, `SELECT id FROM memories WHERE scope=? AND key=? AND active=1`, scope, r.Key).Scan(&previous)
+		if err != nil && !errors.Is(err, sql.ErrNoRows) {
+			return counts, err
+		}
+		if err == nil {
+			switch policy {
+			case "error":
+				return counts, errors.New("memory import conflicts with an existing key")
+			case "skip":
+				counts.Skipped++
+				continue
+			case "replace":
+				counts.Replaced++
+			}
+		} else {
+			counts.Inserted++
+		}
+		if dryRun {
+			continue
+		}
+		if previous != 0 {
+			if _, err := tx.ExecContext(ctx, `UPDATE memories SET active=0 WHERE id=?`, previous); err != nil {
+				return counts, err
+			}
+		}
+		if _, err := insertMemory(ctx, tx, r, previous); err != nil {
+			return counts, err
+		}
+	}
+	if err := ctx.Err(); err != nil {
+		return counts, err
+	}
+	if dryRun {
+		return counts, nil // deferred rollback; no writes were attempted
+	}
+	return counts, tx.Commit()
+}
