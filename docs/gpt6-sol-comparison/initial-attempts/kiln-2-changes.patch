@@ -0,0 +1,325 @@
+package memory
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+)
+
+func importStore(t *testing.T) *Store {
+	t.Helper()
+	s, err := Open(filepath.Join(t.TempDir(), "memory.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := s.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	return s
+}
+
+func importRecord(id int64, key string) Record {
+	return Record{ID: id, Scope: "origin", Key: key, Kind: "fact", Text: "value", Evidence: "user", Created: 12, Supersedes: 91}
+}
+
+func importJSON(t *testing.T, records ...Record) []byte {
+	t.Helper()
+	b, err := json.Marshal(records)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return b
+}
+
+func TestImportHistoryConflictsAndDryRun(t *testing.T) {
+	ctx := context.Background()
+	s := importStore(t)
+	root := t.TempDir()
+	old, err := s.Put(ctx, Record{Scope: "destination", Key: "existing", Kind: "fact", Text: "local", Evidence: "user", Expires: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	records := []Record{importRecord(31, "new"), importRecord(22, "existing"), importRecord(8, "new"), importRecord(44, "existing")}
+	records[3].Text = "replacement"
+	records[3].Expires = time.Now().Add(time.Hour).Unix()
+	before, _ := s.Export(ctx, "destination")
+	for _, policy := range []string{"error", "skip", "replace"} {
+		counts, err := s.Import(ctx, "destination", root, records, policy, true)
+		if policy == "error" {
+			if err == nil {
+				t.Fatal("conflict accepted")
+			}
+			continue
+		}
+		if err != nil || counts.Inserted != 1 || counts.DryRun != true || counts.Replaced != map[string]int{"skip": 0, "replace": 1}[policy] || counts.Skipped != map[string]int{"skip": 1, "replace": 0}[policy] {
+			t.Fatalf("dry %s: %+v %v", policy, counts, err)
+		}
+	}
+	after, _ := s.Export(ctx, "destination")
+	if !bytes.Equal(before, after) {
+		t.Fatal("dry run mutated history")
+	}
+	for table, want := range map[string]int{"memory_search": 1, "memory_sources": 0} {
+		var n int
+		if err := s.db.QueryRow(`SELECT count(*) FROM ` + table).Scan(&n); err != nil || n != want {
+			t.Fatalf("dry run mutated %s: %d %v", table, n, err)
+		}
+	}
+	if _, err := s.Import(ctx, "destination", root, records, "error", false); err == nil {
+		t.Fatal("conflict accepted")
+	}
+	after, _ = s.Export(ctx, "destination")
+	if !bytes.Equal(before, after) {
+		t.Fatal("error mutated history")
+	}
+	counts, err := s.Import(ctx, "destination", root, records, "replace", false)
+	if err != nil || counts.Inserted != 1 || counts.Replaced != 1 {
+		t.Fatalf("%+v %v", counts, err)
+	}
+	got, err := s.Current(ctx, "destination", "existing", root)
+	if err != nil || got == nil || got.Supersedes != old || got.ID == 44 || got.Scope != "destination" || got.Created == 12 || got.Expires != records[3].Expires || got.Text != "replacement" {
+		t.Fatalf("current: %+v %v", got, err)
+	}
+	got, err = s.Current(ctx, "destination", "new", root)
+	if err != nil || got == nil || got.ID == 31 || got.Supersedes != 0 {
+		t.Fatalf("new: %+v %v", got, err)
+	}
+	exported, _ := s.Export(ctx, "destination")
+	var history []Record
+	if err := json.Unmarshal(exported, &history); err != nil || len(history) != 3 {
+		t.Fatalf("history: %s %v", exported, err)
+	}
+	found, err := s.Search(ctx, "destination", "replacement", 5, root)
+	if err != nil || len(found) != 1 {
+		t.Fatalf("search: %+v %v", found, err)
+	}
+}
