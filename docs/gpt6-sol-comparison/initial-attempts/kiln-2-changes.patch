+func TestImportValidationAndAtomicity(t *testing.T) {
+	ctx := context.Background()
+	s := importStore(t)
+	root := t.TempDir()
+	valid := importRecord(1, "ok")
+	cases := map[string][]Record{
+		"duplicate ID": {valid, valid}, "zero ID": {importRecord(0, "bad")}, "negative expiry": {func() Record { r := valid; r.Expires = -1; return r }()},
+		"empty key": {func() Record { r := valid; r.Key = " "; return r }()}, "invalid kind": {func() Record { r := valid; r.Kind = "secret"; return r }()},
+		"long text":              {func() Record { r := valid; r.Text = strings.Repeat("x", 8193); return r }()},
+		"global historical fact": {valid, func() Record { r := importRecord(2, "ok"); r.Kind = "preference"; return r }()},
+	}
+	for name, records := range cases {
+		t.Run(name, func(t *testing.T) {
+			scope := "dest"
+			if strings.HasPrefix(name, "global") {
+				scope = GlobalPreferencesScope
+			}
+			before, _ := s.Export(ctx, scope)
+			if _, err := s.Import(ctx, scope, root, records, "replace", false); err == nil {
+				t.Fatal("invalid batch accepted")
+			}
+			after, _ := s.Export(ctx, scope)
+			if !bytes.Equal(before, after) {
+				t.Fatal("partial import")
+			}
+		})
+	}
+	many := make([]Record, 1001)
+	for i := range many {
+		many[i] = importRecord(int64(i+1), "k")
+	}
+	if _, err := ParseImport(bytes.NewReader(importJSON(t, many...)), root, GlobalPreferencesScope); err == nil {
+		t.Fatal("record limit")
+	}
+	for name, data := range map[string]string{"null": "null", "object": "{}", "trailing": "[] {}", "unknown record": "[{\"id\":1,\"key\":\"k\",\"kind\":\"fact\",\"text\":\"v\",\"evidence\":\"e\",\"extra\":1}]", "null record": "[null]", "malformed": "["} {
+		t.Run(name, func(t *testing.T) {
+			if _, err := ParseImport(strings.NewReader(data), root, "dest"); err == nil {
+				t.Fatal("accepted", data)
+			}
+		})
+	}
+	if _, err := ParseImport(strings.NewReader(strings.Repeat(" ", 4<<20)+"[]"), root, "dest"); err == nil {
+		t.Fatal("oversized input")
+	}
+	if parsed, err := ParseImport(strings.NewReader("[]"), root, "dest"); err != nil || len(parsed) != 0 {
+		t.Fatalf("empty: %v %v", parsed, err)
+	}
+	cancelled, cancel := context.WithCancel(ctx)
+	cancel()
+	if _, err := s.Import(cancelled, "dest", root, []Record{valid}, "replace", false); err == nil {
+		t.Fatal("cancel accepted")
+	}
+	after, _ := s.Export(ctx, "dest")
+	if string(after) != "[]" {
+		t.Fatal("cancel wrote")
+	}
+}
