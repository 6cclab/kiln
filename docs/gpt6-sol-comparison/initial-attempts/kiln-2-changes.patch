+package cli
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/andrepato/harness/internal/memory"
+)
+
+func TestMemoryImportCommand(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	file := filepath.Join(t.TempDir(), "export.json")
+	record := memory.Record{ID: 73, Scope: "another-project", Key: "test", Kind: "preference", Text: "Never echo this credential", Evidence: "user"}
+	raw, err := json.Marshal([]memory.Record{record})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(file, raw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	call := func(args ...string) (int, string, string) {
+		t.Helper()
+		var out, stderr bytes.Buffer
+		code := MemoryImportCommand(context.Background(), args, &out, &stderr)
+		return code, out.String(), stderr.String()
+	}
+	for _, args := range [][]string{{"import"}, {"import", file, "--bogus"}, {"import", file, "extra"}, {"import", file, "--on-conflict"}, {"import", file, "--on-conflict", "invalid"}, {"import", file, "--dry-run", "--dry-run"}} {
+		code, out, diagnostic := call(args...)
+		if code == 0 || out != "" || diagnostic == "" {
+			t.Fatalf("%v: %d %q %q", args, code, out, diagnostic)
+		}
+	}
+	if code, out, diagnostic := call("global", "import", file, "--dry-run"); code != 0 || out != "{\"inserted\":1,\"replaced\":0,\"skipped\":0,\"dry_run\":true}\n" {
+		t.Fatalf("dry: %d %s %s", code, out, diagnostic)
+	}
+	if code, out, diagnostic := call("global", "import", file); code != 0 || out != "{\"inserted\":1,\"replaced\":0,\"skipped\":0,\"dry_run\":false}\n" {
+		t.Fatalf("apply: %d %s %s", code, out, diagnostic)
+	}
+	if code, out, diagnostic := call("global", "import", file); code == 0 || out != "" || strings.Contains(diagnostic, record.Text) {
+		t.Fatalf("conflict: %d %s %s", code, out, diagnostic)
+	}
+	if code, out, diagnostic := call("global", "import", file, "--on-conflict=skip"); code != 0 || !strings.Contains(out, `"skipped":1`) {
+		t.Fatalf("skip: %d %s %s", code, out, diagnostic)
+	}
+	if code, out, diagnostic := call("global", "import", file, "--on-conflict", "replace"); code != 0 || !strings.Contains(out, `"replaced":1`) {
+		t.Fatalf("replace: %d %s %s", code, out, diagnostic)
+	}
+	var projectOut, projectErr bytes.Buffer
+	if code := PersonalMemory(context.Background(), Args{Positional: []string{"export"}}, &projectOut, &projectErr); code != 0 || strings.Contains(projectOut.String(), record.Text) {
+		t.Fatalf("project leaked global: %d %s %s", code, projectOut.String(), projectErr.String())
+	}
+}
diff --git a/internal/memory/import.go b/internal/memory/import.go
new file mode 100644
index 0000000..5e74b79
--- /dev/null
+++ b/internal/memory/import.go
@@ -0,0 +1,258 @@
+package memory
+
+import (
+	"bytes"
+	"context"
+	"database/sql"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+)
+
+const maxImportBytes = 4 << 20
+
+// ErrImportConflict means at least one active destination key already exists.
+var ErrImportConflict = errors.New("memory import conflicts with an existing destination key")
+
+// ReadImportFile bounds input before decoding, including when the file grows during reading.
+func ReadImportFile(path, root, scope string) ([]Record, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, errors.New("cannot open memory import file")
+	}
+	defer f.Close()
+	return ParseImport(f, root, scope)
+}
+
+// ParseImport validates every exported version and rebinds its sources to root.
+func ParseImport(input io.Reader, root, scope string) ([]Record, error) {
+	raw, err := io.ReadAll(io.LimitReader(input, maxImportBytes+1))
+	if err != nil {
+		return nil, errors.New("cannot read memory import file")
+	}
+	if len(raw) > maxImportBytes {
+		return nil, errors.New("memory import exceeds 4 MiB")
+	}
+	if !bytes.HasPrefix(bytes.TrimSpace(raw), []byte("[")) {
+		return nil, errors.New("memory import must be a JSON array")
+	}
+	var entries []json.RawMessage
+	if err := decodeImport(raw, &entries); err != nil {
+		return nil, errors.New("invalid memory import JSON or trailing data")
+	}
+	if len(entries) > 1000 {
+		return nil, errors.New("memory import exceeds 1000 records")
+	}
+	canonical, err := filepath.EvalSymlinks(root)
+	if err != nil {
+		return nil, errors.New("cannot resolve destination project root")
+	}
+	records := make([]Record, 0, len(entries))
+	ids := make(map[int64]bool, len(entries))
+	for i, entry := range entries {
+		if !bytes.HasPrefix(bytes.TrimSpace(entry), []byte("{")) {
+			return nil, fmt.Errorf("memory import record %d must be an object", i+1)
+		}
+		var r Record
+		if err := decodeImport(entry, &r); err != nil {
+			return nil, fmt.Errorf("memory import record %d has invalid JSON fields", i+1)
+		}
+		if r.ID <= 0 || ids[r.ID] {
+			return nil, fmt.Errorf("memory import record %d has invalid or duplicate ID", i+1)
+		}
+		ids[r.ID] = true
+		r.Scope = scope
+		if err := validatePut(r); err != nil {
+			return nil, fmt.Errorf("memory import record %d: %w", i+1, err)
+		}
+		if r.Expires < 0 {
+			return nil, fmt.Errorf("memory import record %d has negative expiry", i+1)
+		}
+		if len(r.Sources) > 8 {
+			return nil, fmt.Errorf("memory import record %d exceeds eight source files", i+1)
+		}
+		// A null source entry is not a binding. Reject it even on historical rows.
+		var fields map[string]json.RawMessage
+		if err := json.Unmarshal(entry, &fields); err != nil {
+			return nil, errors.New("invalid memory import record")
+		}
+		if data, ok := fields["sources"]; ok {
+			if bytes.Equal(bytes.TrimSpace(data), []byte("null")) {
+				return nil, fmt.Errorf("memory import record %d has null sources", i+1)
+			}
+			var parts []json.RawMessage
+			if err := json.Unmarshal(data, &parts); err != nil {
+				return nil, fmt.Errorf("memory import record %d has invalid sources", i+1)
+			}
+			for _, part := range parts {
+				if !bytes.HasPrefix(bytes.TrimSpace(part), []byte("{")) {
+					return nil, fmt.Errorf("memory import record %d has invalid source", i+1)
+				}
+			}
+		}
+		for j, source := range r.Sources {
+			rebound, err := rebindImportSource(source, canonical)
+			if err != nil {
+				return nil, fmt.Errorf("memory import record %d source %d: %w", i+1, j+1, err)
+			}
+			r.Sources[j] = rebound
+		}
+		records = append(records, r)
+	}
+	return records, nil
+}
+
+func decodeImport(raw []byte, dst any) error {
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(dst); err != nil {
+		return err
+	}
+	if err := dec.Decode(new(any)); err != io.EOF {
+		return errors.New("trailing JSON")
+	}
+	return nil
+}
+
+func rebindImportSource(source Source, root string) (Source, error) {
+	invalid := func() (Source, error) { return Source{}, errors.New("invalid or stale project source binding") }
+	if !filepath.IsAbs(source.Root) || source.Path == "" || len(source.SHA256) != 64 {
+		return invalid()
+	}
+	hash, err := hex.DecodeString(source.SHA256)
+	if err != nil {
+		return invalid()
+	}
+	want := hex.EncodeToString(hash)
+	original := filepath.Clean(source.Root)
+	path := source.Path
+	if !filepath.IsAbs(path) {
+		path = filepath.Join(original, path)
+	}
+	relative, err := filepath.Rel(original, path)
+	if err != nil || relative == ".." || strings.HasPrefix(relative, ".."+string(filepath.Separator)) {
+		return invalid()
+	}
+	destination := filepath.Join(root, relative)
+	digest, err := sourceDigest(root, destination)
+	if err != nil || digest != want {
+		return invalid()
+	}
+	return Source{Root: root, Path: destination, SHA256: digest}, nil
+}
+
+// ImportCounts describes selected current keys, not historical input rows.
+type ImportCounts struct {
+	Inserted int  `json:"inserted"`
+	Replaced int  `json:"replaced"`
+	Skipped  int  `json:"skipped"`
+	DryRun   bool `json:"dry_run"`
+}
+
+// Import applies selected versions in one transaction, including conflict analysis.
+func (s *Store) Import(ctx context.Context, scope, root string, records []Record, policy string, dryRun bool) (ImportCounts, error) {
+	counts := ImportCounts{DryRun: dryRun}
+	if policy != "error" && policy != "skip" && policy != "replace" {
+		return counts, errors.New("invalid memory import conflict policy")
+	}
+	if len(records) > 1000 || scope == "" {
+		return counts, errors.New("invalid memory import batch")
+	}
+	selected := make(map[string]Record)
+	ids := make(map[int64]bool)
+	canonical, err := filepath.EvalSymlinks(root)
+	if err != nil {
+		return counts, errors.New("cannot resolve destination project root")
+	}
+	for _, r := range records {
+		r.Scope = scope
+		if r.ID <= 0 || ids[r.ID] || r.Expires < 0 || len(r.Sources) > 8 {
+			return counts, errors.New("invalid memory import record")
+		}
+		ids[r.ID] = true
+		if err := validatePut(r); err != nil {
+			return counts, err
+		}
+		for _, source := range r.Sources {
+			if source.Root != canonical || !filepath.IsAbs(source.Path) || !SourcesCurrentAt([]Source{source}, canonical) {
+				return counts, errors.New("invalid or stale project source binding")
+			}
+		}
+		if current, ok := selected[r.Key]; !ok || r.ID > current.ID {
+			selected[r.Key] = r
+		}
+	}
+	keys := make([]string, 0, len(selected))
+	for key := range selected {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return counts, err
+	}
+	defer rollback(tx)
+	for _, key := range keys {
+		r := selected[key]
+		var previous int64
+		err := tx.QueryRowContext(ctx, `SELECT id FROM memories WHERE scope=? AND key=? AND active=1`, scope, key).Scan(&previous)
+		if err != nil && !errors.Is(err, sql.ErrNoRows) {
+			return counts, err
+		}
+		if err == nil {
+			switch policy {
+			case "error":
+				return counts, ErrImportConflict
+			case "skip":
+				counts.Skipped++
+				continue
+			case "replace":
+				counts.Replaced++
+			}
+		} else {
+			counts.Inserted++
+		}
+		if dryRun {
+			continue
+		}
+		if previous != 0 {
+			if _, err := tx.ExecContext(ctx, `UPDATE memories SET active=0 WHERE id=?`, previous); err != nil {
+				return counts, err
+			}
+		}
+		res, err := tx.ExecContext(ctx, `INSERT INTO memories(scope,key,kind,text,evidence,created,expires,supersedes) VALUES(?,?,?,?,?,?,?,?)`, scope, r.Key, r.Kind, r.Text, r.Evidence, time.Now().Unix(), r.Expires, previous)
+		if err != nil {
+			return counts, err
+		}
+		id, err := res.LastInsertId()
+		if err != nil {
+			return counts, err
+		}
+		if _, err := tx.ExecContext(ctx, `INSERT INTO memory_search(rowid,text,evidence) VALUES(?,?,?)`, id, r.Key+"\n"+r.Text, r.Evidence); err != nil {
+			return counts, err
+		}
+		if len(r.Sources) > 0 {
+			raw, err := json.Marshal(r.Sources)
+			if err != nil {
+				return counts, err
+			}
+			if _, err := tx.ExecContext(ctx, `INSERT INTO memory_sources(memory_id,sources) VALUES(?,?)`, id, string(raw)); err != nil {
+				return counts, err
+			}
+		}
+	}
+	if dryRun {
+		if err := ctx.Err(); err != nil {
+			return counts, err
+		}
+		return counts, nil
+	}
+	return counts, tx.Commit()
+}
diff --git a/internal/memory/import_test.go b/internal/memory/import_test.go
