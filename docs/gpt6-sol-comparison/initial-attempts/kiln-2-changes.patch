+func TestImportSourcesReboundAndRejected(t *testing.T) {
+	ctx := context.Background()
+	s := importStore(t)
+	root := t.TempDir()
+	if err := os.WriteFile(filepath.Join(root, "file"), []byte("content"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	original := filepath.Join(string(filepath.Separator), "offline", "original")
+	sources, err := CaptureSources(root, []string{"file"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	valid := importRecord(1, "ok")
+	valid.Sources = []Source{{Root: original, Path: filepath.Join(original, "file"), SHA256: sources[0].SHA256}}
+	cases := map[string]Source{
+		"changed": {Root: original, Path: "file", SHA256: strings.Repeat("0", 64)}, "bad hash": {Root: original, Path: "file", SHA256: "not-a-hash"},
+		"unknown field": valid.Sources[0], "escape": {Root: original, Path: "../file", SHA256: sources[0].SHA256},
+		"absolute escape": {Root: original, Path: filepath.Join(root, "file"), SHA256: sources[0].SHA256},
+		"relative root":   {Root: "relative", Path: "file", SHA256: sources[0].SHA256},
+		"missing":         {Root: original, Path: "missing", SHA256: sources[0].SHA256},
+	}
+	outside := t.TempDir()
+	if err := os.WriteFile(filepath.Join(outside, "file"), []byte("content"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(root, "link")); err != nil {
+		t.Fatal(err)
+	}
+	cases["symlink escape"] = Source{Root: original, Path: "link/file", SHA256: sources[0].SHA256}
+	if err := os.Mkdir(filepath.Join(root, "directory"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	cases["directory"] = Source{Root: original, Path: "directory", SHA256: sources[0].SHA256}
+	for name, source := range cases {
+		if name == "unknown field" {
+			continue
+		}
+		t.Run(name, func(t *testing.T) {
+			historical := valid
+			historical.ID = 2
+			historical.Sources = []Source{source}
+			if _, err := ParseImport(bytes.NewReader(importJSON(t, historical, importRecord(3, "ok"))), root, "dest"); err == nil {
+				t.Fatal("bad historical source accepted")
+			}
+		})
+	}
+	raw := strings.Replace(string(importJSON(t, valid)), `"sha256":`, `"extra":1,"sha256":`, 1)
+	if _, err := ParseImport(strings.NewReader(raw), root, "dest"); err == nil {
+		t.Fatal("unknown source field")
+	}
+	valid.Sources[0].Path = "file"
+	parsed, err := ParseImport(bytes.NewReader(importJSON(t, valid)), root, "dest")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(parsed[0].Sources, sources) {
+		t.Fatalf("rebound: %+v vs %+v", parsed[0].Sources, sources)
+	}
+	if _, err := s.Import(ctx, "dest", root, parsed, "error", false); err != nil {
+		t.Fatal(err)
+	}
+	found, err := s.Search(ctx, "dest", "value", 5, root)
+	if err != nil || len(found) != 1 {
+		t.Fatalf("search: %v %v", found, err)
+	}
+	nine := valid
+	nine.ID = 4
+	nine.Sources = make([]Source, 9)
+	if _, err := ParseImport(bytes.NewReader(importJSON(t, nine)), root, "dest"); err == nil {
+		t.Fatal("nine sources")
+	}
+	if _, err := ParseImport(bytes.NewReader(importJSON(t, valid)), root, GlobalPreferencesScope); err == nil {
+		t.Fatal("global sources")
+	}
+}
