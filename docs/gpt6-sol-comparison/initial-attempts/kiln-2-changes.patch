+func TestMemoryImportDispatch(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	file := filepath.Join(t.TempDir(), "import.json")
+	if err := os.WriteFile(file, []byte(`[{"id":1,"scope":"elsewhere","key":"k","kind":"preference","text":"v","evidence":"user","created":10}]`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if code := run([]string{"memory", "global", "import", file, "--dry-run"}); code != 0 {
+		t.Fatalf("dry run: %d", code)
+	}
+	if _, err := os.Stat(filepath.Join(home, ".kiln", "memory.db")); err != nil {
+		t.Fatal(err)
+	}
+	if code := run([]string{"memory", "global", "import", file, "--on-conflict", "skip"}); code != 0 {
