@@ -0,0 +1,99 @@
+package cli
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/andrepato/harness/internal/diag"
+	"github.com/andrepato/harness/internal/memory"
+)
+
+// MemoryImportCommand is a local management operation; it never starts a model.
+func MemoryImportCommand(ctx context.Context, args []string, out, stderr io.Writer) int {
+	usage := "usage: kiln memory [global] import <file> [--dry-run] [--on-conflict error|skip|replace]"
+	global := false
+	if len(args) > 0 && args[0] == "global" {
+		global = true
+		args = args[1:]
+	}
+	if len(args) < 2 || args[0] != "import" || args[1] == "" || strings.HasPrefix(args[1], "-") {
+		fmt.Fprintln(stderr, usage)
+		return 2
+	}
+	file := args[1]
+	dryRun := false
+	policy := "error"
+	policySet := false
+	for i := 2; i < len(args); i++ {
+		token := args[i]
+		switch {
+		case token == "--dry-run" && !dryRun:
+			dryRun = true
+		case token == "--on-conflict" && !policySet:
+			i++
+			if i >= len(args) || strings.HasPrefix(args[i], "-") {
+				fmt.Fprintln(stderr, "memory import: missing conflict policy")
+				return 2
+			}
+			policy = args[i]
+			policySet = true
+		case strings.HasPrefix(token, "--on-conflict=") && !policySet:
+			policy = strings.TrimPrefix(token, "--on-conflict=")
+			policySet = true
+		default:
+			fmt.Fprintln(stderr, usage)
+			return 2
+		}
+	}
+	if policy != "error" && policy != "skip" && policy != "replace" {
+		fmt.Fprintln(stderr, "memory import: invalid conflict policy (use error, skip, or replace)")
+		return 2
+	}
+	cwd, err := os.Getwd()
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	home, err := os.UserHomeDir()
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	scope := memoryScope(cwd)
+	if global {
+		scope = memory.GlobalPreferencesScope
+	}
+	records, err := memory.ReadImportFile(file, memoryProjectRoot(cwd), scope)
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	store, err := memory.Open(filepath.Join(home, ".kiln", "memory.db"))
+	if err != nil {
+		fmt.Fprintln(stderr, "memory import: cannot open private database")
+		return 1
+	}
+	defer diag.Close(store)
+	counts, err := store.Import(ctx, scope, memoryProjectRoot(cwd), records, policy, dryRun)
+	if err != nil {
+		if errors.Is(err, memory.ErrImportConflict) {
+			writeDiagnostic(stderr, err)
+		} else if errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded) {
+			fmt.Fprintln(stderr, "memory import: cancelled")
+		} else {
+			fmt.Fprintln(stderr, "memory import: validation or database operation failed")
+		}
+		return 1
+	}
+	if err := json.NewEncoder(out).Encode(counts); err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	return 0
+}
