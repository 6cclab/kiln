+func TestImportTransactionPoliciesAndRollback(t *testing.T) {
+	ctx := context.Background()
+	s, err := Open(filepath.Join(t.TempDir(), "memory.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := s.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	old, err := s.Put(ctx, Record{Scope: "dest", Key: "key", Kind: "fact", Text: "local", Evidence: "local", Expires: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	root := t.TempDir()
+	if err := os.WriteFile(filepath.Join(root, "evidence"), []byte("contents"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	sources, err := CaptureSources(root, []string{"evidence"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	input := []Record{importRecord(99, "new", "new value"), importRecord(100, "key", "imported")}
+	input[0].Sources = sources
+	before, err := s.Export(ctx, "dest")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, policy := range []string{"error", "skip", "replace"} {
+		counts, err := s.Import(ctx, "dest", input, policy, true)
+		if policy == "error" && err == nil || policy != "error" && err != nil {
+			t.Fatalf("dry run %s: %+v %v", policy, counts, err)
+		}
+		if policy == "skip" && (counts.Inserted != 1 || counts.Skipped != 1) || policy == "replace" && (counts.Inserted != 1 || counts.Replaced != 1) {
+			t.Fatalf("dry run %s: %+v", policy, counts)
+		}
+		after, err := s.Export(ctx, "dest")
+		if err != nil || !bytes.Equal(before, after) {
+			t.Fatalf("dry run changed export: %s %v", after, err)
+		}
+	}
+	if _, err := s.Import(ctx, "dest", input, "error", false); err == nil {
+		t.Fatal("conflict accepted")
+	}
+	if got, _ := s.Export(ctx, "dest"); !bytes.Equal(before, got) {
+		t.Fatal("partial conflict write")
+	}
+	// Force the second search insert to fail after the first key was inserted.
+	if _, err := s.db.Exec(`CREATE TRIGGER fail_import BEFORE INSERT ON memories WHEN new.key='key' BEGIN SELECT RAISE(ABORT, 'no'); END`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.Import(ctx, "dest", input, "replace", false); err == nil {
+		t.Fatal("write failure accepted")
+	}
+	if got, _ := s.Export(ctx, "dest"); !bytes.Equal(before, got) {
+		t.Fatal("partial write survived rollback")
+	}
+	for _, table := range []string{"memories", "memory_search", "memory_sources"} {
+		var count int
+		if err := s.db.QueryRow("SELECT COUNT(*) FROM " + table).Scan(&count); err != nil || count != map[string]int{"memories": 1, "memory_search": 1, "memory_sources": 0}[table] {
+			t.Fatalf("rollback left %s entries: %d %v", table, count, err)
+		}
+	}
+	if _, err := s.db.Exec(`DROP TRIGGER fail_import`); err != nil {
+		t.Fatal(err)
+	}
+	cancelled, cancel := context.WithCancel(ctx)
+	cancel()
+	if _, err := s.Import(cancelled, "dest", input, "replace", false); err == nil {
+		t.Fatal("cancel accepted")
+	}
+	counts, err := s.Import(ctx, "dest", input, "replace", false)
+	if err != nil || counts.Inserted != 1 || counts.Replaced != 1 || counts.DryRun {
+		t.Fatalf("replace: %+v %v", counts, err)
+	}
+	current, err := s.Current(ctx, "dest", "key", "")
+	if err != nil || current == nil || current.Supersedes != old || current.ID == 100 || current.Created < time.Now().Add(-time.Minute).Unix() {
+		t.Fatalf("lineage: %+v %v", current, err)
+	}
+	results, err := s.Search(ctx, "dest", "imported", 5)
+	if err != nil || len(results) != 1 {
+		t.Fatalf("search: %+v %v", results, err)
+	}
+	history, err := s.Export(ctx, "dest")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var rows []Record
+	if err := json.Unmarshal(history, &rows); err != nil || len(rows) != 3 {
+		t.Fatalf("history: %s %v", history, err)
+	}
+}
