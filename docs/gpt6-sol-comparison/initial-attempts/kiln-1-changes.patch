@@ -0,0 +1,98 @@
+package cli
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/andrepato/harness/internal/diag"
+	"github.com/andrepato/harness/internal/memory"
+)
+
+// MemoryImportCommand is a local management command, independent of model setup.
+func MemoryImportCommand(ctx context.Context, argv []string, out, stderr io.Writer) int {
+	usage := "usage: kiln memory [global] import <file> [--dry-run] [--on-conflict error|skip|replace]"
+	global := false
+	if len(argv) > 0 && argv[0] == "global" {
+		global = true
+		argv = argv[1:]
+	}
+	if len(argv) < 2 || argv[0] != "import" || argv[1] == "" || strings.HasPrefix(argv[1], "-") {
+		writeDiagnostic(stderr, usage)
+		return 2
+	}
+	filename := argv[1]
+	policy, dryRun := "error", false
+	seenPolicy, seenDryRun := false, false
+	for i := 2; i < len(argv); i++ {
+		arg := argv[i]
+		switch {
+		case arg == "--dry-run" && !seenDryRun:
+			dryRun, seenDryRun = true, true
+		case (arg == "--on-conflict" || strings.HasPrefix(arg, "--on-conflict=")) && !seenPolicy:
+			seenPolicy = true
+			if arg == "--on-conflict" {
+				i++
+				if i >= len(argv) {
+					writeDiagnostic(stderr, usage)
+					return 2
+				}
+				policy = argv[i]
+			} else {
+				policy = strings.TrimPrefix(arg, "--on-conflict=")
+			}
+			if policy != "error" && policy != "skip" && policy != "replace" {
+				writeDiagnostic(stderr, "invalid --on-conflict policy (use error, skip or replace)")
+				return 2
+			}
+		default:
+			writeDiagnostic(stderr, usage)
+			return 2
+		}
+	}
+	cwd, err := os.Getwd()
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	home, err := os.UserHomeDir()
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	file, err := os.Open(filename)
+	if err != nil {
+		writeDiagnostic(stderr, fmt.Errorf("memory import: cannot open input: %w", err))
+		return 1
+	}
+	defer diag.Close(file)
+	scope := memoryScope(cwd)
+	if global {
+		scope = memory.GlobalPreferencesScope
+	}
+	records, err := memory.ReadImport(file, scope, memoryProjectRoot(cwd))
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	s, err := memory.Open(filepath.Join(home, ".kiln", "memory.db"))
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	defer diag.Close(s)
+	counts, err := s.Import(ctx, scope, records, policy, dryRun)
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	if err := json.NewEncoder(out).Encode(counts); err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	return 0
+}
diff --git a/internal/cli/memory_import_test.go b/internal/cli/memory_import_test.go
