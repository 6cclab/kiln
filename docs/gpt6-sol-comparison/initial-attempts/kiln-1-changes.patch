+++ b/internal/cli/memory_import_test.go
@@ -0,0 +1,75 @@
+package cli
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/andrepato/harness/internal/memory"
+)
+
+func TestMemoryImportCommandFlagsAndIsolation(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	file := filepath.Join(t.TempDir(), "export.json")
+	if err := os.WriteFile(file, []byte(`[{"id":3,"scope":"user:preferences","key":"runner","kind":"preference","text":"use tests","evidence":"user","created":1}]`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	call := func(argv ...string) (int, string, string) {
+		t.Helper()
+		var out, stderr bytes.Buffer
+		code := MemoryImportCommand(context.Background(), argv, &out, &stderr)
+		return code, out.String(), stderr.String()
+	}
+	for _, argv := range [][]string{
+		{"import"}, {"import", "--dry-run"}, {"import", file, "extra"},
+		{"import", file, "--unknown"}, {"import", file, "--on-conflict"},
+		{"import", file, "--on-conflict="}, {"import", file, "--on-conflict", "--dry-run"},
+		{"import", file, "--on-conflict", "merge"}, {"import", file, "--dry-run", "--dry-run"},
+	} {
+		code, out, stderr := call(argv...)
+		if code == 0 || out != "" || stderr == "" {
+			t.Fatalf("%q: code %d stdout %q stderr %q", argv, code, out, stderr)
+		}
+	}
+	if _, err := os.Stat(filepath.Join(home, ".kiln")); !os.IsNotExist(err) {
+		t.Fatalf("invalid arguments created database: %v", err)
+	}
+	code, out, stderr := call("import", file, "--dry-run", "--on-conflict=replace")
+	if code != 0 || out != "{\"inserted\":1,\"replaced\":0,\"skipped\":0,\"dry_run\":true}\n" {
+		t.Fatalf("dry run: %d %s %s", code, out, stderr)
+	}
+	code, out, stderr = call("global", "import", file)
+	if code != 0 || !strings.Contains(out, `"inserted":1`) {
+		t.Fatalf("global import: %d %s %s", code, out, stderr)
+	}
+	code, out, stderr = call("global", "import", file)
+	if code == 0 || out != "" || !strings.Contains(stderr, "conflict") {
+		t.Fatalf("default conflict: %d %s %s", code, out, stderr)
+	}
+	code, out, stderr = call("global", "import", file, "--on-conflict", "skip")
+	if code != 0 || !strings.Contains(out, `"skipped":1`) {
+		t.Fatalf("skip: %d %s %s", code, out, stderr)
+	}
+	code, out, stderr = call("import", file)
+	if code != 0 || !strings.Contains(out, `"inserted":1`) {
+		t.Fatalf("project isolation: %d %s %s", code, out, stderr)
+	}
+	s, err := memory.Open(filepath.Join(home, ".kiln", "memory.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	data, err := s.Export(context.Background(), memory.GlobalPreferencesScope)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var rows []memory.Record
+	if err := json.Unmarshal(data, &rows); err != nil || len(rows) != 1 || rows[0].Scope != memory.GlobalPreferencesScope {
+		t.Fatalf("global export: %s %v", data, err)
+	}
+}
diff --git a/internal/memory/import.go b/internal/memory/import.go
new file mode 100644
index 0000000..19e020a
--- /dev/null
+++ b/internal/memory/import.go
@@ -0,0 +1,193 @@
+package memory
+
+import (
+	"bytes"
+	"context"
+	"database/sql"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+const maxImportBytes = 4 << 20
+
+// ReadImport validates an export, including every historical version, and
+// returns only the highest-ID version of each key, bound to this destination.
+func ReadImport(input io.Reader, scope, root string) ([]Record, error) {
+	data, err := io.ReadAll(io.LimitReader(input, maxImportBytes+1))
+	if err != nil {
+		return nil, fmt.Errorf("read import: %w", err)
+	}
+	if len(data) > maxImportBytes {
+		return nil, errors.New("memory import exceeds 4 MiB")
+	}
+	if trimmed := bytes.TrimSpace(data); len(trimmed) == 0 || trimmed[0] != '[' {
+		return nil, errors.New("memory import must be a JSON array")
+	}
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.DisallowUnknownFields()
+	var records []Record
+	if err := dec.Decode(&records); err != nil {
+		// Decoder errors can contain attacker-controlled field names; never
+		// print untrusted export content in a management-command diagnostic.
+		return nil, errors.New("invalid memory import JSON or unknown record/source field")
+	}
+	var extra any
+	if err := dec.Decode(&extra); err != io.EOF {
+		return nil, errors.New("memory import has trailing JSON")
+	}
+	if len(records) > 1000 {
+		return nil, errors.New("memory import exceeds 1000 records")
+	}
+	selected := make(map[string]Record)
+	ids := make(map[int64]bool)
+	for i, r := range records {
+		// Imported identity and lineage are never reused at the destination.
+		r.Scope = scope
+		r.Created = 0
+		r.Supersedes = 0
+		if err := validatePut(r); err != nil {
+			return nil, fmt.Errorf("memory import record %d: %w", i+1, err)
+		}
+		if r.ID <= 0 || ids[r.ID] {
+			return nil, fmt.Errorf("memory import record %d: ID must be positive and unique", i+1)
+		}
+		ids[r.ID] = true
+		if r.Expires < 0 {
+			return nil, fmt.Errorf("memory import record %d: negative expiry", i+1)
+		}
+		if len(r.Sources) > 8 {
+			return nil, fmt.Errorf("memory import record %d: at most eight sources allowed", i+1)
+		}
+		for j, source := range r.Sources {
+			bound, err := rebindSource(source, root)
+			if err != nil {
+				return nil, fmt.Errorf("memory import record %d source %d: %w", i+1, j+1, err)
+			}
+			r.Sources[j] = bound
+		}
+		if old, ok := selected[r.Key]; !ok || r.ID > old.ID {
+			selected[r.Key] = r
+		}
+	}
+	out := make([]Record, 0, len(selected))
+	for _, r := range records {
+		if selected[r.Key].ID == r.ID {
+			out = append(out, selected[r.Key])
+		}
+	}
+	return out, nil
+}
+
+func rebindSource(source Source, root string) (Source, error) {
+	if !filepath.IsAbs(source.Root) || source.Path == "" || len(source.SHA256) != 64 {
+		return Source{}, errors.New("invalid source binding")
+	}
+	if _, err := hex.DecodeString(source.SHA256); err != nil {
+		return Source{}, errors.New("invalid source hash")
+	}
+	original := filepath.Clean(source.Root)
+	path := source.Path
+	if !filepath.IsAbs(path) {
+		path = filepath.Join(original, path)
+	}
+	rel, err := filepath.Rel(original, path)
+	if err != nil || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		return Source{}, errors.New("source escapes original root")
+	}
+	canonical, err := filepath.EvalSymlinks(root)
+	if err != nil {
+		return Source{}, errors.New("destination project root unavailable")
+	}
+	bound := filepath.Join(canonical, rel)
+	digest, err := sourceDigest(canonical, bound)
+	if err != nil || digest != strings.ToLower(source.SHA256) {
+		return Source{}, errors.New("destination source missing, changed or unsafe")
+	}
+	return Source{Root: canonical, Path: bound, SHA256: digest}, nil
+}
+
+// ImportCounts reports the selected keys affected by an import.
+type ImportCounts struct {
+	Inserted int  `json:"inserted"`
+	Replaced int  `json:"replaced"`
+	Skipped  int  `json:"skipped"`
+	DryRun   bool `json:"dry_run"`
+}
+
+// Import applies selected current keys as one transaction. Conflicts include
+// active records even if they are expired or their sources are stale.
+func (s *Store) Import(ctx context.Context, scope string, records []Record, policy string, dryRun bool) (ImportCounts, error) {
+	counts := ImportCounts{DryRun: dryRun}
+	if policy != "error" && policy != "skip" && policy != "replace" {
+		return counts, errors.New("invalid memory import conflict policy")
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return counts, errors.New("memory import database transaction failed")
+	}
+	defer rollback(tx)
+	for _, r := range records {
+		var previous int64
+		err := tx.QueryRowContext(ctx, `SELECT id FROM memories WHERE scope=? AND key=? AND active=1`, scope, r.Key).Scan(&previous)
+		if err != nil && !errors.Is(err, sql.ErrNoRows) {
+			return counts, errors.New("memory import conflict check failed")
+		}
+		if previous != 0 {
+			switch policy {
+			case "error":
+				return counts, errors.New("memory import conflicts with existing destination keys")
+			case "skip":
+				counts.Skipped++
+				continue
+			case "replace":
+				counts.Replaced++
+			}
+		} else {
+			counts.Inserted++
+		}
+		if dryRun {
+			continue
+		}
+		if previous != 0 {
+			if _, err := tx.ExecContext(ctx, `UPDATE memories SET active=0 WHERE id=?`, previous); err != nil {
+				return counts, errors.New("memory import database write failed")
+			}
+		}
+		res, err := tx.ExecContext(ctx, `INSERT INTO memories(scope,key,kind,text,evidence,created,expires,supersedes) VALUES(?,?,?,?,?,?,?,?)`, scope, r.Key, r.Kind, r.Text, r.Evidence, time.Now().Unix(), r.Expires, previous)
+		if err != nil {
+			return counts, errors.New("memory import database write failed")
+		}
+		id, err := res.LastInsertId()
+		if err != nil {
+			return counts, errors.New("memory import database write failed")
+		}
+		if _, err := tx.ExecContext(ctx, `INSERT INTO memory_search(rowid,text,evidence) VALUES(?,?,?)`, id, r.Key+"\n"+r.Text, r.Evidence); err != nil {
+			return counts, errors.New("memory import database write failed")
+		}
+		if len(r.Sources) > 0 {
+			raw, err := json.Marshal(r.Sources)
+			if err != nil {
+				return counts, errors.New("memory import source encoding failed")
+			}
+			if _, err := tx.ExecContext(ctx, `INSERT INTO memory_sources(memory_id,sources) VALUES(?,?)`, id, string(raw)); err != nil {
+				return counts, errors.New("memory import database write failed")
+			}
+		}
+	}
+	if err := ctx.Err(); err != nil {
+		return counts, err
+	}
+	if dryRun {
+		return counts, nil
+	}
+	if err := tx.Commit(); err != nil {
+		return counts, errors.New("memory import database commit failed")
+	}
+	return counts, nil
+}
diff --git a/internal/memory/import_test.go b/internal/memory/import_test.go
