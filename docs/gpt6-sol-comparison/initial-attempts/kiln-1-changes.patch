+++ b/internal/memory/import_test.go
@@ -0,0 +1,255 @@
+package memory
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+)
+
+func importRecord(id int64, key, text string) Record {
+	return Record{ID: id, Scope: "/old/project", Key: key, Kind: "fact", Text: text, Evidence: "observed", Created: 1, Supersedes: 99}
+}
+
+func importJSON(t *testing.T, records []Record) []byte {
+	t.Helper()
+	data, err := json.Marshal(records)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return data
+}
+
+func TestReadImportRejectsInvalidHistory(t *testing.T) {
+	root := t.TempDir()
+	valid := importRecord(1, "key", "value")
+	cases := map[string][]byte{
+		"null": []byte(`null`), "object": []byte(`{}`), "trailing": []byte(`[] true`),
+		"malformed": []byte(`[{`), "unknown record": []byte(`[ {"id":1,"secret":"hidden"} ]`),
+		"unknown source":       []byte(`[ {"id":1,"scope":"old","key":"key","kind":"fact","text":"value","evidence":"yes","sources":[{"root":"/old","path":"a","sha256":"00","secret":"hidden"}]} ]`),
+		"duplicate IDs":        importJSON(t, []Record{valid, valid}),
+		"zero ID":              importJSON(t, []Record{importRecord(0, "key", "value")}),
+		"negative expiry":      importJSON(t, []Record{func() Record { r := valid; r.Expires = -1; return r }()}),
+		"bad historical kind":  importJSON(t, []Record{func() Record { r := valid; r.Kind = "bad"; return r }(), importRecord(2, "key", "latest")}),
+		"bad historical field": importJSON(t, []Record{func() Record { r := valid; r.Text = strings.Repeat("x", 8193); return r }(), importRecord(2, "key", "latest")}),
+		"too many": importJSON(t, func() []Record {
+			r := make([]Record, 1001)
+			for i := range r {
+				r[i] = importRecord(int64(i+1), "k", "value")
+			}
+			return r
+		}()),
+		"too large": bytes.Repeat([]byte(" "), maxImportBytes+1),
+	}
+	for name, data := range cases {
+		t.Run(name, func(t *testing.T) {
+			if _, err := ReadImport(bytes.NewReader(data), "destination", root); err == nil {
+				t.Fatal("invalid input accepted")
+			}
+		})
+	}
+	if got, err := ReadImport(strings.NewReader("[]"), "destination", root); err != nil || len(got) != 0 {
+		t.Fatalf("empty array: %+v %v", got, err)
+	}
+	historical := importRecord(9, "key", "older")
+	latest := importRecord(2, "key", "newer in file")
+	got, err := ReadImport(bytes.NewReader(importJSON(t, []Record{historical, latest})), "destination", root)
+	if err != nil || len(got) != 1 || got[0].Text != "older" || got[0].Scope != "destination" || got[0].Supersedes != 0 || got[0].Created != 0 {
+		t.Fatalf("highest input ID and destination identity: %+v %v", got, err)
+	}
+}
+
+func TestReadImportSourcesAndGlobal(t *testing.T) {
+	root := t.TempDir()
+	if err := os.WriteFile(filepath.Join(root, "evidence"), []byte("contents"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	bound, err := CaptureSources(root, []string{"evidence"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	original := "/old/machine/project"
+	record := importRecord(1, "key", "text")
+	record.Sources = []Source{{Root: original, Path: filepath.Join(original, "evidence"), SHA256: bound[0].SHA256}}
+	read := func(r Record, scope string) ([]Record, error) {
+		return ReadImport(bytes.NewReader(importJSON(t, []Record{r})), scope, root)
+	}
+	got, err := read(record, "destination")
+	if err != nil || !reflect.DeepEqual(got[0].Sources, bound) {
+		t.Fatalf("rebound source: %+v %v", got, err)
+	}
+	record.Sources[0].Path = "evidence"
+	if _, err := read(record, "destination"); err != nil {
+		t.Fatalf("relative path: %v", err)
+	}
+	cases := map[string]Source{
+		"outside":         {Root: original, Path: "/other/evidence", SHA256: bound[0].SHA256},
+		"relative escape": {Root: original, Path: "../evidence", SHA256: bound[0].SHA256},
+		"relative root":   {Root: "relative", Path: "evidence", SHA256: bound[0].SHA256},
+		"bad hash":        {Root: original, Path: "evidence", SHA256: strings.Repeat("z", 64)},
+		"changed hash":    {Root: original, Path: "evidence", SHA256: strings.Repeat("0", 64)},
+		"missing":         {Root: original, Path: "missing", SHA256: bound[0].SHA256},
+	}
+	for name, source := range cases {
+		t.Run(name, func(t *testing.T) {
+			r := record
+			r.Sources = []Source{source}
+			if _, err := read(r, "destination"); err == nil {
+				t.Fatal("unsafe source accepted")
+			}
+		})
+	}
+	tooMany := record
+	tooMany.Sources = make([]Source, 9)
+	if _, err := read(tooMany, "destination"); err == nil {
+		t.Fatal("nine sources accepted")
+	}
+	stale := record
+	stale.Sources = []Source{cases["changed hash"]}
+	newer := importRecord(2, "key", "latest")
+	if _, err := ReadImport(bytes.NewReader(importJSON(t, []Record{stale, newer})), "destination", root); err == nil {
+		t.Fatal("stale historical source accepted")
+	}
+	if err := os.Mkdir(filepath.Join(root, "directory"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := read(Record{ID: 1, Key: "key", Kind: "fact", Text: "text", Evidence: "yes", Sources: []Source{{Root: original, Path: "directory", SHA256: bound[0].SHA256}}}, "destination"); err == nil {
+		t.Fatal("directory source accepted")
+	}
+	if err := os.WriteFile(filepath.Join(root, "large"), make([]byte, (1<<20)+1), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := read(Record{ID: 1, Key: "key", Kind: "fact", Text: "text", Evidence: "yes", Sources: []Source{{Root: original, Path: "large", SHA256: bound[0].SHA256}}}, "destination"); err == nil {
+		t.Fatal("oversized source accepted")
+	}
+	outside := filepath.Join(t.TempDir(), "evidence")
+	if err := os.WriteFile(outside, []byte("contents"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(root, "link")); err != nil {
+		t.Fatal(err)
+	}
+	r := record
+	r.Sources = []Source{{Root: original, Path: "link", SHA256: bound[0].SHA256}}
+	if _, err := read(r, "destination"); err == nil {
+		t.Fatal("symlink escape accepted")
+	}
+	r = record
+	r.Sources = []Source{{Root: original, Path: "evidence", SHA256: bound[0].SHA256}}
+	if _, err := read(r, GlobalPreferencesScope); err == nil {
+		t.Fatal("global source accepted")
+	}
+	r = importRecord(1, "key", "text")
+	r.Kind = "fact"
+	if _, err := read(r, GlobalPreferencesScope); err == nil {
+		t.Fatal("global fact accepted")
+	}
+	r.Kind = "preference"
+	if _, err := read(r, GlobalPreferencesScope); err != nil {
+		t.Fatalf("global preference: %v", err)
+	}
+	// Historical global violations must be rejected even if a later ID is valid.
+	data := importJSON(t, []Record{record, func() Record { r := r; r.ID = 2; return r }()})
+	if _, err := ReadImport(bytes.NewReader(data), GlobalPreferencesScope, root); err == nil {
+		t.Fatal("historical global source accepted")
+	}
+}
