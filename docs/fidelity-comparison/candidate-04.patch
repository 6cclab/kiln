+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	records, err := memory.DecodeExport(data)
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+
+	cwd, err := os.Getwd()
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	home, err := os.UserHomeDir()
