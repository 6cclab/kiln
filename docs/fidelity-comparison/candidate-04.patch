+package memory
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func openStore(t *testing.T) *Store {
+	t.Helper()
+	s, err := Open(filepath.Join(t.TempDir(), "memory.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := s.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	return s
+}
+
+func mustImport(t *testing.T, s *Store, scope, root string, recs []Record, policy string, dry bool) ImportResult {
+	t.Helper()
+	res, err := s.Import(context.Background(), scope, root, recs, policy, dry)
+	if err != nil {
+		t.Fatalf("import: %v", err)
+	}
+	return res
+}
+
+func TestDecodeExportRejectsBadInput(t *testing.T) {
+	for name, data := range map[string]string{
+		"null":          `null`,
+		"object":        `{}`,
+		"number":        `5`,
+		"empty":         ``,
+		"malformed":     `[{"id":1,`,
+		"trailing":      `[]{}`,
+		"trailingArray": `[{"id":1,"scope":"a","key":"k","kind":"fact","text":"t","evidence":"e"}] 7`,
+		"unknownField":  `[{"id":1,"scope":"a","key":"k","kind":"fact","text":"t","evidence":"e","bogus":1}]`,
+	} {
+		if _, err := DecodeExport([]byte(data)); err == nil {
+			t.Errorf("%s: expected error", name)
+		}
+	}
+	recs, err := DecodeExport([]byte(`  []  `))
+	if err != nil || len(recs) != 0 {
+		t.Fatalf("empty array should be valid: %v %v", recs, err)
+	}
+}
+
+func TestDecodeExportRejectsUnknownSourceField(t *testing.T) {
+	data := `[{"id":1,"scope":"a","key":"k","kind":"fact","text":"t","evidence":"e","sources":[{"root":"/r","path":"/r/p","sha256":"x","extra":1}]}]`
+	if _, err := DecodeExport([]byte(data)); err == nil {
+		t.Fatal("expected unknown source field to be rejected")
+	}
+}
+
+func TestDecodeExportRejectsTooManyRecords(t *testing.T) {
+	var b strings.Builder
+	b.WriteByte('[')
+	for i := 0; i < 1001; i++ {
+		if i > 0 {
+			b.WriteByte(',')
+		}
+		b.WriteString(`{"id":1,"scope":"a","key":"k","kind":"fact","text":"t","evidence":"e"}`)
+	}
+	b.WriteByte(']')
+	if _, err := DecodeExport([]byte(b.String())); err == nil {
+		t.Fatal("expected >1000 records to be rejected")
+	}
+}
+
+func TestImportRoundTripSelectsLatestVersion(t *testing.T) {
+	src := openStore(t)
+	ctx := context.Background()
+	if _, err := src.Put(ctx, Record{Scope: "proj", Key: "runner", Kind: "preference", Text: "go test", Evidence: "user"}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := src.Put(ctx, Record{Scope: "proj", Key: "runner", Kind: "preference", Text: "make check", Evidence: "correction"}); err != nil {
+		t.Fatal(err)
+	}
+	data, err := src.Export(ctx, "proj")
+	if err != nil {
+		t.Fatal(err)
+	}
+	recs, err := DecodeExport(data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	dst := openStore(t)
+	res := mustImport(t, dst, "dest", "", recs, ImportPolicyError, false)
+	if res.Inserted != 1 || res.Replaced != 0 || res.Skipped != 0 {
+		t.Fatalf("counts: %+v", res)
+	}
+	cur, err := dst.Current(ctx, "dest", "runner", "")
+	if err != nil || cur == nil {
+		t.Fatalf("current: %v %v", cur, err)
+	}
+	if cur.Text != "make check" {
+		t.Fatalf("expected latest version, got %q", cur.Text)
+	}
+	if cur.Supersedes != 0 {
+		t.Fatalf("new key should not supersede a destination record: %d", cur.Supersedes)
+	}
+}
+
+func TestImportRejectsBadIDs(t *testing.T) {
+	s := openStore(t)
+	base := Record{ID: 1, Key: "k", Kind: "fact", Text: "t", Evidence: "e"}
+	// non-positive
+	bad := base
+	bad.ID = 0
+	if _, err := s.Import(context.Background(), "dest", "", []Record{bad}, ImportPolicyError, false); err == nil {
+		t.Error("expected non-positive id rejected")
+	}
+	// duplicate / tie
+	a := base
+	b := base
+	b.Text = "u"
+	if _, err := s.Import(context.Background(), "dest", "", []Record{a, b}, ImportPolicyError, false); err == nil {
+		t.Error("expected duplicate id rejected")
+	}
+}
+
+func TestImportEnforcesFieldLimits(t *testing.T) {
+	s := openStore(t)
+	cases := []Record{
+		{ID: 1, Key: "k", Kind: "fact", Text: "t", Evidence: ""},
+		{ID: 1, Key: "k", Kind: "nope", Text: "t", Evidence: "e"},
+		{ID: 1, Key: "k", Kind: "fact", Text: "t", Evidence: "e", Expires: -1},
+		{ID: 1, Key: strings.Repeat("x", 257), Kind: "fact", Text: "t", Evidence: "e"},
+	}
+	for i, r := range cases {
+		if _, err := s.Import(context.Background(), "dest", "", []Record{r}, ImportPolicyError, false); err == nil {
+			t.Errorf("case %d: expected rejection", i)
+		}
+	}
+}
+
+func TestImportGlobalPreferencesOnly(t *testing.T) {
+	s := openStore(t)
+	// A historical non-preference record must reject the whole import even
+	// though it is not the selected current version.
+	recs := []Record{
+		{ID: 1, Key: "style", Kind: "observation", Text: "old", Evidence: "e"},
+		{ID: 2, Key: "style", Kind: "preference", Text: "new", Evidence: "e"},
+	}
+	if _, err := s.Import(context.Background(), GlobalPreferencesScope, "", recs, ImportPolicyError, false); err == nil {
+		t.Fatal("expected historical non-preference to be rejected for global import")
+	}
+	ok := []Record{{ID: 3, Key: "style", Kind: "preference", Text: "new", Evidence: "e"}}
+	res := mustImport(t, s, GlobalPreferencesScope, "", ok, ImportPolicyError, false)
+	if res.Inserted != 1 {
+		t.Fatalf("counts: %+v", res)
+	}
+}
+
+func TestImportGlobalRejectsSources(t *testing.T) {
+	s := openStore(t)
+	recs := []Record{{ID: 1, Key: "style", Kind: "preference", Text: "t", Evidence: "e", Sources: []Source{{Root: "/r", Path: "/r/p", SHA256: strings.Repeat("a", 64)}}}}
+	if _, err := s.Import(context.Background(), GlobalPreferencesScope, "", recs, ImportPolicyError, false); err == nil {
+		t.Fatal("expected global import to reject sourced records")
+	}
+}
+
+func TestImportRebindsAndVerifiesSources(t *testing.T) {
+	origin := "/originalmachine/repo"
+	dst := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(dst, "pkg"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(dst, "pkg", "config.txt")
+	if err := os.WriteFile(path, []byte("content"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	// Capture the hash via the destination so it is correct.
+	sources, err := CaptureSources(dst, []string{"pkg/config.txt"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	digest := sources[0].SHA256
+	// The exported source records the ORIGINAL machine's root/path.
+	rec := Record{ID: 1, Key: "cfg", Kind: "fact", Text: "t", Evidence: "e", Sources: []Source{{Root: origin, Path: origin + "/pkg/config.txt", SHA256: digest}}}
+
+	s := openStore(t)
+	root := canonicalRoot(t, dst)
+	res := mustImport(t, s, "dest", root, []Record{rec}, ImportPolicyError, false)
+	if res.Inserted != 1 {
+		t.Fatalf("counts: %+v", res)
+	}
+	cur, err := s.Current(context.Background(), "dest", "cfg", root)
+	if err != nil || cur == nil {
+		t.Fatalf("current: %v %v", cur, err)
+	}
+	if len(cur.Sources) != 1 || cur.Sources[0].Root != root {
+		t.Fatalf("source not rebound: %+v", cur.Sources)
+	}
+
+	// Changing the file invalidates a re-import.
+	if err := os.WriteFile(path, []byte("changed"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	rec.ID = 2
+	if _, err := s.Import(context.Background(), "dest2", root, []Record{rec}, ImportPolicyError, false); err == nil {
+		t.Fatal("expected changed source to reject import")
+	}
+}
+
+func canonicalRoot(t *testing.T, p string) string {
+	t.Helper()
+	c, err := filepath.EvalSymlinks(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return c
+}
+
+func TestImportRejectsBadSources(t *testing.T) {
+	dst := t.TempDir()
+	root := canonicalRoot(t, dst)
+	if err := os.WriteFile(filepath.Join(dst, "f"), []byte("x"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	cap, err := CaptureSources(dst, []string{"f"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	good := cap[0].SHA256
+	s := openStore(t)
+	cases := map[string]Source{
+		"relativeRoot": {Root: "relative/root", Path: "f", SHA256: good},
+		"absEscape":    {Root: "/orig", Path: "/other/f", SHA256: good},
+		"relEscape":    {Root: "/orig", Path: "../f", SHA256: good},
+		"badHash":      {Root: "/orig", Path: "/orig/f", SHA256: "nothex"},
+		"missingFile":  {Root: "/orig", Path: "/orig/missing", SHA256: good},
+		"wrongHash":    {Root: "/orig", Path: "/orig/f", SHA256: strings.Repeat("0", 64)},
+	}
+	for name, src := range cases {
+		rec := Record{ID: 1, Key: "k", Kind: "fact", Text: "t", Evidence: "e", Sources: []Source{src}}
+		if _, err := s.Import(context.Background(), "dest", root, []Record{rec}, ImportPolicyError, false); err == nil {
+			t.Errorf("%s: expected rejection", name)
+		}
+	}
+	// More than eight files.
+	many := make([]Source, 9)
+	for i := range many {
+		many[i] = Source{Root: "/orig", Path: "/orig/f", SHA256: good}
+	}
+	rec := Record{ID: 1, Key: "k", Kind: "fact", Text: "t", Evidence: "e", Sources: many}
+	if _, err := s.Import(context.Background(), "dest", root, []Record{rec}, ImportPolicyError, false); err == nil {
+		t.Error("expected >8 sources to be rejected")
+	}
+}
+
+func TestImportConflictPolicies(t *testing.T) {
+	ctx := context.Background()
+	recs := []Record{{ID: 1, Key: "runner", Kind: "preference", Text: "imported", Evidence: "e"}}
+
+	seed := func() *Store {
+		s := openStore(t)
+		if _, err := s.Put(ctx, Record{Scope: "dest", Key: "runner", Kind: "preference", Text: "local", Evidence: "local"}); err != nil {
+			t.Fatal(err)
+		}
+		return s
+	}
+
+	// error: whole batch refused, nothing changes.
+	s := seed()
+	if _, err := s.Import(ctx, "dest", "", recs, ImportPolicyError, false); err == nil {
+		t.Fatal("error policy should refuse a conflict")
+	}
+	cur, _ := s.Current(ctx, "dest", "runner", "")
+	if cur.Text != "local" {
+		t.Fatalf("error policy changed data: %q", cur.Text)
+	}
+
+	// skip: existing untouched.
+	s = seed()
+	res := mustImport(t, s, "dest", "", recs, ImportPolicySkip, false)
+	if res.Skipped != 1 || res.Inserted != 0 || res.Replaced != 0 {
+		t.Fatalf("skip counts: %+v", res)
+	}
+	cur, _ = s.Current(ctx, "dest", "runner", "")
+	if cur.Text != "local" {
+		t.Fatalf("skip changed data: %q", cur.Text)
+	}
+
+	// replace: new current record, local history preserved.
+	s = seed()
+	res = mustImport(t, s, "dest", "", recs, ImportPolicyReplace, false)
+	if res.Replaced != 1 || res.Inserted != 0 || res.Skipped != 0 {
+		t.Fatalf("replace counts: %+v", res)
+	}
+	cur, _ = s.Current(ctx, "dest", "runner", "")
+	if cur.Text != "imported" || cur.Supersedes == 0 {
+		t.Fatalf("replace did not supersede: %+v", cur)
+	}
+	exported, err := s.Export(ctx, "dest")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(exported), "local") {
+		t.Fatal("replace lost local correction history")
+	}
+}
+
+func TestImportConflictIgnoresExpiryAndStaleSources(t *testing.T) {
+	ctx := context.Background()
+	s := openStore(t)
+	// An expired active record is still a conflict.
+	if _, err := s.Put(ctx, Record{Scope: "dest", Key: "k", Kind: "fact", Text: "old", Evidence: "e", Expires: 1}); err != nil {
+		t.Fatal(err)
+	}
+	recs := []Record{{ID: 1, Key: "k", Kind: "fact", Text: "new", Evidence: "e"}}
+	if _, err := s.Import(ctx, "dest", "", recs, ImportPolicyError, false); err == nil {
+		t.Fatal("expired active key should still count as a conflict")
+	}
+}
+
+func TestImportDryRunWritesNothing(t *testing.T) {
+	ctx := context.Background()
+	s := openStore(t)
+	recs := []Record{{ID: 1, Key: "k", Kind: "fact", Text: "t", Evidence: "e"}}
+	res := mustImport(t, s, "dest", "", recs, ImportPolicyError, true)
+	if res.Inserted != 1 || !res.DryRun {
+		t.Fatalf("dry run counts: %+v", res)
+	}
+	cur, err := s.Current(ctx, "dest", "k", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cur != nil {
+		t.Fatal("dry run wrote a record")
+	}
+}
+
+func TestImportDryRunReplaceCounts(t *testing.T) {
+	ctx := context.Background()
+	s := openStore(t)
+	if _, err := s.Put(ctx, Record{Scope: "dest", Key: "k", Kind: "fact", Text: "local", Evidence: "e"}); err != nil {
+		t.Fatal(err)
+	}
+	recs := []Record{{ID: 1, Key: "k", Kind: "fact", Text: "new", Evidence: "e"}}
+	res := mustImport(t, s, "dest", "", recs, ImportPolicyReplace, true)
+	if res.Replaced != 1 || !res.DryRun {
+		t.Fatalf("dry run replace counts: %+v", res)
+	}
+	cur, _ := s.Current(ctx, "dest", "k", "")
+	if cur == nil || cur.Text != "local" {
+		t.Fatalf("dry run replace changed data: %+v", cur)
+	}
+}
+
+func TestImportAtomicOnFailure(t *testing.T) {
+	ctx := context.Background()
+	s := openStore(t)
+	// First record is valid, second is invalid: nothing should persist.
+	recs := []Record{
+		{ID: 1, Key: "good", Kind: "fact", Text: "t", Evidence: "e"},
+		{ID: 2, Key: "bad", Kind: "nope", Text: "t", Evidence: "e"},
+	}
+	if _, err := s.Import(ctx, "dest", "", recs, ImportPolicyError, false); err == nil {
+		t.Fatal("expected failure")
+	}
+	cur, err := s.Current(ctx, "dest", "good", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cur != nil {
+		t.Fatal("a failed import left a record behind")
+	}
+}
+
+func TestImportEmptyArray(t *testing.T) {
+	s := openStore(t)
+	res := mustImport(t, s, "dest", "", []Record{}, ImportPolicyError, false)
+	if res.Inserted != 0 || res.Replaced != 0 || res.Skipped != 0 {
+		t.Fatalf("empty import counts: %+v", res)
+	}
+}
