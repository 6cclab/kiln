+
+// readImportFile reads the import file with its size bounded before allocation.
+// It never reads stdin: the filename is required by the caller.
+func readImportFile(path string) ([]byte, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer diag.Close(f)
+	info, err := f.Stat()
+	if err != nil {
+		return nil, err
+	}
+	if !info.Mode().IsRegular() {
+		return nil, errors.New("import file must be a regular file")
+	}
+	if info.Size() > maxImportFileSize {
+		return nil, fmt.Errorf("import file exceeds %d bytes", maxImportFileSize)
+	}
+	// Guard against a file that grows after the stat: read one byte past the
+	// limit and reject if the bound is exceeded.
+	data, err := io.ReadAll(io.LimitReader(f, maxImportFileSize+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(data) > maxImportFileSize {
+		return nil, fmt.Errorf("import file exceeds %d bytes", maxImportFileSize)
+	}
+	return data, nil
+}
