@@ -0,0 +1,189 @@
+package cli
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// writeExport builds a project export JSON from one memory via the real
+// export command, so the import tests exercise the actual on-disk format.
+func exportProject(t *testing.T, home, proj string, remember ...[]string) string {
+	t.Helper()
+	ctx := context.Background()
+	for _, args := range remember {
+		var out, stderr bytes.Buffer
+		if code := PersonalMemory(ctx, Args{Positional: append([]string{"remember"}, args...)}, &out, &stderr); code != 0 {
+			t.Fatalf("remember %v: %s", args, stderr.String())
+		}
+	}
+	var out, stderr bytes.Buffer
+	if code := PersonalMemory(ctx, Args{Positional: []string{"export"}}, &out, &stderr); code != 0 {
+		t.Fatalf("export: %s", stderr.String())
+	}
+	return out.String()
+}
+
+func runImport(t *testing.T, rest ...string) (int, ImportResult, string) {
+	t.Helper()
+	var out, stderr bytes.Buffer
+	code := MemoryImport(context.Background(), rest, &out, &stderr)
+	var res ImportResult
+	if code == 0 {
+		if err := json.Unmarshal(out.Bytes(), &res); err != nil {
+			t.Fatalf("success output not JSON: %q (%v)", out.String(), err)
+		}
+	}
+	return code, res, stderr.String()
+}
+
+// ImportResult mirrors memory.ImportResult for decoding the command output.
+type ImportResult struct {
+	Inserted int  `json:"inserted"`
+	Replaced int  `json:"replaced"`
+	Skipped  int  `json:"skipped"`
+	DryRun   bool `json:"dry_run"`
+}
+
+func setupProject(t *testing.T) (home, proj string) {
+	t.Helper()
+	home = t.TempDir()
+	proj = t.TempDir()
+	t.Setenv("HOME", home)
+	t.Chdir(proj)
+	return home, proj
+}
+
+func TestMemoryImportArgErrors(t *testing.T) {
+	setupProject(t)
+	cases := [][]string{
+		{},                                    // no subcommand
+		{"import"},                            // missing file
+		{"import", "a.json", "b.json"},        // extra positional
+		{"import", "a.json", "--bogus"},       // unknown flag
+		{"import", "a.json", "--on-conflict"}, // missing value
+		{"import", "a.json", "--on-conflict", "nope"}, // invalid policy
+		{"import", "a.json", "--on-conflict=weird"},   // invalid policy (=form)
+	}
+	for _, c := range cases {
+		var out, stderr bytes.Buffer
+		if code := MemoryImport(context.Background(), c, &out, &stderr); code != 2 {
+			t.Errorf("%v: expected exit 2, got %d (%s)", c, code, stderr.String())
+		}
+		if out.Len() != 0 {
+			t.Errorf("%v: produced stdout on arg error: %q", c, out.String())
+		}
+	}
+}
+
+func TestMemoryImportMissingFileNoStdin(t *testing.T) {
+	setupProject(t)
+	// A missing file is an IO error (exit 1), and the command must not block
+	// on stdin: it returns promptly with a diagnostic.
+	code, _, stderr := runImport(t, "import", "does-not-exist.json")
+	if code != 1 || stderr == "" {
+		t.Fatalf("code=%d stderr=%q", code, stderr)
+	}
+}
+
+func TestMemoryImportFileTooLarge(t *testing.T) {
+	_, proj := setupProject(t)
+	big := filepath.Join(proj, "big.json")
+	f, err := os.Create(big)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := f.Truncate((4 << 20) + 1); err != nil {
+		t.Fatal(err)
+	}
+	if err := f.Close(); err != nil {
+		t.Fatal(err)
+	}
+	code, _, stderr := runImport(t, "import", big)
+	if code != 1 || !strings.Contains(stderr, "exceeds") {
+		t.Fatalf("code=%d stderr=%q", code, stderr)
+	}
+}
+
+func TestMemoryImportRoundTrip(t *testing.T) {
+	home, proj := setupProject(t)
+	data := exportProject(t, home, proj, []string{"runner", "use go test"})
+	file := filepath.Join(t.TempDir(), "export.json")
+	if err := os.WriteFile(file, []byte(data), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	// Fresh destination project.
+	_, _ = setupProject(t)
+	code, res, stderr := runImport(t, "import", file)
+	if code != 0 {
+		t.Fatalf("import: %s", stderr)
+	}
+	if res.Inserted != 1 || res.Replaced != 0 || res.Skipped != 0 || res.DryRun {
+		t.Fatalf("counts: %+v", res)
+	}
+
+	// Importing again now conflicts under the default error policy.
+	if code, _, _ := runImport(t, "import", file); code != 1 {
+		t.Fatalf("expected conflict exit 1, got %d", code)
+	}
+	// skip and replace resolve it; dry-run reports without writing.
+	if code, res, _ := runImport(t, "import", file, "--on-conflict", "skip"); code != 0 || res.Skipped != 1 {
+		t.Fatalf("skip: code=%d %+v", code, res)
+	}
+	if code, res, _ := runImport(t, "import", file, "--on-conflict=replace", "--dry-run"); code != 0 || res.Replaced != 1 || !res.DryRun {
+		t.Fatalf("dry replace: code=%d %+v", code, res)
+	}
+}
+
+func TestMemoryImportGlobalScope(t *testing.T) {
+	home, proj := setupProject(t)
+	// Export a global preference.
+	ctx := context.Background()
+	var out, stderr bytes.Buffer
+	if code := PersonalMemory(ctx, Args{Positional: []string{"global", "remember", "style", "concise"}}, &out, &stderr); code != 0 {
+		t.Fatalf("global remember: %s", stderr.String())
+	}
+	out.Reset()
+	stderr.Reset()
+	if code := PersonalMemory(ctx, Args{Positional: []string{"global", "export"}}, &out, &stderr); code != 0 {
+		t.Fatalf("global export: %s", stderr.String())
+	}
+	file := filepath.Join(t.TempDir(), "prefs.json")
+	if err := os.WriteFile(file, out.Bytes(), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	_ = home
+	_ = proj
+
+	// Fresh machine, import into global scope.
+	setupProject(t)
+	code, res, serr := runImport(t, "global", "import", file)
+	if code != 0 || res.Inserted != 1 {
+		t.Fatalf("global import: code=%d %+v %s", code, res, serr)
+	}
+	// It landed in the global scope, not the project scope.
+	var pout, pstderr bytes.Buffer
+	if code := PersonalMemory(ctx, Args{Positional: []string{"export"}}, &pout, &pstderr); code != 0 {
+		t.Fatal(pstderr.String())
+	}
+	if strings.Contains(pout.String(), "concise") {
+		t.Fatal("global import leaked into project scope")
+	}
+}
+
+func TestMemoryImportRejectsMalformed(t *testing.T) {
+	setupProject(t)
+	file := filepath.Join(t.TempDir(), "bad.json")
+	if err := os.WriteFile(file, []byte("{not an array}"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	code, _, stderr := runImport(t, "import", file)
+	if code != 1 || stderr == "" {
+		t.Fatalf("code=%d stderr=%q", code, stderr)
+	}
+}
diff --git a/internal/memory/import.go b/internal/memory/import.go
new file mode 100644
index 0000000..2966ef4
--- /dev/null
+++ b/internal/memory/import.go
@@ -0,0 +1,292 @@
+package memory
+
+import (
+	"bytes"
+	"context"
+	"database/sql"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+)
+
+// ImportPolicy names how importing an active destination key is resolved.
+const (
+	ImportPolicyError   = "error"
+	ImportPolicySkip    = "skip"
+	ImportPolicyReplace = "replace"
+)
+
+// maxImportRecords caps the history an import may carry, matching the
+// defensive bounds the rest of the store applies to untrusted input.
+const maxImportRecords = 1000
+
+// ImportResult reports, per selected current key, what an import did (or would
+// do, for a dry run). Counts never describe historical rows, only the current
+// version chosen for each key.
+type ImportResult struct {
+	Inserted int  `json:"inserted"`
+	Replaced int  `json:"replaced"`
+	Skipped  int  `json:"skipped"`
+	DryRun   bool `json:"dry_run"`
+}
+
+// DecodeExport parses exactly one JSON array in the `memory export` format.
+// It rejects malformed JSON, trailing content, unknown record or source
+// fields, anything that is not a JSON array, and oversized histories. An empty
+// array is valid. It does not interpret the records; Import validates them.
+func DecodeExport(data []byte) ([]Record, error) {
+	// A null or any non-array literal unmarshals in surprising ways (null
+	// becomes a nil slice without error), so require an array up front.
+	if trimmed := bytes.TrimLeft(data, " \t\r\n"); len(trimmed) == 0 || trimmed[0] != '[' {
+		return nil, errors.New("import expects a single JSON array")
+	}
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.DisallowUnknownFields()
+	var records []Record
+	if err := dec.Decode(&records); err != nil {
+		return nil, fmt.Errorf("malformed import JSON: %w", err)
+	}
+	// Reject trailing JSON after the array; only whitespace may follow.
+	if err := dec.Decode(new(json.RawMessage)); !errors.Is(err, io.EOF) {
+		return nil, errors.New("trailing content after import JSON array")
+	}
+	if len(records) > maxImportRecords {
+		return nil, fmt.Errorf("import has more than %d records", maxImportRecords)
+	}
+	if records == nil {
+		records = []Record{}
+	}
+	return records, nil
+}
+
+// validatePutFields mirrors Put's field and kind limits so imported records are
+// held to the same bar as records written locally. It never inspects scope,
+// created, or supersedes: those are destination identity, not imported data.
+func validatePutFields(r Record) error {
+	if strings.TrimSpace(r.Key) == "" || strings.TrimSpace(r.Text) == "" || strings.TrimSpace(r.Evidence) == "" {
+		return errors.New("key, text and evidence are required")
+	}
+	if len(r.Key) > 256 || len(r.Text) > 8192 || len(r.Evidence) > 2048 {
+		return errors.New("record exceeds field limits")
+	}
+	switch r.Kind {
+	case "preference", "fact", "procedure", "observation":
+	default:
+		return errors.New("invalid memory kind")
+	}
+	if r.Expires < 0 {
+		return errors.New("expiry must be nonnegative")
+	}
+	return nil
+}
+
+func validSHA256(h string) bool {
+	if len(h) != 64 {
+		return false
+	}
+	_, err := hex.DecodeString(h)
+	return err == nil
+}
+
+// relWithinRoot resolves a source's recorded path to a path relative to its
+// recorded root, lexically only: the original root is from another machine and
+// must never be touched. The root must be absolute. An absolute path is valid
+// only when lexically contained in the root; a relative path is interpreted
+// under the root and may not escape it.
+func relWithinRoot(root, path string) (string, error) {
+	if !filepath.IsAbs(root) {
+		return "", errors.New("source root must be absolute")
+	}
+	root = filepath.Clean(root)
+	sep := string(filepath.Separator)
+	if filepath.IsAbs(path) {
+		rel, err := filepath.Rel(root, filepath.Clean(path))
+		if err != nil || rel == ".." || strings.HasPrefix(rel, ".."+sep) {
+			return "", errors.New("source path is outside its recorded root")
+		}
+		return rel, nil
+	}
+	rel := filepath.Clean(path)
+	if rel == ".." || strings.HasPrefix(rel, ".."+sep) {
+		return "", errors.New("source path escapes its recorded root")
+	}
+	return rel, nil
+}
+
+// rebindSources maps each recorded source into the current project root,
+// validates it against the destination file, and returns the destination
+// binding. It never reads the originating machine's paths.
+func rebindSources(projectRoot string, sources []Source) ([]Source, error) {
+	if len(sources) > 8 {
+		return nil, errors.New("at most eight source files are allowed")
+	}
+	out := make([]Source, 0, len(sources))
+	for _, src := range sources {
+		if !validSHA256(src.SHA256) {
+			return nil, errors.New("invalid source hash")
+		}
+		rel, err := relWithinRoot(src.Root, src.Path)
+		if err != nil {
+			return nil, err
+		}
+		destPath := filepath.Join(projectRoot, rel)
+		digest, err := sourceDigest(projectRoot, destPath)
+		if err != nil {
+			return nil, err
+		}
+		if digest != strings.ToLower(src.SHA256) {
+			return nil, errors.New("source file does not match its recorded hash")
+		}
+		out = append(out, Source{Root: projectRoot, Path: destPath, SHA256: digest})
+	}
+	return out, nil
+}
+
+// Import ingests an exported history into the destination scope in a single
+// transaction. scope is the destination (project or global preferences), never
+// a scope from the input. projectRoot must be the canonical current project
+// root; it is unused for global imports, which forbid sources.
+//
+// Every record is validated, then the largest input ID per key becomes that
+// key's current version; only those selected versions are written. Imported
+// scope, created, and supersedes values are not trusted as destination
+// identity or lineage. A dry run performs the same validation and conflict
+// analysis but writes nothing. Any failure leaves the destination unchanged.
+func (s *Store) Import(ctx context.Context, scope, projectRoot string, records []Record, policy string, dryRun bool) (ImportResult, error) {
+	result := ImportResult{DryRun: dryRun}
+	switch policy {
+	case ImportPolicyError, ImportPolicySkip, ImportPolicyReplace:
+	default:
+		return result, errors.New("invalid conflict policy")
+	}
+	if scope == "" {
+		return result, errors.New("destination scope is required")
+	}
+	global := scope == GlobalPreferencesScope
+
+	// Validate every record, including history, before anything is written.
+	seen := make(map[int64]bool, len(records))
+	rebound := make([][]Source, len(records))
+	for i := range records {
+		r := records[i]
+		if r.ID <= 0 {
+			return result, fmt.Errorf("record at index %d: input id must be positive", i)
+		}
+		if seen[r.ID] {
+			return result, fmt.Errorf("duplicate input id %d", r.ID)
+		}
+		seen[r.ID] = true
+		if err := validatePutFields(r); err != nil {
+			return result, fmt.Errorf("record %d: %w", r.ID, err)
+		}
+		if global {
+			if r.Kind != "preference" || len(r.Sources) != 0 {
+				return result, fmt.Errorf("record %d: global import accepts preferences without sources only", r.ID)
+			}
+			continue
+		}
+		if len(r.Sources) > 0 {
+			bound, err := rebindSources(projectRoot, r.Sources)
+			if err != nil {
+				return result, fmt.Errorf("record %d: %w", r.ID, err)
+			}
+			rebound[i] = bound
+		}
+	}
+
+	// The current version of each key is its largest input ID. Order the
+	// selected keys by that ID so destination IDs are assigned deterministically.
+	selected := make(map[string]int)
+	for i := range records {
+		if cur, ok := selected[records[i].Key]; !ok || records[i].ID > records[cur].ID {
+			selected[records[i].Key] = i
+		}
+	}
+	order := make([]int, 0, len(selected))
+	for _, idx := range selected {
+		order = append(order, idx)
+	}
+	sort.Slice(order, func(a, b int) bool { return records[order[a]].ID < records[order[b]].ID })
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return result, err
+	}
+	defer rollback(tx)
+
+	type plan struct {
+		idx      int
+		existing int64
+	}
+	plans := make([]plan, 0, len(order))
+	conflicts := 0
+	for _, idx := range order {
+		var existing int64
+		err := tx.QueryRowContext(ctx, `SELECT id FROM memories WHERE scope=? AND key=? AND active=1`, scope, records[idx].Key).Scan(&existing)
+		if err != nil && !errors.Is(err, sql.ErrNoRows) {
+			return result, err
+		}
+		if existing != 0 {
+			conflicts++
+		}
+		plans = append(plans, plan{idx: idx, existing: existing})
+	}
+	if policy == ImportPolicyError && conflicts > 0 {
+		return result, fmt.Errorf("import conflicts with %d existing key(s); use --on-conflict skip or replace", conflicts)
+	}
+
+	now := time.Now().Unix()
+	for _, p := range plans {
+		conflict := p.existing != 0
+		if conflict && policy == ImportPolicySkip {
+			result.Skipped++
+			continue
+		}
+		if conflict {
+			result.Replaced++
+		} else {
+			result.Inserted++
+		}
+		if dryRun {
+			continue
+		}
+		r := records[p.idx]
+		if conflict {
+			if _, err := tx.ExecContext(ctx, `UPDATE memories SET active=0 WHERE id=? AND scope=?`, p.existing, scope); err != nil {
+				return result, err
+			}
+		}
+		res, err := tx.ExecContext(ctx, `INSERT INTO memories(scope,key,kind,text,evidence,created,expires,supersedes) VALUES(?,?,?,?,?,?,?,?)`, scope, r.Key, r.Kind, r.Text, r.Evidence, now, r.Expires, p.existing)
+		if err != nil {
+			return result, err
+		}
+		id, err := res.LastInsertId()
+		if err != nil {
+			return result, err
+		}
+		if _, err := tx.ExecContext(ctx, `INSERT INTO memory_search(rowid,text,evidence) VALUES(?,?,?)`, id, r.Key+"\n"+r.Text, r.Evidence); err != nil {
+			return result, err
+		}
+		if sources := rebound[p.idx]; len(sources) > 0 {
+			raw, err := json.Marshal(sources)
+			if err != nil {
+				return result, err
+			}
+			if _, err := tx.ExecContext(ctx, `INSERT INTO memory_sources(memory_id,sources) VALUES(?,?)`, id, string(raw)); err != nil {
+				return result, err
+			}
+		}
+	}
+	if dryRun {
+		// The deferred rollback discards the read-only transaction; a dry run
+		// must leave every memory, search entry, and source binding unchanged.
+		return result, nil
+	}
+	return result, tx.Commit()
+}
diff --git a/internal/memory/import_test.go b/internal/memory/import_test.go
