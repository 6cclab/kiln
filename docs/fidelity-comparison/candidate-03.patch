@@ -0,0 +1,134 @@
+package memory
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+)
+
+// Conflict policies for ImportRecords. error rejects the whole batch when any
+// selected key already exists; skip leaves existing records untouched; replace
+// supersedes them, preserving local correction history.
+const (
+	ImportError   = "error"
+	ImportSkip    = "skip"
+	ImportReplace = "replace"
+)
+
+// ImportResult counts the current keys an import touches, never history rows.
+// A dry run reports what would happen.
+type ImportResult struct {
+	Inserted int
+	Replaced int
+	Skipped  int
+}
+
+// CheckImportRecord enforces the field and kind limits every imported record
+// must satisfy, independent of its destination scope. Imported scope, created,
+// and supersedes values are not identity and are validated elsewhere.
+func CheckImportRecord(r Record) error {
+	if strings.TrimSpace(r.Key) == "" || strings.TrimSpace(r.Text) == "" || strings.TrimSpace(r.Evidence) == "" {
+		return errors.New("key, text and evidence are required")
+	}
+	if len(r.Key) > 256 || len(r.Text) > 8192 || len(r.Evidence) > 2048 {
+		return errors.New("memory exceeds field limits")
+	}
+	switch r.Kind {
+	case "preference", "fact", "procedure", "observation":
+	default:
+		return errors.New("invalid memory kind")
+	}
+	if r.Expires < 0 {
+		return errors.New("memory expiry must be nonnegative")
+	}
+	return nil
+}
+
+// ImportRecords applies a validated batch of selected current records in one
+// transaction. Each record's scope must already be the destination scope and
+// its sources already rebound to this machine; imported ids, created times and
+// supersedes links are not trusted. Destination ids and creation times are
+// assigned here, expiry is preserved, and supersedes links to the previous
+// destination record only. A dry run performs the same conflict analysis and
+// rolls back without writing. Any error leaves the database unchanged.
+func (s *Store) ImportRecords(ctx context.Context, records []Record, policy string, dryRun bool) (ImportResult, error) {
+	switch policy {
+	case ImportError, ImportSkip, ImportReplace:
+	default:
+		return ImportResult{}, errors.New("invalid conflict policy")
+	}
+	for _, r := range records {
+		if err := CheckImportRecord(r); err != nil {
+			return ImportResult{}, err
+		}
+		if r.Scope == "" {
+			return ImportResult{}, errors.New("import scope is required")
+		}
+		if r.Scope == GlobalPreferencesScope && (r.Kind != "preference" || len(r.Sources) != 0) {
+			return ImportResult{}, errors.New("global memory accepts explicit preferences without project file sources only")
+		}
+	}
+	var res ImportResult
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return ImportResult{}, err
+	}
+	defer rollback(tx)
+	for _, r := range records {
+		var previous int64
+		err := tx.QueryRowContext(ctx, `SELECT id FROM memories WHERE scope=? AND key=? AND active=1`, r.Scope, r.Key).Scan(&previous)
+		if err != nil && err != sql.ErrNoRows {
+			return ImportResult{}, err
+		}
+		conflict := err == nil
+		if conflict {
+			switch policy {
+			case ImportError:
+				return ImportResult{}, fmt.Errorf("memory key %q already exists in the destination scope", r.Key)
+			case ImportSkip:
+				res.Skipped++
+				continue
+			case ImportReplace:
+				res.Replaced++
+			}
+		} else {
+			res.Inserted++
+		}
+		if _, err := tx.ExecContext(ctx, `UPDATE memories SET active=0 WHERE scope=? AND key=? AND active=1`, r.Scope, r.Key); err != nil {
+			return ImportResult{}, err
+		}
+		insert, err := tx.ExecContext(ctx, `INSERT INTO memories(scope,key,kind,text,evidence,created,expires,supersedes) VALUES(?,?,?,?,?,?,?,?)`, r.Scope, r.Key, r.Kind, r.Text, r.Evidence, time.Now().Unix(), r.Expires, previous)
+		if err != nil {
+			return ImportResult{}, err
+		}
+		id, err := insert.LastInsertId()
+		if err != nil {
+			return ImportResult{}, err
+		}
+		if _, err := tx.ExecContext(ctx, `INSERT INTO memory_search(rowid,text,evidence) VALUES(?,?,?)`, id, r.Key+"\n"+r.Text, r.Evidence); err != nil {
+			return ImportResult{}, err
+		}
+		if len(r.Sources) > 0 {
+			raw, err := json.Marshal(r.Sources)
+			if err != nil {
+				return ImportResult{}, err
+			}
+			if _, err := tx.ExecContext(ctx, `INSERT INTO memory_sources(memory_id,sources) VALUES(?,?)`, id, string(raw)); err != nil {
+				return ImportResult{}, err
+			}
+		}
+	}
+	if dryRun {
+		// The deferred rollback discards every write; the counts still
+		// describe what a real import would have done.
+		return res, nil
+	}
+	if err := tx.Commit(); err != nil {
+		return ImportResult{}, err
+	}
+	return res, nil
+}
