+// validSHA256 reports whether s is a lowercase 64-character hex digest, the
+// form sourceDigest produces. Imported digests in any other form are rejected.
+func validSHA256(s string) bool {
+	if len(s) != 64 {
+		return false
+	}
+	for _, c := range s {
+		if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) {
+			return false
+		}
+	}
+	return true
+}
+
+// RebindSource maps one exported source binding from its original root into
+// destRoot and validates it against the destination file. The original root
+// must be absolute but need not exist on this machine, and original machine
+// paths are never read: only the rebound destination path is opened. An
+// absolute source path is valid only when lexically contained in its original
+// root; a relative source path is interpreted under that root. It rejects
+// invalid digests, path escapes, symlink escapes, missing or changed files,
+// and nonregular or oversized destination files.
+func RebindSource(source Source, destRoot string) (Source, error) {
+	if !filepath.IsAbs(source.Root) {
+		return Source{}, fmt.Errorf("memory source root must be absolute")
+	}
+	if !validSHA256(source.SHA256) {
+		return Source{}, fmt.Errorf("memory source has an invalid digest")
+	}
+	orig := source.Path
+	if !filepath.IsAbs(orig) {
+		orig = filepath.Join(source.Root, orig)
+	}
+	rel, err := filepath.Rel(source.Root, orig)
+	if err != nil || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		return Source{}, fmt.Errorf("memory source path escapes its root")
+	}
+	canonical, err := filepath.EvalSymlinks(destRoot)
+	if err != nil {
+		return Source{}, err
+	}
+	dest := filepath.Join(canonical, rel)
+	digest, err := sourceDigest(canonical, dest)
+	if err != nil {
+		return Source{}, err
+	}
+	if digest != source.SHA256 {
+		return Source{}, fmt.Errorf("memory source no longer matches the destination file")
+	}
+	return Source{Root: canonical, Path: dest, SHA256: digest}, nil
+}
+
 // SourcesCurrent rejects missing, changed, or redirected source files.
 func SourcesCurrent(sources []Source) bool {
 	for _, s := range sources {
