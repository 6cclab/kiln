diff --git a/internal/cli/memory_import.go b/internal/cli/memory_import.go
new file mode 100644
index 0000000..8f46ace
--- /dev/null
+++ b/internal/cli/memory_import.go
@@ -0,0 +1,266 @@
+package cli
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/andrepato/harness/internal/diag"
+	"github.com/andrepato/harness/internal/memory"
+)
+
+const (
+	memoryImportMaxBytes   = 4 << 20
+	memoryImportMaxRecords = 1000
+	memoryImportMaxSources = 8
+)
+
+const memoryImportUsage = "usage: kiln memory [global] import <file> [--dry-run] [--on-conflict error|skip|replace]"
+
+// IsMemoryImport reports whether `kiln memory <argv...>` names the import
+// command, so main can dispatch it before the global flag parser, which does
+// not know --dry-run or --on-conflict. argv starts after "memory".
+func IsMemoryImport(argv []string) bool {
+	rest := argv
+	if len(rest) > 0 && rest[0] == "global" {
+		rest = rest[1:]
+	}
+	return len(rest) > 0 && rest[0] == "import"
+}
+
+// memoryImportReport is the single JSON object printed on success. Counts
+// apply to selected current keys, not historical rows; dry-run counts describe
+// what would happen.
+type memoryImportReport struct {
+	Inserted int  `json:"inserted"`
+	Replaced int  `json:"replaced"`
+	Skipped  int  `json:"skipped"`
+	DryRun   bool `json:"dry_run"`
+}
+
+// MemoryImport imports a `kiln memory export` JSON array into the current
+// project scope, or the global preferences scope with `global`. It is an
+// explicit local management command and never starts a model. argv starts
+// after "memory".
+func MemoryImport(ctx context.Context, argv []string, out, stderr io.Writer) int {
+	global := false
+	rest := argv
+	if len(rest) > 0 && rest[0] == "global" {
+		global = true
+		rest = rest[1:]
+	}
+	if len(rest) == 0 || rest[0] != "import" {
+		writeDiagnostic(stderr, memoryImportUsage)
+		return 2
+	}
+	rest = rest[1:]
+
+	file := ""
+	fileSet := false
+	dryRun := false
+	onConflict := memory.ImportError
+	for i := 0; i < len(rest); i++ {
+		token := rest[i]
+		switch {
+		case token == "--dry-run":
+			dryRun = true
+		case token == "--on-conflict" || strings.HasPrefix(token, "--on-conflict="):
+			var value string
+			if eq := strings.IndexByte(token, '='); eq != -1 {
+				value = token[eq+1:]
+			} else {
+				if i+1 >= len(rest) || strings.HasPrefix(rest[i+1], "-") {
+					writeDiagnostic(stderr, "kiln memory import: --on-conflict needs a value")
+					return 2
+				}
+				i++
+				value = rest[i]
+			}
+			switch value {
+			case memory.ImportError, memory.ImportSkip, memory.ImportReplace:
+				onConflict = value
+			default:
+				writeDiagnostic(stderr, "kiln memory import: --on-conflict must be error, skip or replace")
+				return 2
+			}
+		case strings.HasPrefix(token, "-"):
+			writeDiagnostic(stderr, "kiln memory import: unknown flag", token)
+			return 2
+		default:
+			if fileSet {
+				writeDiagnostic(stderr, memoryImportUsage)
+				return 2
+			}
+			file = token
+			fileSet = true
+		}
+	}
+	if !fileSet {
+		// A missing filename is an error; stdin is never read in its place.
+		writeDiagnostic(stderr, memoryImportUsage)
+		return 2
+	}
+
+	records, err := readMemoryImport(file)
+	if err != nil {
+		writeDiagnostic(stderr, "kiln memory import:", err)
+		return 1
+	}
+
+	cwd, err := os.Getwd()
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	scope := memoryScope(cwd)
+	if global {
+		scope = memory.GlobalPreferencesScope
+	}
+	projectRoot := memoryProjectRoot(cwd)
+
+	selected, err := selectMemoryImport(records, scope, global, projectRoot)
+	if err != nil {
+		writeDiagnostic(stderr, "kiln memory import:", err)
+		return 1
+	}
+
+	home, err := os.UserHomeDir()
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	s, err := memory.Open(filepath.Join(home, ".kiln", "memory.db"))
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	defer diag.Close(s)
+
+	res, err := s.ImportRecords(ctx, selected, onConflict, dryRun)
+	if err != nil {
+		writeDiagnostic(stderr, "kiln memory import:", err)
+		return 1
+	}
+
+	report, err := json.Marshal(memoryImportReport{Inserted: res.Inserted, Replaced: res.Replaced, Skipped: res.Skipped, DryRun: dryRun})
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	if _, err := fmt.Fprintln(out, string(report)); err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	return 0
+}
+
+// readMemoryImport reads and strictly parses the import file: exactly one JSON
+// array in the export format, bounded before allocation, with no trailing data
+// and no unknown record or source fields.
+func readMemoryImport(file string) ([]memory.Record, error) {
+	info, err := os.Stat(file)
+	if err != nil {
+		return nil, err
+	}
+	if info.IsDir() {
+		return nil, fmt.Errorf("import file %q is a directory", file)
+	}
+	if info.Size() > memoryImportMaxBytes {
+		return nil, fmt.Errorf("import file exceeds %d bytes", memoryImportMaxBytes)
+	}
+	f, err := os.Open(file)
+	if err != nil {
+		return nil, err
+	}
+	defer diag.Close(f)
+	data, err := io.ReadAll(io.LimitReader(f, memoryImportMaxBytes+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(data) > memoryImportMaxBytes {
+		return nil, fmt.Errorf("import file exceeds %d bytes", memoryImportMaxBytes)
+	}
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.DisallowUnknownFields()
+	var records []memory.Record
+	if err := dec.Decode(&records); err != nil {
+		return nil, fmt.Errorf("malformed import JSON: %w", err)
+	}
+	if records == nil {
+		return nil, fmt.Errorf("import must be a JSON array")
+	}
+	if _, err := dec.Token(); err != io.EOF {
+		return nil, fmt.Errorf("trailing data after the import array")
+	}
+	if len(records) > memoryImportMaxRecords {
+		return nil, fmt.Errorf("import has more than %d records", memoryImportMaxRecords)
+	}
+	return records, nil
+}
+
+// selectMemoryImport validates every record, then picks the largest input id
+// for each key as its current version. Input ids must be positive and unique.
+// Destination scope, lineage and creation times are assigned by the store, not
+// taken from the input. Historical records are validated but not written.
+func selectMemoryImport(records []memory.Record, scope string, global bool, projectRoot string) ([]memory.Record, error) {
+	seen := make(map[int64]bool, len(records))
+	chosen := make(map[string]int)
+	rebound := make(map[int][]memory.Source)
+	for i, r := range records {
+		if r.ID <= 0 {
+			return nil, fmt.Errorf("import ids must be positive")
+		}
+		if seen[r.ID] {
+			return nil, fmt.Errorf("import ids must be unique")
+		}
+		seen[r.ID] = true
+		if err := memory.CheckImportRecord(r); err != nil {
+			return nil, err
+		}
+		if global {
+			if r.Kind != "preference" || len(r.Sources) != 0 {
+				return nil, fmt.Errorf("global import accepts preference records without sources only")
+			}
+		} else if len(r.Sources) > 0 {
+			if len(r.Sources) > memoryImportMaxSources {
+				return nil, fmt.Errorf("a memory record binds at most %d source files", memoryImportMaxSources)
+			}
+			dest := make([]memory.Source, 0, len(r.Sources))
+			for _, src := range r.Sources {
+				bound, err := memory.RebindSource(src, projectRoot)
+				if err != nil {
+					return nil, err
+				}
+				dest = append(dest, bound)
+			}
+			rebound[i] = dest
+		}
+		if prev, ok := chosen[r.Key]; !ok || r.ID > records[prev].ID {
+			chosen[r.Key] = i
+		}
+	}
+
+	keys := make([]string, 0, len(chosen))
+	for key := range chosen {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+
+	selected := make([]memory.Record, 0, len(keys))
+	for _, key := range keys {
+		i := chosen[key]
+		r := records[i]
+		dest := memory.Record{Scope: scope, Key: r.Key, Kind: r.Kind, Text: r.Text, Evidence: r.Evidence, Expires: r.Expires}
+		if !global {
+			dest.Sources = rebound[i]
+		}
+		selected = append(selected, dest)
+	}
+	return selected, nil
+}
diff --git a/internal/cli/memory_import_test.go b/internal/cli/memory_import_test.go
new file mode 100644
index 0000000..962d9e2
--- /dev/null
+++ b/internal/cli/memory_import_test.go
@@ -0,0 +1,246 @@
+package cli
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/andrepato/harness/internal/memory"
+)
+
+func runMemoryImport(t *testing.T, project string, argv ...string) (int, string, string) {
+	t.Helper()
+	t.Chdir(project)
+	var out, stderr bytes.Buffer
+	code := MemoryImport(context.Background(), argv, &out, &stderr)
+	return code, out.String(), stderr.String()
+}
+
+func writeImportFile(t *testing.T, dir string, records []memory.Record) string {
+	t.Helper()
+	data, err := json.Marshal(records)
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(dir, "import.json")
+	if err := os.WriteFile(path, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func TestMemoryImportSelectsLatestAndCounts(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	project := t.TempDir()
+	// Two versions of the same key: the larger id is the current version;
+	// the imported history is not replayed.
+	file := writeImportFile(t, t.TempDir(), []memory.Record{
+		{ID: 1, Scope: "other", Key: "runner", Kind: "preference", Text: "old", Evidence: "export"},
+		{ID: 5, Scope: "other", Key: "runner", Kind: "preference", Text: "new", Evidence: "export"},
+		{ID: 3, Scope: "other", Key: "style", Kind: "fact", Text: "tabs", Evidence: "export"},
+	})
+
+	code, out, stderr := runMemoryImport(t, project, "import", file)
+	if code != 0 {
+		t.Fatalf("import failed: %s", stderr)
+	}
+	var report memoryImportReport
+	if err := json.Unmarshal([]byte(out), &report); err != nil {
+		t.Fatalf("bad report %q: %v", out, err)
+	}
+	if report.Inserted != 2 || report.Replaced != 0 || report.Skipped != 0 || report.DryRun {
+		t.Fatalf("counts: %+v", report)
+	}
+
+	// The current record is the latest version, stored in the project scope.
+	s, err := memory.Open(filepath.Join(home, ".kiln", "memory.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	got, err := s.Current(context.Background(), memoryScope(project), "runner", memoryProjectRoot(project))
+	if err != nil || got == nil || got.Text != "new" {
+		t.Fatalf("current: %+v %v", got, err)
+	}
+	if got.Scope == "other" {
+		t.Fatal("imported scope was trusted")
+	}
+}
+
+func TestMemoryImportDryRunWritesNothing(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	project := t.TempDir()
+	file := writeImportFile(t, t.TempDir(), []memory.Record{
+		{ID: 1, Scope: "x", Key: "k", Kind: "fact", Text: "v", Evidence: "export"},
+	})
+	code, out, stderr := runMemoryImport(t, project, "import", file, "--dry-run")
+	if code != 0 {
+		t.Fatalf("dry run failed: %s", stderr)
+	}
+	if !strings.Contains(out, `"dry_run":true`) || !strings.Contains(out, `"inserted":1`) {
+		t.Fatalf("dry run report: %s", out)
+	}
+	s, err := memory.Open(filepath.Join(home, ".kiln", "memory.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	if got, _ := s.Current(context.Background(), memoryScope(project), "k", memoryProjectRoot(project)); got != nil {
+		t.Fatal("dry run wrote a record")
+	}
+}
+
+func TestMemoryImportConflictPolicies(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	project := t.TempDir()
+	file := writeImportFile(t, t.TempDir(), []memory.Record{
+		{ID: 1, Scope: "x", Key: "k", Kind: "fact", Text: "first", Evidence: "export"},
+	})
+	if code, _, stderr := runMemoryImport(t, project, "import", file); code != 0 {
+		t.Fatalf("seed import: %s", stderr)
+	}
+	// error (default) rejects the conflicting batch.
+	if code, out, _ := runMemoryImport(t, project, "import", file); code == 0 {
+		t.Fatalf("error policy accepted a conflict: %s", out)
+	}
+	// skip leaves the existing record and counts it.
+	if code, out, stderr := runMemoryImport(t, project, "import", file, "--on-conflict", "skip"); code != 0 || !strings.Contains(out, `"skipped":1`) {
+		t.Fatalf("skip: code=%d out=%s stderr=%s", code, out, stderr)
+	}
+	// replace supersedes and counts a replacement.
+	if code, out, stderr := runMemoryImport(t, project, "import", file, "--on-conflict=replace"); code != 0 || !strings.Contains(out, `"replaced":1`) {
+		t.Fatalf("replace: code=%d out=%s stderr=%s", code, out, stderr)
+	}
+}
+
+func TestMemoryImportArgErrors(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	project := t.TempDir()
+	good := writeImportFile(t, t.TempDir(), []memory.Record{})
+	cases := [][]string{
+		{"import"},                                    // missing filename
+		{"import", good, "--bogus"},                   // unknown flag
+		{"import", good, "--on-conflict"},             // missing value
+		{"import", good, "--on-conflict", "nonsense"}, // invalid policy
+		{"import", good, "extra.json"},                // extra positional
+	}
+	for _, argv := range cases {
+		if code, _, _ := runMemoryImport(t, project, argv...); code == 0 {
+			t.Errorf("argv %v: expected nonzero exit", argv)
+		}
+	}
+	// An empty array is valid and writes nothing.
+	if code, out, stderr := runMemoryImport(t, project, "import", good); code != 0 || !strings.Contains(out, `"inserted":0`) {
+		t.Fatalf("empty array: code=%d out=%s stderr=%s", code, out, stderr)
+	}
+}
+
+func TestMemoryImportRejectsMalformedAndBounds(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	project := t.TempDir()
+	dir := t.TempDir()
+	write := func(name, body string) string {
+		p := filepath.Join(dir, name)
+		if err := os.WriteFile(p, []byte(body), 0600); err != nil {
+			t.Fatal(err)
+		}
+		return p
+	}
+	bad := map[string]string{
+		"null.json":     "null",
+		"object.json":   "{}",
+		"trailing.json": "[] [1]",
+		"unknown.json":  `[{"id":1,"key":"k","kind":"fact","text":"t","evidence":"e","mystery":1}]`,
+		"garbage.json":  "{not json",
+	}
+	for name, body := range bad {
+		file := write(name, body)
+		if code, _, _ := runMemoryImport(t, project, "import", file); code == 0 {
+			t.Errorf("%s: expected rejection", name)
+		}
+	}
+	// A negative expiry is rejected.
+	negative := writeImportFile(t, t.TempDir(), []memory.Record{{ID: 1, Key: "k", Kind: "fact", Text: "t", Evidence: "e", Expires: -1}})
+	if code, _, _ := runMemoryImport(t, project, "import", negative); code == 0 {
+		t.Error("negative expiry accepted")
+	}
+	// Non-positive and duplicate ids are rejected.
+	dup := writeImportFile(t, t.TempDir(), []memory.Record{
+		{ID: 2, Key: "a", Kind: "fact", Text: "t", Evidence: "e"},
+		{ID: 2, Key: "b", Kind: "fact", Text: "t", Evidence: "e"},
+	})
+	if code, _, _ := runMemoryImport(t, project, "import", dup); code == 0 {
+		t.Error("duplicate ids accepted")
+	}
+}
+
+func TestMemoryImportGlobalRejectsSources(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	project := t.TempDir()
+	// A source-bearing record is invalid for global import even as history.
+	file := writeImportFile(t, t.TempDir(), []memory.Record{
+		{ID: 1, Key: "runner", Kind: "preference", Text: "old", Evidence: "export",
+			Sources: []memory.Source{{Root: "/p", Path: "/p/f", SHA256: strings.Repeat("a", 64)}}},
+		{ID: 2, Key: "runner", Kind: "preference", Text: "new", Evidence: "export"},
+	})
+	if code, _, _ := runMemoryImport(t, project, "global", "import", file); code == 0 {
+		t.Fatal("global import accepted a historical source-bearing record")
+	}
+	// A non-preference kind is also rejected.
+	file = writeImportFile(t, t.TempDir(), []memory.Record{{ID: 1, Key: "k", Kind: "fact", Text: "t", Evidence: "e"}})
+	if code, _, _ := runMemoryImport(t, project, "global", "import", file); code == 0 {
+		t.Fatal("global import accepted a non-preference record")
+	}
+}
+
+func TestMemoryImportProjectSources(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	project := t.TempDir()
+	root := memoryProjectRoot(project)
+	if err := os.WriteFile(filepath.Join(root, "config.txt"), []byte("hello"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	sum := sha256.Sum256([]byte("hello"))
+	digest := hex.EncodeToString(sum[:])
+
+	valid := writeImportFile(t, t.TempDir(), []memory.Record{
+		{ID: 1, Key: "cfg", Kind: "fact", Text: "uses config", Evidence: "export",
+			Sources: []memory.Source{{Root: "/elsewhere/proj", Path: "/elsewhere/proj/config.txt", SHA256: digest}}},
+	})
+	if code, out, stderr := runMemoryImport(t, project, "import", valid); code != 0 || !strings.Contains(out, `"inserted":1`) {
+		t.Fatalf("valid source import: code=%d out=%s stderr=%s", code, out, stderr)
+	}
+	got, err := memory.Open(filepath.Join(home, ".kiln", "memory.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer got.Close()
+	rec, err := got.Current(context.Background(), memoryScope(project), "cfg", root)
+	if err != nil || rec == nil || len(rec.Sources) != 1 || rec.Sources[0].Root != root {
+		t.Fatalf("rebound source: %+v %v", rec, err)
+	}
+
+	// A source whose destination file is missing is rejected, including as
+	// historical lineage.
+	stale := writeImportFile(t, t.TempDir(), []memory.Record{
+		{ID: 1, Key: "x", Kind: "fact", Text: "old", Evidence: "export",
+			Sources: []memory.Source{{Root: "/elsewhere/proj", Path: "/elsewhere/proj/absent.txt", SHA256: digest}}},
+		{ID: 2, Key: "x", Kind: "fact", Text: "new", Evidence: "export"},
+	})
+	if code, _, _ := runMemoryImport(t, project, "import", stale); code == 0 {
+		t.Fatal("stale historical source accepted")
+	}
+}
