+package memory
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func openTestStore(t *testing.T) *Store {
+	t.Helper()
+	s, err := Open(filepath.Join(t.TempDir(), "memory.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := s.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	return s
+}
+
+func TestImportRecordsConflictPolicies(t *testing.T) {
+	ctx := context.Background()
+	rec := func(key, text string) Record {
+		return Record{Scope: "proj", Key: key, Kind: "fact", Text: text, Evidence: "import"}
+	}
+
+	t.Run("insert then error", func(t *testing.T) {
+		s := openTestStore(t)
+		res, err := s.ImportRecords(ctx, []Record{rec("a", "one"), rec("b", "two")}, ImportError, false)
+		if err != nil || res.Inserted != 2 || res.Replaced != 0 || res.Skipped != 0 {
+			t.Fatalf("insert: %+v %v", res, err)
+		}
+		// Re-importing the same keys under error must reject the whole batch
+		// and leave the existing records untouched.
+		if _, err := s.ImportRecords(ctx, []Record{rec("a", "changed"), rec("c", "new")}, ImportError, false); err == nil {
+			t.Fatal("error policy accepted a conflict")
+		}
+		got, err := s.Current(ctx, "proj", "a", "")
+		if err != nil || got == nil || got.Text != "one" {
+			t.Fatalf("existing changed by failed error import: %+v %v", got, err)
+		}
+		if got, _ := s.Current(ctx, "proj", "c", ""); got != nil {
+			t.Fatal("partial write from failed error import")
+		}
+	})
+
+	t.Run("skip leaves existing", func(t *testing.T) {
+		s := openTestStore(t)
+		if _, err := s.ImportRecords(ctx, []Record{rec("a", "one")}, ImportError, false); err != nil {
+			t.Fatal(err)
+		}
+		res, err := s.ImportRecords(ctx, []Record{rec("a", "changed"), rec("b", "two")}, ImportSkip, false)
+		if err != nil || res.Inserted != 1 || res.Skipped != 1 || res.Replaced != 0 {
+			t.Fatalf("skip: %+v %v", res, err)
+		}
+		if got, _ := s.Current(ctx, "proj", "a", ""); got == nil || got.Text != "one" {
+			t.Fatalf("skip changed existing: %+v", got)
+		}
+	})
+
+	t.Run("replace preserves history", func(t *testing.T) {
+		s := openTestStore(t)
+		if _, err := s.ImportRecords(ctx, []Record{rec("a", "one")}, ImportError, false); err != nil {
+			t.Fatal(err)
+		}
+		res, err := s.ImportRecords(ctx, []Record{rec("a", "two")}, ImportReplace, false)
+		if err != nil || res.Replaced != 1 || res.Inserted != 0 {
+			t.Fatalf("replace: %+v %v", res, err)
+		}
+		got, err := s.Current(ctx, "proj", "a", "")
+		if err != nil || got == nil || got.Text != "two" || got.Supersedes == 0 {
+			t.Fatalf("replace current/supersedes: %+v %v", got, err)
+		}
+		exported, err := s.Export(ctx, "proj")
+		if err != nil || !strings.Contains(string(exported), "one") || !strings.Contains(string(exported), "two") {
+			t.Fatalf("history not preserved: %s %v", exported, err)
+		}
+	})
+}
+
+func TestImportRecordsDryRunWritesNothing(t *testing.T) {
+	ctx := context.Background()
+	s := openTestStore(t)
+	rec := Record{Scope: "proj", Key: "a", Kind: "fact", Text: "one", Evidence: "import"}
+	res, err := s.ImportRecords(ctx, []Record{rec}, ImportError, true)
+	if err != nil || res.Inserted != 1 {
+		t.Fatalf("dry run counts: %+v %v", res, err)
+	}
+	if got, _ := s.Current(ctx, "proj", "a", ""); got != nil {
+		t.Fatal("dry run wrote a record")
+	}
+}
+
+func TestImportRecordsPreservesExpiryAndValidates(t *testing.T) {
+	ctx := context.Background()
+	s := openTestStore(t)
+	future := time.Now().Add(time.Hour).Unix()
+	rec := Record{Scope: "proj", Key: "a", Kind: "fact", Text: "one", Evidence: "import", Expires: future}
+	if _, err := s.ImportRecords(ctx, []Record{rec}, ImportError, false); err != nil {
+		t.Fatal(err)
+	}
+	got, err := s.Current(ctx, "proj", "a", "")
+	if err != nil || got == nil || got.Expires != future {
+		t.Fatalf("expiry not preserved: %+v %v", got, err)
+	}
+	if _, err := s.ImportRecords(ctx, []Record{{Scope: "proj", Key: "x", Kind: "bogus", Text: "t", Evidence: "e"}}, ImportError, false); err == nil {
+		t.Fatal("invalid kind accepted")
+	}
+	if _, err := s.ImportRecords(ctx, []Record{rec}, "bogus", false); err == nil {
+		t.Fatal("invalid policy accepted")
+	}
+}
+
+func TestRebindSourceValidation(t *testing.T) {
+	root := t.TempDir()
+	canonical, err := filepath.EvalSymlinks(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(canonical, "config.txt")
+	if err := os.WriteFile(path, []byte("hello"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	sum := sha256.Sum256([]byte("hello"))
+	digest := hex.EncodeToString(sum[:])
+
+	orig := "/original/project"
+	ok := Source{Root: orig, Path: filepath.Join(orig, "config.txt"), SHA256: digest}
+	bound, err := RebindSource(ok, canonical)
+	if err != nil || bound.Path != path || bound.Root != canonical || bound.SHA256 != digest {
+		t.Fatalf("rebind ok: %+v %v", bound, err)
+	}
+
+	// Relative source path under the original root rebinds the same way.
+	rel := Source{Root: orig, Path: "config.txt", SHA256: digest}
+	if b, err := RebindSource(rel, canonical); err != nil || b.Path != path {
+		t.Fatalf("rebind relative: %+v %v", b, err)
+	}
+
+	cases := map[string]Source{
+		"relative root":   {Root: "original", Path: "config.txt", SHA256: digest},
+		"escape absolute": {Root: orig, Path: "/etc/passwd", SHA256: digest},
+		"escape relative": {Root: orig, Path: "../../etc/passwd", SHA256: digest},
+		"bad digest":      {Root: orig, Path: "config.txt", SHA256: "not-hex"},
+		"wrong digest":    {Root: orig, Path: "config.txt", SHA256: hex.EncodeToString(make([]byte, 32))},
+		"missing dest":    {Root: orig, Path: "absent.txt", SHA256: digest},
+	}
+	for name, src := range cases {
+		if _, err := RebindSource(src, canonical); err == nil {
+			t.Errorf("%s: expected rejection", name)
+		}
+	}
+}
