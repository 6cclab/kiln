+
+// maxImportBytes bounds the import file before it is read into memory.
+const maxImportBytes = 4 << 20
+
+// maxImportRecords caps how many records (active and historical) an import may
+// carry, independently of the byte bound.
+const maxImportRecords = 1000
+
+// importMemory validates an exported memory array, selects the current version
+// of each key, and applies the batch into scope. It writes a single JSON
+// summary on success and nothing on failure. It never starts a model.
+func importMemory(ctx context.Context, s *memory.Store, scope string, global bool, projectRoot, file string, dryRun bool, policy string, out io.Writer) error {
+	data, err := readImportFile(file, maxImportBytes)
+	if err != nil {
+		return err
+	}
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.DisallowUnknownFields()
+	var records []memory.Record
+	if err := dec.Decode(&records); err != nil {
+		return fmt.Errorf("invalid import JSON: %w", err)
+	}
+	if records == nil {
+		return errors.New("import input must be a JSON array")
+	}
+	if dec.More() {
+		return errors.New("import input has trailing data after the JSON array")
+	}
+	if len(records) > maxImportRecords {
+		return fmt.Errorf("import exceeds %d records: %d", maxImportRecords, len(records))
+	}
+
+	// Validate every record, including history, then keep the largest input ID
+	// per key as its current version. Input IDs, scope, created, and supersedes
+	// are never trusted as destination identity or lineage.
+	seen := make(map[int64]bool, len(records))
+	bestID := make(map[string]int64)
+	selected := make(map[string]memory.Record)
+	for _, r := range records {
+		if r.ID <= 0 {
+			return errors.New("import record IDs must be positive")
+		}
+		if seen[r.ID] {
+			return fmt.Errorf("import record IDs must be unique: %d", r.ID)
+		}
+		seen[r.ID] = true
+		dest := memory.Record{Scope: scope, Key: r.Key, Kind: r.Kind, Text: r.Text, Evidence: r.Evidence, Expires: r.Expires}
+		if len(r.Sources) > 0 {
+			if global {
+				// Global rejects any file-bound record; keep the sources so
+				// validation reports it, without reading the project tree.
+				dest.Sources = r.Sources
+			} else {
+				rebound, err := memory.RebindSources(projectRoot, r.Sources)
+				if err != nil {
+					return fmt.Errorf("import source binding: %w", err)
+				}
+				dest.Sources = rebound
+			}
+		}
+		if err := memory.ValidateImportRecord(dest); err != nil {
+			return err
+		}
+		if id, ok := bestID[r.Key]; !ok || r.ID > id {
+			bestID[r.Key] = r.ID
+			selected[r.Key] = dest
+		}
+	}
+
+	keys := make([]string, 0, len(selected))
+	for k := range selected {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	batch := make([]memory.Record, 0, len(keys))
+	for _, k := range keys {
+		batch = append(batch, selected[k])
+	}
+
+	result, err := s.Import(ctx, scope, batch, policy, dryRun)
+	if err != nil {
+		return err
+	}
+	enc := json.NewEncoder(out)
+	return enc.Encode(result)
+}
+
+// readImportFile reads at most max bytes from path, bounding the allocation
+// before it happens. A filename is always required: stdin is never read.
+func readImportFile(path string, max int64) ([]byte, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer diag.Close(f)
+	if info, err := f.Stat(); err == nil && info.Mode().IsRegular() && info.Size() > max {
+		return nil, fmt.Errorf("import file exceeds %d bytes", max)
+	}
+	data, err := io.ReadAll(io.LimitReader(f, max+1))
+	if err != nil {
+		return nil, err
+	}
+	if int64(len(data)) > max {
+		return nil, fmt.Errorf("import file exceeds %d bytes", max)
+	}
+	return data, nil
+}
