+// ImportResult reports how a batch resolved against the destination scope.
+// Counts apply to selected current keys, never to historical rows.
+type ImportResult struct {
+	Inserted int  `json:"inserted"`
+	Replaced int  `json:"replaced"`
+	Skipped  int  `json:"skipped"`
+	DryRun   bool `json:"dry_run"`
+}
+
+// Import applies one selected record per key into scope in a single
+// transaction. Each record's Scope is forced to the destination; its ID,
+// Created, and Supersedes are never trusted. A conflict is any existing active
+// key in the destination, even expired or with stale sources: policy "error"
+// rejects the whole batch, "skip" leaves the existing record untouched, and
+// "replace" supersedes it, preserving local correction history and linking
+// supersedes to the previous destination record only. New records get a fresh
+// ID and the current time; expiry is preserved. A dry run performs the same
+// reads and conflict analysis, then rolls back without writing anything.
+func (s *Store) Import(ctx context.Context, scope string, records []Record, policy string, dryRun bool) (ImportResult, error) {
+	result := ImportResult{DryRun: dryRun}
+	switch policy {
+	case "error", "skip", "replace":
+	default:
+		return result, errors.New("invalid conflict policy")
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return result, err
+	}
+	defer rollback(tx)
+	now := time.Now().Unix()
+	for _, r := range records {
+		r.Scope = scope
+		if err := ValidateImportRecord(r); err != nil {
+			return result, err
+		}
+		var previous int64
+		err := tx.QueryRowContext(ctx, `SELECT id FROM memories WHERE scope=? AND key=? AND active=1`, scope, r.Key).Scan(&previous)
+		conflict := err == nil
+		if err != nil && err != sql.ErrNoRows {
+			return result, err
+		}
+		if conflict {
+			switch policy {
+			case "error":
+				return result, fmt.Errorf("memory key already exists in the destination: %s", r.Key)
+			case "skip":
+				result.Skipped++
+				continue
+			}
+			// replace: supersede the existing active record below.
+			if _, err = tx.ExecContext(ctx, `UPDATE memories SET active=0 WHERE scope=? AND key=? AND active=1`, scope, r.Key); err != nil {
+				return result, err
+			}
+		} else {
+			previous = 0
+		}
+		res, err := tx.ExecContext(ctx, `INSERT INTO memories(scope,key,kind,text,evidence,created,expires,supersedes) VALUES(?,?,?,?,?,?,?,?)`, scope, r.Key, r.Kind, r.Text, r.Evidence, now, r.Expires, previous)
+		if err != nil {
+			return result, err
+		}
+		id, err := res.LastInsertId()
+		if err != nil {
+			return result, err
+		}
+		if _, err = tx.ExecContext(ctx, `INSERT INTO memory_search(rowid,text,evidence) VALUES(?,?,?)`, id, r.Key+"\n"+r.Text, r.Evidence); err != nil {
+			return result, err
+		}
+		if len(r.Sources) > 0 {
+			raw, err := json.Marshal(r.Sources)
+			if err != nil {
+				return result, err
+			}
+			if _, err := tx.ExecContext(ctx, `INSERT INTO memory_sources(memory_id,sources) VALUES(?,?)`, id, string(raw)); err != nil {
+				return result, err
+			}
+		}
+		if conflict {
+			result.Replaced++
+		} else {
+			result.Inserted++
+		}
+	}
+	if dryRun {
+		// The deferred rollback discards every write; counts still describe
+		// what a real run would have done.
+		return result, nil
+	}
+	return result, tx.Commit()
+}
