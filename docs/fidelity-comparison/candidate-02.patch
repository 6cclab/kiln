+	if err := os.WriteFile(filepath.Join(dest, "config.txt"), []byte("changed"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := RebindSources(dest, imported); err == nil {
+		t.Fatal("changed destination file accepted")
+	}
+	// A missing destination file is rejected.
+	if _, err := RebindSources(dest, []Source{{Root: origin, Path: "gone.txt", SHA256: sha}}); err == nil {
+		t.Fatal("missing destination file accepted")
