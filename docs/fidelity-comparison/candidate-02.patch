@@ -0,0 +1,194 @@
+package memory
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func openStore(t *testing.T) *Store {
+	t.Helper()
+	s, err := Open(filepath.Join(t.TempDir(), "memory.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := s.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	return s
+}
+
+func TestImportConflictPolicies(t *testing.T) {
+	ctx := context.Background()
+	s := openStore(t)
+	if _, err := s.Put(ctx, Record{Scope: "p", Key: "a", Kind: "fact", Text: "local", Evidence: "local correction"}); err != nil {
+		t.Fatal(err)
+	}
+	batch := []Record{
+		{Key: "b", Kind: "fact", Text: "new b", Evidence: "import"},
+		{Key: "a", Kind: "fact", Text: "import a", Evidence: "import"},
+	}
+
+	// error rejects the whole batch and must not leave a partial write for b.
+	if _, err := s.Import(ctx, "p", batch, "error", false); err == nil {
+		t.Fatal("error policy accepted a conflict")
+	}
+	if cur, err := s.Current(ctx, "p", "b", ""); err != nil || cur != nil {
+		t.Fatalf("error policy left a partial write: %+v %v", cur, err)
+	}
+	if cur, err := s.Current(ctx, "p", "a", ""); err != nil || cur == nil || cur.Text != "local" {
+		t.Fatalf("error policy changed the existing record: %+v %v", cur, err)
+	}
+
+	// skip leaves the conflicting key untouched and inserts the rest.
+	res, err := s.Import(ctx, "p", batch, "skip", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.Inserted != 1 || res.Skipped != 1 || res.Replaced != 0 {
+		t.Fatalf("skip counts: %+v", res)
+	}
+	if cur, _ := s.Current(ctx, "p", "a", ""); cur == nil || cur.Text != "local" {
+		t.Fatalf("skip changed a: %+v", cur)
+	}
+	if cur, _ := s.Current(ctx, "p", "b", ""); cur == nil || cur.Text != "new b" {
+		t.Fatalf("skip did not insert b: %+v", cur)
+	}
+
+	// replace supersedes the active record, linking lineage and keeping history.
+	res, err = s.Import(ctx, "p", []Record{{Key: "a", Kind: "fact", Text: "import a", Evidence: "import"}}, "replace", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.Replaced != 1 || res.Inserted != 0 || res.Skipped != 0 {
+		t.Fatalf("replace counts: %+v", res)
+	}
+	cur, _ := s.Current(ctx, "p", "a", "")
+	if cur == nil || cur.Text != "import a" || cur.Supersedes == 0 {
+		t.Fatalf("replace lineage: %+v", cur)
+	}
+	exported, err := s.Export(ctx, "p")
+	if err != nil || !strings.Contains(string(exported), "local") {
+		t.Fatalf("replace dropped local correction history: %s %v", exported, err)
+	}
+}
