+			return 2
+		default:
+			files = append(files, tok)
+		}
+	}
+	if len(files) != 1 {
+		writeDiagnostic(stderr, usage)
+		return 2
+	}
+	switch *policy {
+	case "error", "skip", "replace":
+	default:
+		writeDiagnostic(stderr, "kiln memory import: invalid --on-conflict value: "+*policy)
