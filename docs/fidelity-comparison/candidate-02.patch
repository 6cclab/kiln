+func TestRebindSourcesRejectsEscapesAndBadInput(t *testing.T) {
+	dest := t.TempDir()
+	root := string(filepath.Separator) + "orig"
+	good := strings.Repeat("a", 64)
+	cases := []struct {
+		name string
+		src  Source
+	}{
+		{"absolute escape", Source{Root: root, Path: string(filepath.Separator) + "etc/passwd", SHA256: good}},
+		{"relative escape", Source{Root: root, Path: filepath.Join("..", "..", "etc", "passwd"), SHA256: good}},
+		{"relative root", Source{Root: "orig", Path: "x", SHA256: good}},
+		{"bad hash", Source{Root: root, Path: "x.txt", SHA256: "not-hex"}},
+	}
+	for _, c := range cases {
+		if _, err := RebindSources(dest, []Source{c.src}); err == nil {
+			t.Fatalf("%s accepted", c.name)
+		}
+	}
+	many := make([]Source, 9)
+	for i := range many {
+		many[i] = Source{Root: root, Path: "x", SHA256: good}
+	}
+	if _, err := RebindSources(dest, many); err == nil {
+		t.Fatal("nine source files accepted")
+	}
+}
