+
+// parseImportArgs reads the import filename and its optional flags. Flags may
+// follow the filename in any order; unknown flags, a missing --on-conflict
+// value, an invalid policy, a missing filename, or extra positional arguments
+// are usage errors (exit 2). It never reads stdin.
+func parseImportArgs(rest []string, usage string, stderr io.Writer, file *string, dryRun *bool, policy *string) int {
+	var files []string
+	for i := 0; i < len(rest); i++ {
+		tok := rest[i]
+		switch {
+		case tok == "--dry-run":
+			*dryRun = true
+		case tok == "--on-conflict":
+			if i+1 >= len(rest) {
+				writeDiagnostic(stderr, "kiln memory import: --on-conflict needs a value")
+				return 2
+			}
+			*policy = rest[i+1]
+			i++
