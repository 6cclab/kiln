+// RebindSources validates imported source bindings against the destination
+// project and returns bindings rooted in it. Original machine paths are never
+// read: each source's recorded root must be absolute, its path is interpreted
+// lexically within that root, and the resulting repo-relative path is rebound
+// into currentRoot and checked against the local file. Missing, changed,
+// redirected, non-regular, oversized, escaping, or badly hashed sources are
+// rejected. The recorded root need not exist on this machine.
+func RebindSources(currentRoot string, sources []Source) ([]Source, error) {
+	if len(sources) > 8 {
+		return nil, fmt.Errorf("at most eight memory source files are allowed")
+	}
+	canonical, err := filepath.EvalSymlinks(currentRoot)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]Source, 0, len(sources))
+	for _, source := range sources {
+		if !validSHA256(source.SHA256) {
+			return nil, fmt.Errorf("memory source has an invalid hash")
+		}
+		rel, err := relWithinRoot(source.Root, source.Path)
+		if err != nil {
+			return nil, err
+		}
+		destPath := filepath.Join(canonical, rel)
+		digest, err := sourceDigest(canonical, destPath)
+		if err != nil {
+			return nil, err
+		}
+		if digest != source.SHA256 {
+			return nil, fmt.Errorf("memory source does not match the local file")
+		}
+		out = append(out, Source{Root: canonical, Path: destPath, SHA256: digest})
+	}
+	return out, nil
+}
+
+// relWithinRoot derives the repo-relative path of a recorded source lexically,
+// without touching the recorded machine. The root must be absolute; an
+// absolute path is accepted only when lexically contained in that root, and a
+// relative path is interpreted under it. Escapes are rejected.
+func relWithinRoot(root, path string) (string, error) {
+	if !filepath.IsAbs(root) {
+		return "", fmt.Errorf("memory source root must be absolute")
+	}
+	cleanRoot := filepath.Clean(root)
+	var rel string
+	if filepath.IsAbs(path) {
+		r, err := filepath.Rel(cleanRoot, filepath.Clean(path))
+		if err != nil {
+			return "", fmt.Errorf("memory source is outside its root")
+		}
+		rel = r
+	} else {
+		rel = filepath.Clean(path)
+	}
+	if rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) || filepath.IsAbs(rel) {
+		return "", fmt.Errorf("memory source is outside its root")
+	}
+	return rel, nil
+}
+
+// validSHA256 accepts only a lowercase 64-character hex digest.
+func validSHA256(h string) bool {
+	if len(h) != 64 {
+		return false
+	}
+	for _, c := range h {
+		if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) {
+			return false
+		}
+	}
+	return true
+}
