+package cli
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/andrepato/harness/internal/memory"
+)
+
+type importSummary struct {
+	Inserted int  `json:"inserted"`
+	Replaced int  `json:"replaced"`
+	Skipped  int  `json:"skipped"`
+	DryRun   bool `json:"dry_run"`
+}
+
+func memCaller(t *testing.T) func(positional ...string) (int, string, string) {
+	t.Helper()
+	t.Setenv("HOME", t.TempDir())
+	return func(positional ...string) (int, string, string) {
+		t.Helper()
+		var out, stderr bytes.Buffer
+		code := PersonalMemory(context.Background(), Args{Positional: positional}, &out, &stderr)
+		return code, out.String(), stderr.String()
+	}
+}
+
+func writeFile(t *testing.T, content string) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "export.json")
+	if err := os.WriteFile(path, []byte(content), 0600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func parseSummary(t *testing.T, out string) importSummary {
+	t.Helper()
+	var s importSummary
+	if err := json.Unmarshal([]byte(out), &s); err != nil {
+		t.Fatalf("summary %q: %v", out, err)
+	}
+	return s
+}
+
+func TestMemoryImportRoundTripSelectsCurrentVersion(t *testing.T) {
+	call := memCaller(t)
+	if code, _, e := call("remember", "runner", "use npm"); code != 0 {
+		t.Fatalf("remember: %s", e)
+	}
+	if code, _, e := call("remember", "runner", "use pnpm"); code != 0 {
+		t.Fatalf("correct: %s", e)
+	}
+	code, exported, e := call("export")
+	if code != 0 {
+		t.Fatalf("export: %s", e)
+	}
+	// The export carries both the superseded and current versions.
+	if !strings.Contains(exported, "use npm") || !strings.Contains(exported, "use pnpm") {
+		t.Fatalf("export missing history: %s", exported)
+	}
+	file := writeFile(t, exported)
+	if code, _, e := call("forget", "runner"); code != 0 {
+		t.Fatalf("forget: %s", e)
+	}
+	code, out, e := call("import", file)
+	if code != 0 {
+		t.Fatalf("import: %s %s", out, e)
+	}
+	got := parseSummary(t, out)
+	if got != (importSummary{Inserted: 1}) {
+		t.Fatalf("counts: %+v", got)
+	}
+	// Only the highest-ID version becomes current; the stale text is not active.
+	code, after, e := call("export")
+	if code != 0 || !strings.Contains(after, "use pnpm") {
+		t.Fatalf("post-import export: %s %s", after, e)
+	}
+}
+
+func TestMemoryImportConflictPoliciesAndDryRun(t *testing.T) {
+	call := memCaller(t)
+	if code, _, e := call("remember", "k", "first"); code != 0 {
+		t.Fatalf("remember: %s", e)
+	}
+	code, exported, _ := call("export")
+	if code != 0 {
+		t.Fatal("export failed")
+	}
+	file := writeFile(t, exported)
+
+	// Default policy is error: an existing active key rejects the batch.
+	code, out, stderr := call("import", file)
+	if code == 0 || out != "" {
+		t.Fatalf("error policy did not fail cleanly: code=%d out=%q", code, out)
+	}
+	if stderr == "" || strings.Contains(stderr, "first") {
+		t.Fatalf("diagnostic missing or echoed memory text: %q", stderr)
+	}
+
+	// skip leaves the existing record untouched.
+	code, out, _ = call("import", file, "--on-conflict", "skip")
+	if code != 0 || parseSummary(t, out) != (importSummary{Skipped: 1}) {
+		t.Fatalf("skip: code=%d out=%q", code, out)
+	}
+
+	// replace supersedes it.
+	code, out, _ = call("import", file, "--on-conflict=replace")
+	if code != 0 || parseSummary(t, out) != (importSummary{Replaced: 1}) {
+		t.Fatalf("replace: code=%d out=%q", code, out)
+	}
+
+	// dry-run reports a replace but writes nothing new.
+	code, out, _ = call("import", file, "--on-conflict", "replace", "--dry-run")
+	if code != 0 {
+		t.Fatalf("dry run failed: %q", out)
+	}
+	if got := parseSummary(t, out); got != (importSummary{Replaced: 1, DryRun: true}) {
+		t.Fatalf("dry run counts: %+v", got)
+	}
+}
+
+func TestMemoryImportMalformedInputs(t *testing.T) {
+	call := memCaller(t)
+	big := strings.Repeat("a", (4<<20)+1)
+	manyRecords := make([]memory.Record, 1001)
+	for i := range manyRecords {
+		manyRecords[i] = memory.Record{ID: int64(i + 1)}
+	}
+	manyJSON, err := json.Marshal(manyRecords)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct{ name, content string }{
+		{"malformed", "["},
+		{"trailing", "[] []"},
+		{"unknown field", `[{"id":1,"bogus":5,"scope":"x","key":"k","kind":"fact","text":"t","evidence":"e"}]`},
+		{"null", "null"},
+		{"non-array", "{}"},
+		{"oversized", big},
+		{"too many records", string(manyJSON)},
+		{"nonpositive id", `[{"id":0,"scope":"x","key":"k","kind":"fact","text":"t","evidence":"e"}]`},
+		{"duplicate id", `[{"id":1,"scope":"x","key":"a","kind":"fact","text":"t","evidence":"e"},{"id":1,"scope":"x","key":"b","kind":"fact","text":"t","evidence":"e"}]`},
+		{"negative expires", `[{"id":1,"scope":"x","key":"k","kind":"fact","text":"t","evidence":"e","expires":-5}]`},
+		{"bad kind", `[{"id":1,"scope":"x","key":"k","kind":"wat","text":"t","evidence":"e"}]`},
+		{"missing text", `[{"id":1,"scope":"x","key":"k","kind":"fact","text":"","evidence":"e"}]`},
+	}
+	for _, c := range cases {
+		file := writeFile(t, c.content)
+		code, out, stderr := call("import", file)
+		if code != 1 || out != "" || stderr == "" {
+			t.Fatalf("%s: code=%d out=%q stderr=%q", c.name, code, out, stderr)
+		}
+	}
+}
+
+func TestMemoryImportFlagErrors(t *testing.T) {
+	call := memCaller(t)
+	file := writeFile(t, "[]")
+	cases := [][]string{
+		{"import"},                                // missing filename
+		{"import", file, "extra"},                 // extra positional
+		{"import", file, "--bogus"},               // unknown flag
+		{"import", file, "--on-conflict"},         // missing value
+		{"import", file, "--on-conflict", "nope"}, // invalid policy
+		{"import", file, "--dry-run=true"},        // malformed boolean flag
+	}
+	for _, args := range cases {
+		code, out, _ := call(args...)
+		if code != 2 || out != "" {
+			t.Fatalf("%v: expected usage error, got code=%d out=%q", args, code, out)
+		}
+	}
+	// A valid empty array imports nothing successfully.
+	code, out, e := call("import", file)
+	if code != 0 || parseSummary(t, out) != (importSummary{}) {
+		t.Fatalf("empty import: code=%d out=%q err=%q", code, out, e)
+	}
+}
+
+func TestMemoryImportGlobalRejectsSourceBearingHistory(t *testing.T) {
+	call := memCaller(t)
+	// Lower-ID record is historical and source-bearing (invalid for global);
+	// the selected higher-ID record is a clean preference. The batch must fail.
+	recs := []memory.Record{
+		{ID: 1, Scope: "ignored", Key: "k", Kind: "preference", Text: "old", Evidence: "e",
+			Sources: []memory.Source{{Root: string(filepath.Separator) + "o", Path: "f", SHA256: strings.Repeat("a", 64)}}},
+		{ID: 2, Scope: "ignored", Key: "k", Kind: "preference", Text: "new", Evidence: "e"},
+	}
+	data, err := json.Marshal(recs)
+	if err != nil {
+		t.Fatal(err)
+	}
+	file := writeFile(t, string(data))
+	code, out, stderr := call("global", "import", file)
+	if code != 1 || out != "" || stderr == "" {
+		t.Fatalf("global source-bearing history accepted: code=%d out=%q", code, out)
+	}
+	// Nothing was written.
+	if code, after, _ := call("global", "export"); code != 0 || !strings.Contains(after, "[]") {
+		t.Fatalf("global import wrote on failure: %s", after)
+	}
+}
+
+func TestMemoryImportGlobalPreferenceRoundTrip(t *testing.T) {
+	call := memCaller(t)
+	recs := []memory.Record{{ID: 1, Scope: "ignored", Key: "style", Kind: "preference", Text: "concise", Evidence: "user"}}
+	data, _ := json.Marshal(recs)
+	file := writeFile(t, string(data))
+	code, out, e := call("global", "import", file)
+	if code != 0 || parseSummary(t, out) != (importSummary{Inserted: 1}) {
+		t.Fatalf("global import: code=%d out=%q err=%q", code, out, e)
+	}
+	if code, after, _ := call("global", "export"); code != 0 || !strings.Contains(after, "concise") {
+		t.Fatalf("global import not visible: %s", after)
+	}
+}
