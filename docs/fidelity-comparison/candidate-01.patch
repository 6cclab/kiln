+package memory
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func newStore(t *testing.T) *Store {
+	t.Helper()
+	s, err := Open(filepath.Join(t.TempDir(), "memory.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := s.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	return s
+}
+
+func fileDigest(t *testing.T, root, name, body string) (abs, digest string) {
+	t.Helper()
+	abs = filepath.Join(root, name)
+	if err := os.MkdirAll(filepath.Dir(abs), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(abs, []byte(body), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	sum := sha256.Sum256([]byte(body))
+	return abs, hex.EncodeToString(sum[:])
+}
+
+// A plain export round-trips: every selected key is inserted into the current
+// project scope, and only the highest-id version of a key becomes current.
+func TestImportSelectsHighestIDPerKey(t *testing.T) {
+	s := newStore(t)
+	ctx := context.Background()
+	root := t.TempDir()
+	records := []Record{
+		{ID: 1, Scope: "whatever", Key: "runner", Kind: "fact", Text: "uses npm", Evidence: "history"},
+		{ID: 3, Scope: "whatever", Key: "runner", Kind: "fact", Text: "uses pnpm", Evidence: "newest"},
+		{ID: 2, Scope: "whatever", Key: "style", Kind: "preference", Text: "concise", Evidence: "user"},
+	}
+	counts, err := s.Import(ctx, "proj:/x", root, records, ConflictError, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if counts.Inserted != 2 || counts.Replaced != 0 || counts.Skipped != 0 {
+		t.Fatalf("counts = %+v", counts)
+	}
+	cur, err := s.Current(ctx, "proj:/x", "runner", root)
+	if err != nil || cur == nil {
+		t.Fatalf("current runner: %v %v", cur, err)
+	}
+	if cur.Text != "uses pnpm" {
+		t.Fatalf("selected version = %q, want newest", cur.Text)
+	}
+	if cur.Scope != "proj:/x" {
+		t.Fatalf("wrote imported scope %q instead of destination", cur.Scope)
+	}
+	// The imported history is not replayed: only the one selected row exists.
+	export, err := s.Export(ctx, "proj:/x")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n := countKey(string(export), "runner"); n != 1 {
+		t.Fatalf("runner rows after import = %d, want 1", n)
+	}
+}
+
+func countKey(export, key string) int {
+	// crude occurrence count of "key": "<key>"
+	n := 0
+	needle := `"key": "` + key + `"`
+	for i := 0; i+len(needle) <= len(export); i++ {
+		if export[i:i+len(needle)] == needle {
+			n++
+		}
+	}
+	return n
+}
+
+func TestImportConflictPolicies(t *testing.T) {
+	ctx := context.Background()
+	root := t.TempDir()
+	seed := func(s *Store) {
+		if _, err := s.Put(ctx, Record{Scope: "proj:/x", Key: "runner", Kind: "fact", Text: "local value", Evidence: "local correction"}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	incoming := []Record{{ID: 9, Scope: "src", Key: "runner", Kind: "fact", Text: "imported value", Evidence: "export"}}
+
+	t.Run("error rejects the whole batch", func(t *testing.T) {
+		s := newStore(t)
+		seed(s)
+		batch := append([]Record{{ID: 1, Scope: "src", Key: "fresh", Kind: "fact", Text: "new", Evidence: "export"}}, incoming...)
+		if _, err := s.Import(ctx, "proj:/x", root, batch, ConflictError, false); err == nil {
+			t.Fatal("expected conflict error")
+		}
+		// Nothing applied: the non-conflicting key must not have been inserted.
+		if cur, _ := s.Current(ctx, "proj:/x", "fresh", root); cur != nil {
+			t.Fatal("error policy applied part of the batch")
+		}
+		if cur, _ := s.Current(ctx, "proj:/x", "runner", root); cur == nil || cur.Text != "local value" {
+			t.Fatal("error policy changed the existing record")
+		}
+	})
+
+	t.Run("skip leaves the existing record untouched", func(t *testing.T) {
+		s := newStore(t)
+		seed(s)
+		counts, err := s.Import(ctx, "proj:/x", root, incoming, ConflictSkip, false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if counts.Skipped != 1 || counts.Inserted != 0 || counts.Replaced != 0 {
+			t.Fatalf("counts = %+v", counts)
+		}
+		cur, _ := s.Current(ctx, "proj:/x", "runner", root)
+		if cur == nil || cur.Text != "local value" {
+			t.Fatalf("skip changed the record: %+v", cur)
+		}
+	})
+
+	t.Run("replace supersedes and preserves local history", func(t *testing.T) {
+		s := newStore(t)
+		seed(s)
+		counts, err := s.Import(ctx, "proj:/x", root, incoming, ConflictReplace, false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if counts.Replaced != 1 || counts.Inserted != 0 || counts.Skipped != 0 {
+			t.Fatalf("counts = %+v", counts)
+		}
+		cur, _ := s.Current(ctx, "proj:/x", "runner", root)
+		if cur == nil || cur.Text != "imported value" {
+			t.Fatalf("replace did not install the import: %+v", cur)
+		}
+		if cur.Supersedes == 0 {
+			t.Fatal("replace did not link supersedes to the previous record")
+		}
+		// The local record is preserved as inspectable history.
+		export, _ := s.Export(ctx, "proj:/x")
+		if countKey(string(export), "runner") != 2 {
+			t.Fatalf("local history not preserved:\n%s", export)
+		}
+	})
+}
+
+func TestImportDryRunWritesNothing(t *testing.T) {
+	ctx := context.Background()
+	root := t.TempDir()
+	s := newStore(t)
+	if _, err := s.Put(ctx, Record{Scope: "proj:/x", Key: "runner", Kind: "fact", Text: "local", Evidence: "local"}); err != nil {
+		t.Fatal(err)
+	}
+	batch := []Record{
+		{ID: 1, Scope: "src", Key: "fresh", Kind: "fact", Text: "new", Evidence: "export"},
+		{ID: 2, Scope: "src", Key: "runner", Kind: "fact", Text: "imported", Evidence: "export"},
+	}
+	counts, err := s.Import(ctx, "proj:/x", root, batch, ConflictReplace, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if counts.Inserted != 1 || counts.Replaced != 1 {
+		t.Fatalf("dry-run counts = %+v", counts)
+	}
+	if cur, _ := s.Current(ctx, "proj:/x", "fresh", root); cur != nil {
+		t.Fatal("dry run inserted a record")
+	}
+	if cur, _ := s.Current(ctx, "proj:/x", "runner", root); cur == nil || cur.Text != "local" {
+		t.Fatal("dry run modified an existing record")
+	}
+}
+
+func TestImportValidationRejectsAndLeavesDBUnchanged(t *testing.T) {
+	ctx := context.Background()
+	root := t.TempDir()
+	cases := map[string][]Record{
+		"nonpositive id":  {{ID: 0, Scope: "s", Key: "k", Kind: "fact", Text: "t", Evidence: "e"}},
+		"duplicate id":    {{ID: 1, Scope: "s", Key: "a", Kind: "fact", Text: "t", Evidence: "e"}, {ID: 1, Scope: "s", Key: "b", Kind: "fact", Text: "t", Evidence: "e"}},
+		"invalid kind":    {{ID: 1, Scope: "s", Key: "k", Kind: "bogus", Text: "t", Evidence: "e"}},
+		"negative expiry": {{ID: 1, Scope: "s", Key: "k", Kind: "fact", Text: "t", Evidence: "e", Expires: -1}},
+		"empty evidence":  {{ID: 1, Scope: "s", Key: "k", Kind: "fact", Text: "t", Evidence: " "}},
+	}
+	for name, batch := range cases {
+		t.Run(name, func(t *testing.T) {
+			s := newStore(t)
+			if _, err := s.Import(ctx, "proj:/x", root, batch, ConflictError, false); err == nil {
+				t.Fatal("expected validation error")
+			}
+			export, _ := s.Export(ctx, "proj:/x")
+			if string(export) != "[]" {
+				t.Fatalf("db changed on validation failure: %s", export)
+			}
+		})
+	}
+}
+
+func TestImportGlobalRejectsSourcesAndNonPreferences(t *testing.T) {
+	ctx := context.Background()
+	root := t.TempDir()
+	abs, digest := fileDigest(t, root, "f.txt", "body")
+	cases := map[string][]Record{
+		// A non-preference anywhere, even as history, is rejected.
+		"historical non-preference": {
+			{ID: 1, Scope: "s", Key: "k", Kind: "fact", Text: "old", Evidence: "e"},
+			{ID: 2, Scope: "s", Key: "k", Kind: "preference", Text: "new", Evidence: "e"},
+		},
+		"source on preference": {
