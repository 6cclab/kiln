diff --git a/internal/cli/memory_import.go b/internal/cli/memory_import.go
new file mode 100644
index 0000000..f72538e
--- /dev/null
+++ b/internal/cli/memory_import.go
@@ -0,0 +1,198 @@
+package cli
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/andrepato/harness/internal/diag"
+	"github.com/andrepato/harness/internal/memory"
+)
+
+// maxImportBytes bounds how much of the input file is read before it is parsed,
+// so an oversized or runaway file cannot force a large allocation.
+const maxImportBytes = 4 << 20
+
+// IsMemoryImport reports whether the arguments after `memory` select the
+// `import` subcommand. Import carries its own flags (`--dry-run`,
+// `--on-conflict`) and is dispatched before the global flag parser, like
+// `eval` and `mcp <sub>`, so those flags are not misread as unknown globals.
+func IsMemoryImport(sub []string) bool {
+	if len(sub) >= 1 && sub[0] == "import" {
+		return true
+	}
+	if len(sub) >= 2 && sub[0] == "global" && sub[1] == "import" {
+		return true
+	}
+	return false
+}
+
+// PersonalMemoryImport implements `kiln memory [global] import <file>
+// [--dry-run] [--on-conflict error|skip|replace]`. It is a local management
+// command and never starts a model. On success it prints one JSON object with
+// integer inserted/replaced/skipped counts and a boolean dry_run; on failure it
+// returns nonzero with a diagnostic and no success JSON, never echoing memory
+// text.
+func PersonalMemoryImport(ctx context.Context, sub []string, out, stderr io.Writer) int {
+	const usage = "usage: kiln memory [global] import <file> [--dry-run] [--on-conflict error|skip|replace]"
+	global := false
+	i := 0
+	if len(sub) > i && sub[i] == "global" {
+		global = true
+		i++
+	}
+	if len(sub) <= i || sub[i] != "import" {
+		writeDiagnostic(stderr, usage)
+		return 2
+	}
+	i++
+	rest := sub[i:]
+
+	file := ""
+	fileSet := false
+	dryRun := false
+	policy := memory.ConflictError
+	for j := 0; j < len(rest); j++ {
+		tok := rest[j]
+		if !strings.HasPrefix(tok, "-") {
+			if fileSet {
+				writeDiagnostic(stderr, "kiln: unexpected extra argument: "+tok)
+				return 2
+			}
+			file = tok
+			fileSet = true
+			continue
+		}
+		name := tok
+		value := ""
+		hasValue := false
+		if eq := strings.IndexByte(tok, '='); eq != -1 {
+			name = tok[:eq]
+			value = tok[eq+1:]
+			hasValue = true
+		}
+		switch name {
+		case "--dry-run":
+			if hasValue {
+				writeDiagnostic(stderr, "kiln: --dry-run takes no value")
+				return 2
+			}
+			dryRun = true
+		case "--on-conflict":
+			if !hasValue {
+				if j+1 >= len(rest) || strings.HasPrefix(rest[j+1], "-") {
+					writeDiagnostic(stderr, "kiln: --on-conflict needs a value (error|skip|replace)")
+					return 2
+				}
+				value = rest[j+1]
+				j++
+			}
+			p, ok := memory.ParseImportPolicy(value)
+			if !ok {
+				writeDiagnostic(stderr, "kiln: invalid --on-conflict value "+value+" (want error|skip|replace)")
+				return 2
+			}
+			policy = p
+		default:
+			writeDiagnostic(stderr, "kiln: unknown flag: "+name)
+			return 2
+		}
+	}
+	if !fileSet {
+		writeDiagnostic(stderr, usage)
+		return 2
+	}
+
+	records, err := readImportFile(file)
+	if err != nil {
+		writeDiagnostic(stderr, "kiln:", err)
+		return 1
+	}
+
+	cwd, err := os.Getwd()
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	home, err := os.UserHomeDir()
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	scope := memoryScope(cwd)
+	projectRoot := memoryProjectRoot(cwd)
+	if global {
+		scope = memory.GlobalPreferencesScope
+	}
+
+	s, err := memory.Open(filepath.Join(home, ".kiln", "memory.db"))
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	defer diag.Close(s)
+
+	counts, err := s.Import(ctx, scope, projectRoot, records, policy, dryRun)
+	if err != nil {
+		writeDiagnostic(stderr, "kiln:", err)
+		return 1
+	}
+
+	payload, err := json.Marshal(struct {
+		Inserted int  `json:"inserted"`
+		Replaced int  `json:"replaced"`
+		Skipped  int  `json:"skipped"`
+		DryRun   bool `json:"dry_run"`
+	}{counts.Inserted, counts.Replaced, counts.Skipped, dryRun})
+	if err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	if _, err := fmt.Fprintln(out, string(payload)); err != nil {
+		writeDiagnostic(stderr, err)
+		return 1
+	}
+	return 0
+}
+
+// readImportFile reads the export file under a hard byte cap and parses it as
+// exactly one JSON array in the export format. It rejects a missing or
+// oversized file, malformed JSON, unknown record or source fields, a non-array
+// or null top-level value, and any trailing content after the array.
+func readImportFile(path string) ([]memory.Record, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer diag.Close(f)
+	if info, err := f.Stat(); err == nil && info.Size() > maxImportBytes {
+		return nil, errors.New("import file exceeds 4 MiB")
+	}
+	data, err := io.ReadAll(io.LimitReader(f, maxImportBytes+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(data) > maxImportBytes {
+		return nil, errors.New("import file exceeds 4 MiB")
+	}
+	if trimmed := bytes.TrimLeft(data, " \t\r\n"); len(trimmed) == 0 || trimmed[0] != '[' {
+		return nil, errors.New("import must be a single JSON array in the export format")
+	}
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.DisallowUnknownFields()
+	var records []memory.Record
+	if err := dec.Decode(&records); err != nil {
+		return nil, fmt.Errorf("invalid import JSON: %w", err)
+	}
+	var trailing json.RawMessage
+	if err := dec.Decode(&trailing); !errors.Is(err, io.EOF) {
+		return nil, errors.New("import file has trailing data after the JSON array")
+	}
+	return records, nil
+}
diff --git a/internal/cli/memory_import_test.go b/internal/cli/memory_import_test.go
new file mode 100644
index 0000000..f0a385c
--- /dev/null
+++ b/internal/cli/memory_import_test.go
@@ -0,0 +1,176 @@
+package cli
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func writeImport(t *testing.T, body string) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "export.json")
+	if err := os.WriteFile(path, []byte(body), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func runImport(t *testing.T, sub ...string) (int, string, string) {
+	t.Helper()
+	var out, errb bytes.Buffer
+	code := PersonalMemoryImport(context.Background(), sub, &out, &errb)
+	return code, out.String(), errb.String()
+}
+
+func runMemory(t *testing.T, positional ...string) (int, string, string) {
+	t.Helper()
+	var out, errb bytes.Buffer
+	code := PersonalMemory(context.Background(), Args{Positional: positional}, &out, &errb)
+	return code, out.String(), errb.String()
+}
+
+func TestMemoryImportArgErrors(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	file := writeImport(t, "[]")
+	cases := [][]string{
+		{"import"},                                     // missing file
+		{"import", file, "--bogus"},                    // unknown flag
+		{"import", file, "--on-conflict"},              // missing value
+		{"import", file, "--on-conflict", "--dry-run"}, // missing value (next is a flag)
+		{"import", file, "--on-conflict", "nonsense"},  // invalid policy
+		{"import", file, "extra"},                      // extra positional
+		{"import", file, "--dry-run=yes"},              // boolean flag with value
+	}
+	for _, sub := range cases {
+		code, out, _ := runImport(t, sub...)
+		if code != 2 {
+			t.Errorf("%v: code = %d, want 2", sub, code)
+		}
+		if out != "" {
+			t.Errorf("%v: wrote success output %q", sub, out)
+		}
+	}
+}
+
+func TestMemoryImportFileErrors(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	cases := map[string]string{
+		"malformed":     "[",
+		"trailing":      "[] []",
+		"null":          "null",
+		"object":        `{"a":1}`,
+		"unknown field": `[{"id":1,"key":"k","kind":"fact","text":"t","evidence":"e","mystery":true}]`,
+		"empty":         "",
+	}
+	for name, body := range cases {
+		t.Run(name, func(t *testing.T) {
+			code, out, errb := runImport(t, "import", writeImport(t, body))
+			if code != 1 {
+				t.Fatalf("code = %d (%s)", code, errb)
+			}
+			if out != "" {
+				t.Fatalf("wrote success output %q", out)
+			}
+		})
+	}
+}
+
+func TestMemoryImportRoundTrip(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	// Build an export file by exporting an empty scope and crafting records.
+	export := `[
+		{"id": 5, "scope": "ignored", "key": "runner", "kind": "fact", "text": "uses pnpm", "evidence": "export"},
+		{"id": 2, "scope": "ignored", "key": "runner", "kind": "fact", "text": "uses npm", "evidence": "old"},
+		{"id": 7, "scope": "ignored", "key": "style", "kind": "preference", "text": "concise", "evidence": "user"}
+	]`
+	file := writeImport(t, export)
+
+	// Dry run first: reports counts but writes nothing.
+	code, out, errb := runImport(t, "import", file, "--dry-run")
+	if code != 0 {
+		t.Fatalf("dry run: %d %s", code, errb)
+	}
+	var dry struct {
+		Inserted, Replaced, Skipped int
+		DryRun                      bool `json:"dry_run"`
+	}
+	if err := json.Unmarshal([]byte(out), &dry); err != nil {
+		t.Fatalf("dry output %q: %v", out, err)
+	}
+	if dry.Inserted != 2 || !dry.DryRun {
+		t.Fatalf("dry counts = %+v", dry)
+	}
+	if code, exp, _ := runMemory(t, "export"); code != 0 || !strings.Contains(exp, "[]") {
+		t.Fatalf("dry run wrote records: %s", exp)
+	}
+
+	// Real import.
+	code, out, errb = runImport(t, "import", file)
+	if code != 0 {
+		t.Fatalf("import: %d %s", code, errb)
+	}
+	if !strings.Contains(out, `"inserted":2`) || !strings.Contains(out, `"dry_run":false`) {
+		t.Fatalf("import output = %s", out)
+	}
+	code, exp, _ := runMemory(t, "export")
+	if code != 0 || !strings.Contains(exp, "uses pnpm") || strings.Contains(exp, "uses npm") {
+		t.Fatalf("import did not select the newest version: %s", exp)
+	}
+
+	// Default conflict policy is error: a re-import of the same keys fails.
+	if code, out, _ := runImport(t, "import", file); code != 1 || out != "" {
+		t.Fatalf("expected conflict failure, got %d %q", code, out)
+	}
+	// skip leaves them untouched.
+	code, out, _ = runImport(t, "import", file, "--on-conflict", "skip")
+	if code != 0 || !strings.Contains(out, `"skipped":2`) {
+		t.Fatalf("skip: %d %s", code, out)
+	}
+	// replace supersedes.
+	code, out, _ = runImport(t, "import", file, "--on-conflict=replace")
+	if code != 0 || !strings.Contains(out, `"replaced":2`) {
+		t.Fatalf("replace: %d %s", code, out)
+	}
+}
+
+func TestMemoryImportGlobalPreferences(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	file := writeImport(t, `[{"id":1,"scope":"x","key":"tone","kind":"preference","text":"concise","evidence":"user"}]`)
+	code, out, errb := runImport(t, "global", "import", file)
+	if code != 0 {
+		t.Fatalf("global import: %d %s", code, errb)
+	}
+	if !strings.Contains(out, `"inserted":1`) {
+		t.Fatalf("global import output = %s", out)
+	}
+	if code, exp, _ := runMemory(t, "global", "export"); code != 0 || !strings.Contains(exp, "concise") {
+		t.Fatalf("global export after import: %s", exp)
+	}
+	// A project record with a source is rejected under global scope.
+	bad := writeImport(t, `[{"id":1,"scope":"x","key":"k","kind":"fact","text":"t","evidence":"e"}]`)
+	if code, _, _ := runImport(t, "global", "import", bad); code != 1 {
+		t.Fatal("global import accepted a non-preference")
+	}
+}
+
+func TestMemoryImportTooLarge(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	big := filepath.Join(t.TempDir(), "big.json")
+	f, err := os.Create(big)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := f.Truncate((4 << 20) + 1); err != nil {
+		t.Fatal(err)
+	}
+	if err := f.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if code, out, _ := runImport(t, "import", big); code != 1 || out != "" {
+		t.Fatalf("oversized file: code %d out %q", code, out)
+	}
+}
