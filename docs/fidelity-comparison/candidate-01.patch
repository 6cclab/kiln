diff --git a/internal/memory/import.go b/internal/memory/import.go
new file mode 100644
index 0000000..eb670c4
--- /dev/null
+++ b/internal/memory/import.go
@@ -0,0 +1,299 @@
+package memory
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+)
+
+// ImportPolicy decides what happens when an imported key already has an active
+// record in the destination scope.
+type ImportPolicy int
+
+const (
+	// ConflictError rejects the entire batch if any imported key already exists.
+	ConflictError ImportPolicy = iota
+	// ConflictSkip leaves an existing key untouched and imports the rest.
+	ConflictSkip
+	// ConflictReplace supersedes an existing key, preserving its local history.
+	ConflictReplace
+)
+
+// ParseImportPolicy maps a flag value to a policy. The default is ConflictError.
+func ParseImportPolicy(value string) (ImportPolicy, bool) {
+	switch value {
+	case "error":
+		return ConflictError, true
+	case "skip":
+		return ConflictSkip, true
+	case "replace":
+		return ConflictReplace, true
+	}
+	return ConflictError, false
+}
+
+// ImportCounts reports how many selected keys were (or, in a dry run, would be)
+// inserted, replaced, or skipped. Counts describe current keys, not the
+// historical rows the export carried.
+type ImportCounts struct {
+	Inserted int
+	Replaced int
+	Skipped  int
+}
+
+// maxImportRecords bounds the history an export may carry so a single import
+// cannot fan out into an unbounded transaction.
+const maxImportRecords = 1000
+
+// Import validates an export (every record, including historical ones), selects
+// the highest-id record for each key as its current version, and applies the
+// selected batch to the destination scope in a single transaction. The imported
+// scope, created, and supersedes values are never trusted as destination
+// identity or lineage. A dry run performs the same validation and conflict
+// analysis but writes nothing; opening or creating the database is still
+// allowed. Any validation, conflict (under ConflictError), or write failure
+// leaves every destination memory, search entry, and source binding unchanged.
+func (s *Store) Import(ctx context.Context, scope, projectRoot string, records []Record, policy ImportPolicy, dryRun bool) (ImportCounts, error) {
+	var zero ImportCounts
+	if scope == "" {
+		return zero, errors.New("import scope is required")
+	}
+	if len(records) > maxImportRecords {
+		return zero, fmt.Errorf("import carries more than %d records", maxImportRecords)
+	}
+	global := scope == GlobalPreferencesScope
+
+	// Validate every record and rebind any source bindings into this project
+	// before touching the database. A stale or escaping source anywhere in the
+	// history — not only on the selected version — rejects the whole batch.
+	type prepared struct {
+		rec     Record
+		sources []Source
+	}
+	prep := make([]prepared, 0, len(records))
+	seen := make(map[int64]bool, len(records))
+	for _, r := range records {
+		if r.ID <= 0 {
+			return zero, errors.New("import record ids must be positive")
+		}
+		if seen[r.ID] {
+			return zero, errors.New("import record ids must be unique")
+		}
+		seen[r.ID] = true
+		if err := validateImportFields(r); err != nil {
+			return zero, err
+		}
+		if global {
+			if r.Kind != "preference" || len(r.Sources) != 0 {
+				return zero, errors.New("global import accepts preferences without project file sources only")
+			}
+			prep = append(prep, prepared{rec: r})
+			continue
+		}
+		if len(r.Sources) > 8 {
+			return zero, errors.New("a project memory may bind at most eight source files")
+		}
+		var rebound []Source
+		for _, src := range r.Sources {
+			dest, err := rebindSource(projectRoot, src)
+			if err != nil {
+				return zero, err
+			}
+			rebound = append(rebound, dest)
+		}
+		prep = append(prep, prepared{rec: r, sources: rebound})
+	}
+
+	// Choose the largest input id per key as its current version. Ids are
+	// unique across the input, so the winner is unambiguous.
+	type selection struct {
+		rec     Record
+		sources []Source
+	}
+	selected := make(map[string]selection, len(prep))
+	for _, p := range prep {
+		if cur, ok := selected[p.rec.Key]; !ok || p.rec.ID > cur.rec.ID {
+			selected[p.rec.Key] = selection(p)
+		}
+	}
+	keys := make([]string, 0, len(selected))
+	for k := range selected {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return zero, err
+	}
+	defer rollback(tx)
+
+	// A conflict is any existing active destination key, even if it is expired
+	// or its source is stale.
+	prev := make(map[string]int64, len(keys))
+	conflicts := 0
+	for _, key := range keys {
+		var id int64
+		err := tx.QueryRowContext(ctx, `SELECT id FROM memories WHERE scope=? AND key=? AND active=1`, scope, key).Scan(&id)
+		if errors.Is(err, sql.ErrNoRows) {
+			continue
+		}
+		if err != nil {
+			return zero, err
+		}
+		prev[key] = id
+		conflicts++
+	}
+	if policy == ConflictError && conflicts > 0 {
+		return zero, fmt.Errorf("import conflicts with %d existing memory key(s); rerun with --on-conflict skip or replace", conflicts)
+	}
+
+	now := time.Now().Unix()
+	var counts ImportCounts
+	for _, key := range keys {
+		previous, exists := prev[key]
+		if exists {
+			if policy == ConflictSkip {
+				counts.Skipped++
+				continue
+			}
+			// ConflictReplace supersedes the previous destination record.
+			if !dryRun {
+				if err := insertImported(ctx, tx, scope, selected[key].rec, selected[key].sources, previous, now); err != nil {
+					return zero, err
+				}
+			}
+			counts.Replaced++
+			continue
+		}
+		if !dryRun {
+			if err := insertImported(ctx, tx, scope, selected[key].rec, selected[key].sources, 0, now); err != nil {
+				return zero, err
+			}
+		}
+		counts.Inserted++
+	}
+
+	if dryRun {
+		return counts, nil
+	}
+	if err := tx.Commit(); err != nil {
+		return zero, err
+	}
+	return counts, nil
+}
+
+// insertImported writes one imported record as the new current version. It
+// assigns a destination id and creation time, preserves the imported expiry,
+// and links supersedes to the previous destination record only (0 when none).
+func insertImported(ctx context.Context, tx *sql.Tx, scope string, r Record, sources []Source, previous, now int64) error {
+	if previous != 0 {
+		if _, err := tx.ExecContext(ctx, `UPDATE memories SET active=0 WHERE id=? AND active=1`, previous); err != nil {
+			return err
+		}
+	}
+	res, err := tx.ExecContext(ctx, `INSERT INTO memories(scope,key,kind,text,evidence,created,expires,supersedes) VALUES(?,?,?,?,?,?,?,?)`, scope, r.Key, r.Kind, r.Text, r.Evidence, now, r.Expires, previous)
+	if err != nil {
+		return err
+	}
+	id, err := res.LastInsertId()
+	if err != nil {
+		return err
+	}
+	if _, err := tx.ExecContext(ctx, `INSERT INTO memory_search(rowid,text,evidence) VALUES(?,?,?)`, id, r.Key+"\n"+r.Text, r.Evidence); err != nil {
+		return err
+	}
+	if len(sources) > 0 {
+		raw, err := json.Marshal(sources)
+		if err != nil {
+			return err
+		}
+		if _, err := tx.ExecContext(ctx, `INSERT INTO memory_sources(memory_id,sources) VALUES(?,?)`, id, string(raw)); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// validateImportFields enforces the same field and kind limits as Put, plus a
+// nonnegative expiry. Messages never echo the record text or evidence.
+func validateImportFields(r Record) error {
+	if strings.TrimSpace(r.Key) == "" || strings.TrimSpace(r.Text) == "" || strings.TrimSpace(r.Evidence) == "" {
+		return errors.New("import record is missing key, text or evidence")
+	}
+	if len(r.Key) > 256 || len(r.Text) > 8192 || len(r.Evidence) > 2048 {
+		return errors.New("import record exceeds field limits")
+	}
+	switch r.Kind {
+	case "preference", "fact", "procedure", "observation":
+	default:
+		return errors.New("import record has an invalid kind")
+	}
+	if r.Expires < 0 {
+		return errors.New("import record has a negative expiry")
+	}
+	return nil
+}
+
+// rebindSource rebinds one exported source binding into this project's root and
+// validates it against the destination file. The original root must be absolute
+// but is never read: an absolute source path is accepted only when lexically
+// contained in that root, and a relative one is interpreted under it. The
+// rebound destination path is hashed (which also rejects missing, nonregular,
+// oversized, and symlink-escaping files) and must match the exported digest.
+func rebindSource(projectRoot string, src Source) (Source, error) {
+	if !filepath.IsAbs(src.Root) {
+		return Source{}, errors.New("import source root must be absolute")
+	}
+	if !validSHA256(src.SHA256) {
+		return Source{}, errors.New("import source has an invalid hash")
+	}
+	root := filepath.Clean(src.Root)
+	var rel string
+	if filepath.IsAbs(src.Path) {
+		r, err := filepath.Rel(root, filepath.Clean(src.Path))
+		if err != nil {
+			return Source{}, errors.New("import source path is outside its original root")
+		}
+		rel = r
+	} else {
+		rel = filepath.Clean(src.Path)
+	}
+	if rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) || filepath.IsAbs(rel) {
+		return Source{}, errors.New("import source path escapes its original root")
+	}
+	canonical, err := filepath.EvalSymlinks(projectRoot)
+	if err != nil {
+		return Source{}, err
+	}
+	destPath := filepath.Join(canonical, rel)
+	digest, err := sourceDigest(canonical, destPath)
+	if err != nil {
+		return Source{}, err
+	}
+	if !strings.EqualFold(digest, src.SHA256) {
+		return Source{}, errors.New("import source does not match the current project file")
+	}
+	return Source{Root: canonical, Path: destPath, SHA256: digest}, nil
+}
+
+// validSHA256 reports whether s is exactly 64 hexadecimal digits.
+func validSHA256(s string) bool {
+	if len(s) != 64 {
+		return false
+	}
+	for _, c := range s {
+		switch {
+		case c >= '0' && c <= '9', c >= 'a' && c <= 'f', c >= 'A' && c <= 'F':
+		default:
+			return false
+		}
+	}
+	return true
+}
