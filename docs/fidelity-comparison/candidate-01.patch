+func TestImportProjectSources(t *testing.T) {
+	ctx := context.Background()
+	root := t.TempDir()
+	canonical, err := filepath.EvalSymlinks(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	abs, digest := fileDigest(t, canonical, "docs/style.md", "PROJECT STYLE")
+
+	t.Run("matching source rebinds and imports", func(t *testing.T) {
+		s := newStore(t)
+		// Exported from a different machine root; only the relative path matters.
+		src := Source{Root: "/elsewhere/project", Path: "/elsewhere/project/docs/style.md", SHA256: digest}
+		counts, err := s.Import(ctx, "proj:/x", root, []Record{{ID: 1, Scope: "s", Key: "k", Kind: "observation", Text: "t", Evidence: "e", Sources: []Source{src}}}, ConflictError, false)
+		if err != nil {
+			t.Fatalf("import with matching source: %v", err)
+		}
+		if counts.Inserted != 1 {
+			t.Fatalf("counts = %+v", counts)
+		}
+		cur, err := s.Current(ctx, "proj:/x", "k", root)
+		if err != nil || cur == nil {
+			t.Fatalf("source-bound record not current: %v %v", cur, err)
+		}
+		if len(cur.Sources) != 1 || cur.Sources[0].Path != abs {
+			t.Fatalf("source not rebound to destination: %+v", cur.Sources)
+		}
+	})
+
+	reject := map[string]Source{
+		"changed file":    {Root: "/elsewhere/p", Path: "/elsewhere/p/docs/style.md", SHA256: zeroDigest()},
+		"missing file":    {Root: "/elsewhere/p", Path: "/elsewhere/p/docs/gone.md", SHA256: digest},
+		"invalid hash":    {Root: "/elsewhere/p", Path: "/elsewhere/p/docs/style.md", SHA256: "nothex"},
+		"relative root":   {Root: "relative/p", Path: "docs/style.md", SHA256: digest},
+		"absolute escape": {Root: "/elsewhere/p", Path: "/somewhere/else/style.md", SHA256: digest},
+		"relative escape": {Root: "/elsewhere/p", Path: "../style.md", SHA256: digest},
+	}
+	for name, src := range reject {
+		t.Run("reject "+name, func(t *testing.T) {
+			s := newStore(t)
+			_, err := s.Import(ctx, "proj:/x", root, []Record{{ID: 1, Scope: "s", Key: "k", Kind: "observation", Text: "t", Evidence: "e", Sources: []Source{src}}}, ConflictError, false)
+			if err == nil {
+				t.Fatal("expected rejection")
+			}
+		})
+	}
+
+	t.Run("stale historical source is rejected", func(t *testing.T) {
+		s := newStore(t)
+		good := Source{Root: "/elsewhere/p", Path: "/elsewhere/p/docs/style.md", SHA256: digest}
+		stale := Source{Root: "/elsewhere/p", Path: "/elsewhere/p/docs/style.md", SHA256: zeroDigest()}
+		batch := []Record{
+			{ID: 1, Scope: "s", Key: "k", Kind: "observation", Text: "old", Evidence: "e", Sources: []Source{stale}},
+			{ID: 2, Scope: "s", Key: "k", Kind: "observation", Text: "new", Evidence: "e", Sources: []Source{good}},
+		}
+		if _, err := s.Import(ctx, "proj:/x", root, batch, ConflictError, false); err == nil {
+			t.Fatal("stale history must reject the batch")
+		}
+	})
+
+	t.Run("more than eight sources rejected", func(t *testing.T) {
+		s := newStore(t)
+		var nine []Source
+		for i := 0; i < 9; i++ {
+			nine = append(nine, Source{Root: "/elsewhere/p", Path: "/elsewhere/p/docs/style.md", SHA256: digest})
+		}
+		if _, err := s.Import(ctx, "proj:/x", root, []Record{{ID: 1, Scope: "s", Key: "k", Kind: "observation", Text: "t", Evidence: "e", Sources: nine}}, ConflictError, false); err == nil {
+			t.Fatal("expected too-many-sources rejection")
+		}
+	})
+}
