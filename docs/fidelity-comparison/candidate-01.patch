+func TestImportPreservesExpiryAndCount(t *testing.T) {
+	ctx := context.Background()
+	root := t.TempDir()
+	s := newStore(t)
+	future := time.Now().Add(time.Hour).Unix()
+	if _, err := s.Import(ctx, "proj:/x", root, []Record{{ID: 1, Scope: "s", Key: "k", Kind: "fact", Text: "t", Evidence: "e", Expires: future, Created: 1, Supersedes: 99}}, ConflictError, false); err != nil {
+		t.Fatal(err)
+	}
+	cur, err := s.Current(ctx, "proj:/x", "k", root)
+	if err != nil || cur == nil {
+		t.Fatalf("current: %v %v", cur, err)
+	}
+	if cur.Expires != future {
+		t.Fatalf("expiry not preserved: %d", cur.Expires)
+	}
+	if cur.Created == 1 {
+		t.Fatal("imported created time was trusted as destination identity")
+	}
+	if cur.Supersedes == 99 {
+		t.Fatal("imported supersedes was trusted as destination lineage")
+	}
+}
